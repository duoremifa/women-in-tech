---
import Layout from '../../layouts/Layout.astro';
import PodcastPlayer from '../../components/PodcastPlayer.astro';
import { getCollection } from 'astro:content';
import { getGatheringById } from '../../data/gatherings';

export async function getStaticPaths() {
  const all = await getCollection('podcast', ({ data }) => !data.draft);
  const sorted = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return sorted.map((ep, i) => ({
    // entry.id 含 .md 扩展名（Astro 5 legacy collection），slug 才是干净 URL
    params: { slug: ep.slug },
    props: { ep, num: sorted.length - i, older: sorted[i + 1] ?? null, newer: sorted[i - 1] ?? null },
  }));
}

const { ep, num, older, newer } = Astro.props;
const { Content } = await ep.render();
const dateStr = ep.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const dateStrEn = ep.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const gathering = ep.data.gatheringId ? getGatheringById(ep.data.gatheringId) : undefined;
const hideFromSearch = ep.data.draft || ep.data.comingSoon;
---

<Layout
  title={ep.data.title}
  description={ep.data.excerpt || ep.data.title}
  width='reading'
  type='article'
  ogImage={ep.data.cover}
  publishedTime={ep.data.pubDate.toISOString()}
  noindex={hideFromSearch}
>
  {!hideFromSearch && (
    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'PodcastEpisode',
        headline: ep.data.title,
        datePublished: ep.data.pubDate.toISOString(),
        url: `https://wotech.space/podcast/${ep.slug}`,
        description: ep.data.excerpt || ep.data.title,
        ...(ep.data.duration ? { duration: ep.data.duration } : {}),
        ...(ep.data.audio ? { associatedMedia: { '@type': 'MediaObject', contentUrl: ep.data.audio } } : {}),
        partOfSeries: { '@type': 'PodcastSeries', name: '慢谈 · Slow Talk', webFeed: 'https://wotech.space/podcast/rss.xml' },
      })}
    />
  )}
  <div class='page-container'>
    <a href='/podcast' class='btn btn--ghost'>
      <span lang='zh-CN'>← 返回播客</span>
      <span lang='en'>← Back to podcast</span>
    </a>

    <header class='ep-head'>
      <span class='section-eyebrow'>
        {ep.data.comingSoon ? '即将上线 · COMING SOON' : `EPISODE ${num}`}
      </span>
      <h1 class='ep-title'>{ep.data.title}</h1>
      <div class='ep-meta'>
        <span lang='zh-CN'>{dateStr}</span>
        <span lang='en'>{dateStrEn}</span>
        {ep.data.duration && <span>· {ep.data.duration}</span>}
        <span lang='zh-CN'>· 主播 {ep.data.hosts.join('、')}</span>
        <span lang='en'>· Host {ep.data.hosts.join(', ')}</span>
      </div>
      {gathering && (
        <a class='ep-from-gathering' href='/upcoming'>
          <span lang='zh-CN'>本期来自聚会：{gathering.titleZh} ↗</span>
          <span lang='en'>From gathering: {gathering.titleEn} ↗</span>
        </a>
      )}
    </header>

    {/* 音频播放器（自定义 hairline 播放器，音频上线后即用） */}
    {ep.data.audio && !ep.data.comingSoon ? (
      <PodcastPlayer src={ep.data.audio} title={ep.data.title} />
    ) : (
      <p class='audio-pending'>
        <span lang='zh-CN'>音频即将上线</span>
        <span lang='en'>Audio coming soon</span>
      </p>
    )}

    {/* 平台订阅 */}
    {!ep.data.comingSoon && (ep.data.xiaoyuzhou || ep.data.spotify || ep.data.apple) && (
      <div class='platforms'>
        {ep.data.xiaoyuzhou && <a class='plat-link' href={ep.data.xiaoyuzhou} target='_blank' rel='noopener'>小宇宙 ↗</a>}
        {ep.data.spotify && <a class='plat-link' href={ep.data.spotify} target='_blank' rel='noopener'>Spotify ↗</a>}
        {ep.data.apple && <a class='plat-link' href={ep.data.apple} target='_blank' rel='noopener'>Apple Podcasts ↗</a>}
      </div>
    )}

    {/* Shownotes */}
    <article class='shownotes'>
      <Content />
    </article>

    {/* 上一期（更早）/ 下一期（更新）——中文播客惯例：上一期 = 更早一期 */}
    {(older || newer) && (
      <nav class='ep-nav'>
        {older && (
          <a class='ep-nav-link prev' href={`/podcast/${older.slug}`}>
            <span class='nav-label'>← 上一期</span>
            <span class='nav-title'>{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a class='ep-nav-link next' href={`/podcast/${newer.slug}`}>
            <span class='nav-label'>下一期 →</span>
            <span class='nav-title'>{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</Layout>

<style>
  .page-container { padding: var(--spacing-6) 0 var(--spacing-20); max-width: var(--measure-prose); margin: 0 auto; }

  .ep-head { margin-bottom: var(--spacing-6); }
  .section-eyebrow { font-family: var(--font-family-mono); font-size: var(--font-size-2xs); letter-spacing: 0.12em; color: var(--color-gold-dust); display: block; margin-bottom: var(--spacing-2); }
  .ep-title { font-family: var(--font-family-heading); font-size: var(--font-size-3xl); font-weight: var(--font-weight-light); color: var(--color-text-heading); letter-spacing: -0.02em; margin: 0 0 var(--spacing-3); line-height: 1.3; }
  .ep-meta { font-family: var(--font-family-mono); font-size: var(--font-size-xs); color: var(--color-text-tertiary); }

  .ep-from-gathering { display: inline-block; margin-top: var(--spacing-3); font-family: var(--font-family-sans); font-size: var(--font-size-2xs); color: var(--color-text-tertiary); text-decoration: none !important; font-style: italic; border-bottom: 1px solid var(--color-border-divider) !important; padding-bottom: 1px; }
  .ep-from-gathering:hover { color: var(--color-gold-dust); border-bottom-color: var(--color-gold-dust) !important; }

  .audio-pending { font-family: var(--font-family-sans); font-size: 13px; color: var(--color-text-tertiary); font-style: italic; padding: var(--spacing-4); background: var(--color-surface-soft); border-radius: var(--radius-xs); margin-bottom: var(--spacing-6); }

  .platforms { display: flex; gap: var(--spacing-3); margin-bottom: var(--spacing-8); flex-wrap: wrap; }
  .plat-link { font-family: var(--font-family-sans); font-size: var(--font-size-xs); color: var(--color-text-primary); text-decoration: none !important; border: 1px solid var(--color-border-divider); padding: 4px 10px; border-radius: var(--radius-xs); transition: border-color var(--transition-fast); }
  .plat-link:hover { border-color: var(--color-gold-dust); }

  .shownotes { font-family: var(--font-family-sans); font-size: 15px; color: var(--color-text-secondary); line-height: 1.85; }
  .shownotes :global(h2) { font-family: var(--font-family-heading); font-size: 1.15rem; font-weight: var(--font-weight-normal); color: var(--color-text-heading); margin: var(--spacing-6) 0 var(--spacing-3); }
  .shownotes :global(h3) { font-family: var(--font-family-heading); font-size: var(--font-size-base); color: var(--color-text-heading); margin: var(--spacing-5) 0 var(--spacing-2); }
  .shownotes :global(p) { margin: 0 0 var(--spacing-4); }
  .shownotes :global(ul) { padding-left: var(--spacing-5); margin: 0 0 var(--spacing-4); }
  .shownotes :global(li) { margin: 0 0 var(--spacing-2); }
  .shownotes :global(a) { color: var(--color-text-primary); text-decoration: underline; text-underline-offset: 2px; }

  .ep-nav { margin-top: var(--spacing-12); padding-top: var(--spacing-6); border-top: 1px solid var(--color-border-divider); display: flex; gap: var(--spacing-6); flex-wrap: wrap; }
  .ep-nav-link { display: flex; flex-direction: column; gap: 2px; text-decoration: none !important; flex: 1; min-width: 0; }
  .ep-nav-link.next { text-align: right; }
  .nav-label { font-family: var(--font-family-mono); font-size: var(--font-size-2xs); color: var(--color-gold-dust); }
  .nav-title { font-family: var(--font-family-heading); font-size: 13.5px; color: var(--color-text-primary); }

  @media (max-width: 680px) {
    .ep-title { font-size: var(--font-size-2xl); }
    .ep-nav-link.next { text-align: left; }
  }
</style>
