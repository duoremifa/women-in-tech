---
import Layout from '../../layouts/Layout.astro';
import Stamp from '../../components/Stamp.astro';
import { WORKS } from '../../data/works';
import type { Work } from '../../data/works';

export function getStaticPaths() {
  return WORKS.map(w => ({ params: { slug: w.slug }, props: { w } }));
}

interface Props { w: Work }
const { w } = Astro.props;

const statusLabel = {
  concept: { zh: '概念草案', en: 'Concept' },
  prototype: { zh: '原型推敲中', en: 'Prototype' },
  building: { zh: '共建中', en: 'Building' },
}[w.status];
---

<Layout
  title={`${w.titleEn} · wo/men in tech`}
  description={w.taglineEn}
  width='reading'
>
  <meta name='robots' content='noindex' />
  <div class='page-container'>
    <a href='/works' class='btn btn--ghost'>
      <span lang='zh-CN' class='lang-zh'>← 返回方向列表</span>
      <span lang='en' class='lang-en'>← Back to directions</span>
    </a>

    {w.cover && (
      <figure class='work-cover'>
        <img src={w.cover} alt={w.titleZh} loading='lazy' decoding='async' />
      </figure>
    )}

    <header class='page-header'>
      <div class='work-meta'>
        <span class='work-status'>{statusLabel.zh}</span>
        <span class='work-roles'>{w.craftZh}</span>
      </div>
      <div lang='zh-CN' class='lang-zh'>
        <h1 class='page-title'>{w.titleZh}</h1>
        <p class='page-lead'>{w.taglineZh}</p>
      </div>
      <div lang='en' class='lang-en'>
        <h1 class='page-title'>{w.titleEn}</h1>
        <p class='page-lead'>{w.taglineEn}</p>
      </div>
      <div class='gold-hairline'></div>
    </header>

    <section class='ethos-section'>
      <span class='block-eyebrow'>ETHOS · 理念</span>
      <div lang='zh-CN' class='lang-zh'>
        <p>{w.ethosZh}</p>
      </div>
      <div lang='en' class='lang-en'>
        <p>{w.ethosEn}</p>
      </div>
    </section>

    <section class='cobuild-section'>
      <span class='block-eyebrow'>CO-BUILD · 认领共建</span>
      <div lang='zh-CN' class='lang-zh'>
        <p>{w.cobuildHintZh}</p>
      </div>
      <div lang='en' class='lang-en'>
        <p>{w.cobuildHintEn}</p>
      </div>
    </section>

    <section class='placeholder-note'>
      <span class='note-mark' aria-hidden='true'><Stamp /></span>
      <p lang='zh-CN' class='lang-zh'>这个方向在等第一个打样项目——可以是你带来的，也可以是一起找到的。有共鸣，先聊聊。</p>
      <p lang='en' class='lang-en'>This direction is waiting for its first sample project—yours, or one found together. If it resonates, reach out.</p>
    </section>

    <section class='next-steps'>
      {w.demoUrl && (
        <a href={w.demoUrl} class='btn btn--solid' target='_blank' rel='noopener noreferrer'>
          <span lang='zh-CN' class='lang-zh'>去看看这件 ↗</span>
          <span lang='en' class='lang-en'>See it live ↗</span>
        </a>
      )}
      <a href={`/join?work=${w.slug}`} class='btn btn--solid'>
        <span lang='zh-CN' class='lang-zh'>想一起打磨 ⟶</span>
        <span lang='en' class='lang-en'>Co-build this ⟶</span>
      </a>
      <a href='/works' class='btn btn--gold'>
        <span lang='zh-CN' class='lang-zh'>其他方向 →</span>
        <span lang='en' class='lang-en'>Other directions →</span>
      </a>
    </section>
  </div>
</Layout>

<style>
  .page-container { padding: var(--spacing-6) 0 var(--spacing-20); max-width: var(--measure-prose); margin: 0 auto; }
  .work-cover { margin: 0 0 var(--spacing-8); padding: 0; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); overflow: hidden; }
  .work-cover img { display: block; width: 100%; height: auto; }
  .page-header { margin-bottom: var(--spacing-10); }
  .work-meta { display: flex; gap: var(--spacing-3); align-items: center; margin-bottom: var(--spacing-4); }
  .work-status { font-family: var(--font-family-sans); font-size: var(--font-size-2xs); color: var(--color-text-primary); background: var(--color-surface-soft); padding: 2px 8px; border-radius: var(--radius-xs); }
  .work-roles { font-family: var(--font-family-mono); font-size: 10.5px; color: var(--color-text-tertiary); letter-spacing: 0.06em; }
  .page-title { font-family: var(--font-family-heading); font-size: var(--font-size-3xl); font-weight: var(--font-weight-light); color: var(--color-text-heading); letter-spacing: -0.02em; margin: 0 0 var(--spacing-3); }
  .page-lead { font-family: var(--font-family-sans); font-size: var(--font-size-base); color: var(--color-text-secondary); line-height: 1.8; margin: 0; }
  .gold-hairline { width: var(--spacing-12); height: 1px; background: var(--color-gold-dust); opacity: 0.7; margin-top: var(--spacing-5); }

  .ethos-section, .cobuild-section { padding: var(--spacing-8) 0; border-bottom: 1px solid var(--color-border-divider); }
  .block-eyebrow { font-family: var(--font-family-mono); font-size: var(--font-size-2xs); color: var(--color-gold-dust); letter-spacing: 0.12em; display: block; margin-bottom: var(--spacing-3); }
  .ethos-section p, .cobuild-section p { font-family: var(--font-family-sans); font-size: 15px; color: var(--color-text-secondary); line-height: 1.85; margin: 0; }

  .placeholder-note { padding: var(--spacing-6) 0; display: flex; gap: var(--spacing-3); align-items: flex-start; }
  .note-mark { color: var(--color-gold-dust); font-size: 13px; flex-shrink: 0; margin-top: 2px; }
  .placeholder-note p { font-family: var(--font-family-sans); font-size: 13px; color: var(--color-text-tertiary); line-height: 1.7; margin: 0; font-style: italic; }

  .next-steps { margin-top: var(--spacing-12); display: flex; gap: var(--spacing-4); align-items: center; flex-wrap: wrap; }

  @media (max-width: 680px) {
    .page-title { font-size: var(--font-size-page-title); }
  }
</style>
