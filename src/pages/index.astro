                  </label>

                  <label class='quiet-check-row'>
                    <input type='checkbox' name='interests' value='portfolio_building' id='interest-lab' checked />
                    <span class='check-indicator' aria-hidden='true'>
                      <svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg>
                    </span>
                    <div class='check-content'>
                      <span class='check-title lang-zh'>作品 Lab · 慢工出细活</span>
                      <span class='check-title lang-en'>Craft Lab</span>
                      <span class='check-note lang-zh'>经验互借 · 代表作打磨</span>
                      <span class='check-note lang-en'>Small cohorts · patient iteration on signature work</span>
                    </div>
                  </label>
                </div>
              </div>

              {/* 字段 4: 正在做的事 */}
              <div class='form-field'>
                <label class='field-label' for='home-idea'>
                  <span class='lang-zh'>正在做的事，或者想交流的话题</span>
                  <span class='lang-en'>Current projects, questions, or topics you care about</span>
                  <span class='field-hint lang-zh'>可留空</span>
                  <span class='field-hint lang-en'>Optional</span>
                </label>
                <textarea
                  id='home-idea'
                  name='idea'
                  rows='2'
                  placeholder='一个未完成的作品，一个还没找到人聊的想法……'
                  data-placeholder-zh='一个未完成的作品，一个还没找到人聊的想法……'
                  data-placeholder-en='An unfinished side project, a nagging design question...'
                ></textarea>
              </div>

              {/* 字段 5: 联系方式 */}
              <div class='form-field'>
                <label class='field-label' for='home-contact'>
                  <span class='lang-zh'>联系方式</span>
                  <span class='lang-en'>Contact Information</span>
                  <span class='field-hint lang-zh'>微信号或邮箱 · 仅用于活动邀请</span>
                  <span class='field-hint lang-en'>WeChat ID or Email · strictly for circle invites</span>
                </label>
                <input
                  type='text'
                  id='home-contact'
                  name='contact'
                  placeholder='微信号或 Email'
                  data-placeholder-zh='微信号或 Email'
                  data-placeholder-en='WeChat ID or Email'
                  required
                  autocomplete='off'
                />
              </div>

              {/* 调整后的横向精致动作条 */}
              <div class='submit-bar'>
                <button type='submit' class='submit-btn-primary' id='home-submit-btn'>
                  <span class='lang-zh'>预约交流</span>
                  <span class='lang-en'>Join the Conversation</span>
                  <span class='btn-arrow'>⟶</span>
                </button>
                <div class='privacy-assurance-pill'>
                  <span class='privacy-dot'>✦</span>
                  <span class='privacy-text lang-zh'>
                    随时可退订联系 · 承诺不作商业营销
                  </span>
                  <span class='privacy-text lang-en'>
                    Unsubscribe anytime · Zero commercial marketing
                  </span>
                </div>
              </div>

              <div id='home-form-feedback' class='feedback-receipt-box' style='display: none;'>
                <div class='receipt-head'>
                  <span class='receipt-icon'>✦</span>
                  <div>
                    <h4 class='receipt-msg-title lang-zh'>意向已静默送达</h4>
                    <h4 class='receipt-msg-title lang-en'>Received with Warmth</h4>
                    <p class='receipt-id-tag' id='home-receipt-id'>回执编号: WT-PENDING</p>
                  </div>
                </div>

                <div class='receipt-status-banner'>
                  <p class='receipt-note lang-zh' id='home-note-text'>
                    意向已收录入社群档案。
                  </p>
                  <p class='receipt-note lang-en' id='home-note-text-en'>
                    Your note has been securely saved in our circle records.
                  </p>
                </div>

                {/* 闭环双操作区 */}
                <div class='receipt-loop-grid'>
                  {/* 闭环 1: 日历占位 (.ics) */}
                  <div class='loop-cell'>
                    <div class='loop-cell-info'>
                      <span class='loop-cell-tag lang-zh'>日历占位 · .ics</span>
                      <span class='loop-cell-tag lang-en'>Calendar · .ics</span>
                      <p class='loop-cell-desc lang-zh'>包含双周 Coffee Chat 与 Show & Tell 交流时段，一键导入手机系统日历。</p>
                      <p class='loop-cell-desc lang-en'>Includes Coffee Chat & Show & Tell slots. Import to system calendar with one click.</p>
                    </div>
                    <button type='button' class='btn-download-ics' id='home-btn-download-ics'>
                      <span class='lang-zh'>下载 .ics 日历邀请 ↗</span>
                      <span class='lang-en'>Download .ics Invite ↗</span>
                    </button>
                  </div>

                  {/* 闭环 2: 微信联络通道 */}
                  <div class='loop-cell'>
                    <div class='loop-cell-info'>
                      <span class='loop-cell-tag lang-zh'>微信直接交流</span>
                      <span class='loop-cell-tag lang-en'>Connect via WeChat</span>
                      <p class='loop-cell-desc lang-zh'>如果有正在推敲的作品或想法想先聊聊，欢迎随时联系我。</p>
                      <p class='loop-cell-desc lang-en'>If you have a thought or project in progress you'd like to share, feel free to reach out directly.</p>
                    </div>
                    <div class='wechat-field-card'>
                      <div class='wechat-text-col'>
                        <span class='wechat-label-caption'>微信号</span>
                        <code class='wechat-handle'>daiminay</code>
                      </div>
                      <button type='button' class='btn-copy-hairline' id='home-btn-copy-wechat' data-wechat='daiminay' aria-label='复制微信号'>
                        <span class='copy-text lang-zh'>复制</span>
                        <span class='copy-text lang-en'>Copy</span>
                      </button>
                    </div>
