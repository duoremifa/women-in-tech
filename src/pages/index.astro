                    <span class='check-indicator' aria-hidden='true'>
                      <svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg>
                    </span>
                    <div class='check-content'>
                      <span class='check-title lang-zh'>English Tech & Design Chat</span>
                      <span class='check-title lang-en'>English Tech & Design Chat</span>
                      <span class='check-note lang-zh'>双周线上 · 5 min Show & Tell</span>
