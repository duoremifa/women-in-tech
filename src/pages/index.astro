---
import Layout from '../layouts/Layout.astro';
import { WORKS } from '../data/works';
---

<Layout
  title='wo/men in tech · women in technical · "我们"'
  description='鼓励表达创作 · 深度沟通 · 尊重专业性——在商业流水线的间隙，做一些纯粹的事。面向 PM / IxD / FE 的慢节奏创造联合体。'
  width='reading'
>
  <div class='landing'>
    {/* ── 标识与一句话价值 ── */}
    <header class='hero'>
      <h1 class='brand'>wo<span class='brand-slash'>/</span>men</h1>
      <p class='brand-sub'>women in technical · "我们"</p>

      <div lang='zh-CN' class='lang-zh'>
        <p class='manifesto-line'>在商业流水线的间隙，做一些纯粹的事。</p>
        <p class='manifesto-sub'>鼓励表达创作 · 深度沟通 · 尊重专业性——这就是 women in tech。</p>
      </div>
      <div lang='en' class='lang-en'>
        <p class='manifesto-line'>In the gaps between commercial sprints, we make things that are simply ours.</p>
        <p class='manifesto-sub'>Encourage expression · Deep dialogue · Respect for craft—that is women in tech.</p>
      </div>
    </header>

    {/* ── 三角色 ── */}
    <section class='roles' id='roles'>
      <a class='role-pill' href='/ethos#roles'>
        <span class='role-mark'>PM</span>
        <span lang='zh-CN' class='lang-zh'>产品 · 独立推敲</span>
        <span lang='en' class='lang-en'>Product · Independent Builders</span>
      </a>
      <a class='role-pill' href='/ethos#roles'>
        <span class='role-mark'>IxD</span>
        <span lang='zh-CN' class='lang-zh'>交互 · 界面手艺</span>
        <span lang='en' class='lang-en'>Interaction · Interface Artisans</span>
      </a>
      <a class='role-pill' href='/ethos#roles'>
        <span class='role-mark'>FE</span>
        <span lang='zh-CN' class='lang-zh'>工程 · 鲁棒架构</span>
        <span lang='en' class='lang-en'>Engineering · System Crafts</span>
      </a>
    </section>

    {/* ── 正在打磨（钩子）── */}
    <section class='works-hook'>
      <span class='section-eyebrow'>IN THE WORKSHOP · 正在打磨</span>
      <div class='works-row'>
        {WORKS.map(w => (
          <a class='work-chip' href={`/works/${w.slug}`}>
            <span class='work-name'>{w.titleEn}</span>
            <span lang='zh-CN' class='lang-zh work-tline'>{w.taglineZh}</span>
            <span lang='en' class='lang-en work-tline'>{w.taglineEn}</span>
          </a>
        ))}
      </div>
    </section>

    {/* ── 单 CTA ── */}
    <section class='cta'>
      <a href='/join' class='cta-btn'>
        <span lang='zh-CN' class='lang-zh'>加入下一期交流</span>
        <span lang='en' class='lang-en'>Join the next gathering</span>
        <span class='cta-arrow' aria-hidden='true'>⟶</span>
      </a>
      <p class='cta-foot'>
        <span lang='zh-CN' class='lang-zh'>或先看看 <a href='/ethos'>理念</a> · <a href='/upcoming'>近期排期</a></span>
        <span lang='en' class='lang-en'>Or explore <a href='/ethos'>ethos</a> · <a href='/upcoming'>upcoming</a></span>
      </p>
    </section>
  </div>
</Layout>

<style>
  .landing { display: flex; flex-direction: column; gap: var(--spacing-20); padding: var(--spacing-12) 0 var(--spacing-24); max-width: 42rem; margin: 0 auto; }

  .hero { text-align: center; }
  .brand { font-family: var(--font-family-heading); font-size: clamp(2.5rem, 8vw, 4rem); font-weight: 300; color: var(--color-brand-purple, #5e4c7a); letter-spacing: -0.025em; line-height: 1.05; margin: 0; }
  .brand-slash { color: var(--color-gold-dust); opacity: 0.85; font-weight: 300; }
  .brand-sub { font-family: var(--font-family-mono); font-size: 11.5px; letter-spacing: 0.12em; color: var(--color-brand-purple-soft, #7d689b); text-transform: lowercase; margin: var(--spacing-2) 0 var(--spacing-8); }
  .manifesto-line { font-family: var(--font-family-heading); font-size: var(--font-size-xl); font-weight: var(--font-weight-normal); color: var(--color-text-heading); line-height: 1.5; letter-spacing: 0.005em; margin: 0 0 var(--spacing-3); }
  .manifesto-sub { font-family: var(--font-family-body); font-size: 14px; color: var(--color-text-secondary); line-height: 1.7; margin: 0; }

  .roles { display: flex; flex-direction: column; gap: var(--spacing-2); }
  .role-pill { display: flex; align-items: baseline; gap: var(--spacing-3); padding: var(--spacing-3) var(--spacing-4); border: 1px solid var(--color-border-divider); border-radius: var(--radius-xs); text-decoration: none !important; transition: border-color var(--transition-fast), background var(--transition-fast); }
  .role-pill:hover { border-color: var(--color-gold-dust); background: var(--color-surface-pure); }
  .role-mark { font-family: var(--font-family-mono); font-size: 11px; color: var(--color-gold-dust); letter-spacing: 0.08em; min-width: 2.5rem; }
  .role-pill > span:nth-child(2), .role-pill > span:nth-child(3) { font-family: var(--font-family-ui); font-size: 13.5px; color: var(--color-text-primary); }

  .works-hook { display: flex; flex-direction: column; gap: var(--spacing-4); }
  .section-eyebrow { font-family: var(--font-family-mono); font-size: var(--font-size-xs); letter-spacing: 0.12em; color: var(--color-gold-dust); }
  .works-row { display: flex; flex-direction: column; gap: var(--spacing-3); }
  .work-chip { display: flex; flex-direction: column; gap: 2px; padding: var(--spacing-4) var(--spacing-5); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-xs); background: var(--color-surface-pure); text-decoration: none !important; transition: border-color var(--transition-fast); }
  .work-chip:hover { border-color: var(--color-gold-dust); }
  .work-name { font-family: var(--font-family-heading); font-size: 1rem; font-weight: var(--font-weight-normal); color: var(--color-text-heading); }
  .work-tline { font-family: var(--font-family-body); font-size: 12.5px; color: var(--color-text-secondary); line-height: 1.5; }

  .cta { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--spacing-3); }
  .cta-btn { display: inline-flex; align-items: center; gap: var(--spacing-3); padding: var(--spacing-4) var(--spacing-8); background: var(--color-brand-purple, #5e4c7a); color: var(--color-surface-pure) !important; border-radius: var(--radius-xs); font-family: var(--font-family-ui); font-size: 13px; letter-spacing: 0.08em; text-decoration: none !important; transition: background var(--transition-fast); }
  .cta-btn:hover { background: var(--color-brand-purple-dark, #4d3d66); }
  .cta-arrow { transition: transform var(--transition-fast); }
  .cta-btn:hover .cta-arrow { transform: translateX(4px); }
  .cta-foot { font-family: var(--font-family-ui); font-size: 12px; color: var(--color-text-tertiary); }
  .cta-foot a { color: var(--color-primary-dark); text-decoration: none !important; border-bottom: 1px solid var(--color-border-divider) !important; padding-bottom: 1px; }

  @media (max-width: 680px) {
    .landing { padding: var(--spacing-8) 0 var(--spacing-16); gap: var(--spacing-16); }
    .manifesto-line { font-size: 1.15rem; }
  }
</style>
