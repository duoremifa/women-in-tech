---
import Layout from '../layouts/Layout.astro';
import GeometricVisual from '../components/GeometricVisual.astro';
---

<Layout
  title='wo/men in tech · women in technical'
  description='面向技术与创造领域女性的慢节奏社群。在商业项目之外，做一些纯粹的事。'
  width='reading'
>
  <div class='page-root'>
    <div class='two-column-layout'>

      {/* ===== 左侧：品牌与宣言 ===== */}
      <aside class='sidebar' id='about'>

        <div class='brand-group'>
          <h1 class='site-title'>wo<span class='brand-slash'>/</span>men</h1>
          <p class='site-sub'>women in technical</p>
          <p class='site-zh'>"我们"</p>
        </div>

        <div class='manifesto'>
          <p>
            在每一个商业项目的空隙里，<br />
            总有一些东西是做给自己的。
          </p>
          <p>
            这里是那个地方。
          </p>
        </div>

        <div class='sidebar-divider'></div>

        <div class='who-section'>
          <span class='who-label'>面向</span>
          <p class='who-desc'>
            所有在技术与创造领域工作的女性——<br />
            产品、设计、工程、研究、写作……
          </p>
          <p class='who-note'>
            不需要特定头衔，<br />
            只是对作品本身有一点执念。
          </p>
        </div>

        <div class='sidebar-footer'>
          <GeometricVisual type='subtle' height='72px' />
        </div>
      </aside>

      {/* ===== 右侧：内容区 ===== */}
      <main class='content-main'>

        {/* 1. 我们做什么 */}
        <section class='content-block' id='events'>
          <div class='block-header-line'>
            <span class='eyebrow'>WHAT WE DO</span>
            <a href='/events' class='block-more-link'>手艺准则与机制 ↗</a>
          </div>

          <div class='gathering-list'>
            <div class='gathering-item'>
              <div class='gathering-meta'>
                <span class='gathering-type'>Coffee Chat</span>
                <span class='gathering-freq'>线上 / 杭州 · 双周</span>
              </div>
              <p class='gathering-desc'>
                不是 networking。<br />
                两三个人，把手里的咖啡喝完，<br />
                谈谈最近在做的事——或者什么也不谈。
              </p>
            </div>

            <div class='gathering-item'>
              <div class='gathering-meta'>
                <span class='gathering-type'>English Chat</span>
                <span class='gathering-freq'>线上 · 不定期</span>
              </div>
              <p class='gathering-desc'>
                用英语聊产品、设计或技术，<br />
                一个不被评判的地方练习表达，<br />
                没有标准答案，只有真实的体悟。
              </p>
            </div>

            <div class='gathering-item'>
              <div class='gathering-meta'>
                <span class='gathering-type'>作品 · Lab</span>
                <span class='gathering-freq'>小组制 · 慢工出细活</span>
              </div>
              <p class='gathering-desc'>
                把那个一直在脑子里转的想法拿出来，<br />
                找到懂你的人一起慢慢打磨。<br />
                不赶 deadline，不做 MVP，只做值得的事。
              </p>
            </div>
          </div>
        </section>

        {/* 2. 近期安排 */}
        <section class='content-block' id='schedule'>
          <div class='block-header-line'>
            <span class='eyebrow'>UPCOMING</span>
            <a href='/upcoming' class='block-more-link'>完整排期与答疑 ↗</a>
          </div>

          <div class='schedule-list'>
            <div class='schedule-item'>
              <div class='schedule-left'>
                <span class='schedule-num'>01</span>
                <span class='schedule-tag'>Coffee Chat</span>
              </div>
              <div class='schedule-right'>
                <p class='schedule-title'>AI 时代，还剩下什么是属于自己的？</p>
                <p class='schedule-detail'>杭州线下 + 线上同步 · 开放预约</p>
              </div>
            </div>

            <div class='schedule-item'>
              <div class='schedule-left'>
                <span class='schedule-num'>02</span>
                <span class='schedule-tag'>English Chat</span>
              </div>
              <div class='schedule-right'>
                <p class='schedule-title'>Show & Tell — Walk me through something you made</p>
                <p class='schedule-detail'>线上 · 40 min · 开放预约</p>
              </div>
            </div>
          </div>
        </section>

        {/* 3. 加入我们 (前置极细金线手作表单) */}
        <section class='content-block' id='join'>
          <div class='block-header-line'>
            <span class='eyebrow'>JOIN THE CIRCLE</span>
            <a href='/join' class='block-more-link'>独立全屏预约函 ↗</a>
          </div>

          <div class='join-intro'>
            <p>
              如果你有共鸣，欢迎留下联系方式。<br />
              我们会在下一次活动前一对一确认。
            </p>
          </div>

          <div class='form-wrapper'>
            <form id='home-join-form' class='quiet-form'>

              <div class='form-field'>
                <label class='field-label' for='home-name'>
                  <span>如何称呼你</span>
                  <span class='field-hint'>Name</span>
                </label>
                <input
                  type='text'
                  id='home-name'
                  name='name'
                  placeholder='名字或昵称'
                  required
                  autocomplete='off'
                />
              </div>

              {/* 前置细金线单选 */}
              <div class='form-field'>
                <label class='field-label'>
                  <span>你在从事的领域</span>
                  <span class='field-hint'>单选</span>
                </label>
                <div class='quiet-check-list' role='radiogroup' aria-label='从事领域'>
                  <label class='quiet-check-row is-radio'>
                    <input type='radio' name='craft' value='design' checked />
                    <span class='check-indicator' aria-hidden='true'></span>
                    <div class='check-content'>
                      <span class='check-title'>设计 · 视觉传达 / 交互体验 (IxD)</span>
                      <span class='check-note'>视觉与微交互</span>
                    </div>
                  </label>

                  <label class='quiet-check-row is-radio'>
                    <input type='radio' name='craft' value='product' />
                    <span class='check-indicator' aria-hidden='true'></span>
                    <div class='check-content'>
                      <span class='check-title'>产品 · 逻辑推敲 / 独立孵化 (PM)</span>
                      <span class='check-note'>业务与体验闭环</span>
                    </div>
                  </label>

                  <label class='quiet-check-row is-radio'>
                    <input type='radio' name='craft' value='engineering' />
                    <span class='check-indicator' aria-hidden='true'></span>
                    <div class='check-content'>
                      <span class='check-title'>工程 · 前端架构 / 独立全栈 (FE)</span>
                      <span class='check-note'>代码实现与部署</span>
                    </div>
                  </label>

                  <label class='quiet-check-row is-radio'>
                    <input type='radio' name='craft' value='other' />
                    <span class='check-indicator' aria-hidden='true'></span>
                    <div class='check-content'>
                      <span class='check-title'>研究 / 写作 / 自由创造者</span>
                      <span class='check-note'>跨界探索</span>
                    </div>
                  </label>
                </div>
              </div>

              {/* 前置细金线多选 */}
              <div class='form-field'>
                <label class='field-label'>
                  <span>想参与的活动</span>
                  <span class='field-hint'>多选</span>
                </label>
                <div class='quiet-check-list'>
                  <label class='quiet-check-row'>
                    <input type='checkbox' name='interests' value='coffee_chat' checked />
                    <span class='check-indicator' aria-hidden='true'>
                      <svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg>
                    </span>
                    <div class='check-content'>
                      <span class='check-title'>☕ Offline & Online Coffee Chat</span>
                      <span class='check-note'>双周轻聚</span>
                    </div>
                  </label>

                  <label class='quiet-check-row'>
                    <input type='checkbox' name='interests' value='english_chat' checked />
                    <span class='check-indicator' aria-hidden='true'>
                      <svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg>
                    </span>
                    <div class='check-content'>
                      <span class='check-title'>🗣️ English Tech & Design Chat</span>
                      <span class='check-note'>双周线上</span>
                    </div>
                  </label>

                  <label class='quiet-check-row'>
                    <input type='checkbox' name='interests' value='portfolio_building' checked />
                    <span class='check-indicator' aria-hidden='true'>
                      <svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg>
                    </span>
                    <div class='check-content'>
                      <span class='check-title'>🛠️ 作品 Lab · 慢工出细活</span>
                      <span class='check-note'>合作打磨代表作</span>
                    </div>
                  </label>
                </div>
              </div>

              <div class='form-field'>
                <label class='field-label' for='home-idea'>
                  <span>正在做的事，或者你觉得这里会懂的话题</span>
                  <span class='field-hint'>可留空</span>
                </label>
                <textarea
                  id='home-idea'
                  name='idea'
                  rows='2'
                  placeholder='一个未完成的作品，一个还没找到人聊的想法……'
                ></textarea>
              </div>

              <div class='form-field'>
                <label class='field-label' for='home-contact'>
                  <span>联系方式</span>
                  <span class='field-hint'>微信或邮箱</span>
                </label>
                <input
                  type='text'
                  id='home-contact'
                  name='contact'
                  placeholder='微信号或邮箱'
                  required
                  autocomplete='off'
                />
              </div>

              <button type='submit' class='submit-btn-primary' id='home-submit-btn'>
                <span>留下联系方式</span>
                <span class='btn-arrow'>→</span>
              </button>

              <div id='home-form-feedback' style='display: none;'>
                <div class='feedback-receipt-box'>
                  <div class='receipt-head'>
                    <span class='receipt-icon'>✦</span>
                    <div>
                      <h4 class='receipt-msg-title'>收到了。</h4>
                      <p class='receipt-id-tag' id='home-receipt-id'>回执编号: WT-PENDING</p>
                    </div>
                  </div>
                  <p class='receipt-note'>意向已保存在社群记录中，我们会在下次活动前联系你。</p>
                </div>
              </div>

            </form>
          </div>
        </section>

      </main>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('home-join-form') as HTMLFormElement | null;
  const feedback = document.getElementById('home-form-feedback');
  const submitBtn = document.getElementById('home-submit-btn');
  const receiptDisplay = document.getElementById('home-receipt-id');

  if (form && feedback) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        craft: formData.get('craft'),
        interests: formData.getAll('interests'),
        idea: formData.get('idea'),
        contact: formData.get('contact'),
        clientTimestamp: new Date().toISOString(),
      };

      // 备份到本地存储
      try {
        const existing = JSON.parse(localStorage.getItem('wotech_rsvp_backup') || '[]');
        existing.push(payload);
        localStorage.setItem('wotech_rsvp_backup', JSON.stringify(existing));
      } catch (err) {}

      // 发送至 API
      let subId = `WT-${Date.now().toString(36).slice(-5).toUpperCase()}`;
      try {
        if (submitBtn) submitBtn.setAttribute('disabled', 'true');
        const res = await fetch('/api/join', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          const resData = await res.json();
          if (resData.submissionId) subId = resData.submissionId;
        }
      } catch (err) {}

      if (receiptDisplay) receiptDisplay.textContent = `回执编号: #${subId}`;
      feedback.style.display = 'block';
      if (submitBtn) submitBtn.style.display = 'none';
      feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
</script>

<style>
  .page-root {
    padding: var(--spacing-6) 0 var(--spacing-24);
  }

  .two-column-layout {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: var(--spacing-16);
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: var(--spacing-8);
    padding-right: var(--spacing-8);
    border-right: var(--border-width-thin) solid var(--color-border-divider);
  }

  .brand-group {
    margin-bottom: var(--spacing-10);
  }

  .site-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-heading);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 var(--spacing-2);
    text-decoration: none !important;
    border-bottom: none !important;
  }

  .site-title .brand-slash {
    color: var(--color-gold-dust);
    opacity: 0.7;
    font-weight: 300;
  }

  .site-sub {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    color: var(--color-text-tertiary);
    text-transform: lowercase;
    margin: 0;
  }

  .site-zh {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    color: var(--color-primary-dark);
    letter-spacing: 0.06em;
    margin: 0;
    margin-top: 2px;
  }

  .manifesto {
    margin-bottom: var(--spacing-8);
  }

  .manifesto p {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.9;
    margin: 0 0 var(--spacing-4);
    font-weight: var(--font-weight-light);
    font-style: italic;
  }

  .manifesto p:last-child {
    margin: 0;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
  }

  .sidebar-divider {
    width: 2rem;
    height: 1px;
    background: var(--color-gold-dust);
    opacity: 0.4;
    margin: var(--spacing-8) 0;
  }

  .who-section {
    margin-bottom: var(--spacing-8);
  }

  .who-label {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--spacing-3);
  }

  .who-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin: 0 0 var(--spacing-3);
  }

  .who-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    line-height: 1.7;
    margin: 0;
    font-style: italic;
  }

  .sidebar-footer {
    margin-top: var(--spacing-12);
    opacity: 0.5;
  }

  /* 右侧内容区 */
  .content-main {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .content-block {
    position: relative;
  }

  .block-header-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-8);
  }

  .eyebrow {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    color: var(--color-primary-dark);
    text-transform: uppercase;
    font-weight: var(--font-weight-medium);
  }

  .block-more-link {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    color: var(--color-gold-dust);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color var(--transition-fast);
  }

  .block-more-link:hover {
    color: var(--color-text-heading);
  }

  /* 活动列表 */
  .gathering-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .gathering-item {
    padding: var(--spacing-7) 0;
    border-bottom: var(--border-width-thin) solid var(--color-border-divider);
  }

  .gathering-item:first-child {
    padding-top: 0;
  }

  .gathering-item:last-child {
    border-bottom: none;
  }

  .gathering-meta {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-4);
  }

  .gathering-type {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .gathering-freq {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    letter-spacing: 0.04em;
  }

  .gathering-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.85;
    margin: 0;
    max-width: 38em;
  }

  /* 安排列表 */
  .schedule-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
  }

  .schedule-item {
    display: flex;
    gap: var(--spacing-6);
    align-items: flex-start;
    padding: var(--spacing-5) var(--spacing-5);
    background: var(--color-surface-pure);
    border: var(--border-width-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
  }

  .schedule-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 56px;
    gap: 4px;
    padding-top: 2px;
  }

  .schedule-num {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-light);
    color: var(--color-text-heading);
    line-height: 1;
  }

  .schedule-tag {
    font-size: 10px;
    font-family: var(--font-family-ui);
    color: var(--color-primary-dark);
    letter-spacing: 0.04em;
    text-align: center;
  }

  .schedule-right {
    flex-grow: 1;
  }

  .schedule-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-base);
    color: var(--color-text-heading);
    margin: 0 0 var(--spacing-2);
    font-weight: var(--font-weight-normal);
    letter-spacing: -0.01em;
  }

  .schedule-detail {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    margin: 0;
  }

  /* 表单区 */
  .join-intro {
    margin-bottom: var(--spacing-6);
  }

  .join-intro p {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.85;
    margin: 0;
  }

  .form-wrapper {
    background: var(--color-surface-pure);
    border: var(--border-width-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--spacing-8);
  }

  .quiet-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-7);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .feedback-receipt-box {
    background: var(--color-surface-soft);
    border: 1px solid var(--color-gold-dust);
    border-radius: var(--radius-sm);
    padding: var(--spacing-5);
    margin-top: var(--spacing-4);
  }

  .receipt-head {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    margin-bottom: var(--spacing-2);
  }

  .receipt-icon {
    color: var(--color-gold-dust);
    font-size: var(--font-size-base);
  }

  .receipt-msg-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-base);
    color: var(--color-text-heading);
    margin: 0;
    font-weight: var(--font-weight-normal);
  }

  .receipt-id-tag {
    font-family: var(--font-family-mono, monospace);
    font-size: 11px;
    color: var(--color-primary-dark);
    margin: 2px 0 0;
  }

  .receipt-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (width <= 1024px) {
    .two-column-layout {
      grid-template-columns: 1fr;
      gap: var(--spacing-12);
    }
    .sidebar {
      position: static;
      border-right: none;
      border-bottom: var(--border-width-thin) solid var(--color-border-divider);
      padding-right: 0;
      padding-bottom: var(--spacing-10);
    }
    .site-title {
      font-size: var(--font-size-3xl);
    }
  }

  @media (width <= 640px) {
    .form-wrapper {
      padding: var(--spacing-5);
    }
    .schedule-item {
      flex-direction: column;
      gap: var(--spacing-3);
    }
  }
</style>
