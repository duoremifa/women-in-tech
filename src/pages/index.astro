</Layout>

<script>
  function setupHomeInteractions() {
    const form = document.getElementById('home-join-form') as HTMLFormElement | null;
    const feedback = document.getElementById('home-form-feedback');
    const submitBtn = document.getElementById('home-submit-btn');
    const receiptDisplay = document.getElementById('home-receipt-id');
    const ideaInput = document.getElementById('home-idea') as HTMLTextAreaElement | null;
    const nameInput = document.getElementById('home-name') as HTMLInputElement | null;

    // 1. 动态同步输入框 Placeholder
    function syncPlaceholders() {
      const isEn = document.documentElement.getAttribute('data-lang') === 'en';
      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-placeholder-zh]').forEach(el => {
        el.placeholder = isEn ? (el.dataset.placeholderEn || '') : (el.dataset.placeholderZh || '');
      });
    }

    syncPlaceholders();
    window.addEventListener('site-language-change', syncPlaceholders);

    // 2. 作品共建认领按钮联动 (Workshop Co-build Buttons)
    document.querySelectorAll<HTMLButtonElement>('.btn-join-work').forEach(btn => {
      btn.onclick = () => {
        const workName = btn.dataset.workName || '';
        if (ideaInput) {
          const isEn = document.documentElement.getAttribute('data-lang') === 'en';
          ideaInput.value = isEn 
            ? `I am interested in co-building: ${workName}`
            : `想参与《${workName}》的共建打磨，我的专长可以贡献在……`;
        }

        const labCheckbox = document.getElementById('interest-lab') as HTMLInputElement | null;
        if (labCheckbox) labCheckbox.checked = true;

        const joinSection = document.getElementById('join');
        if (joinSection) {
          joinSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        if (nameInput) {
          setTimeout(() => {
            nameInput.focus();
            nameInput.classList.add('glow-spark');
            setTimeout(() => nameInput.classList.remove('glow-spark'), 1800);
          }, 450);
        }
      };
    });

    // 4. 作品角色视角筛选切换 (Role Filter Tabs)
    const roleTabs = document.querySelectorAll<HTMLButtonElement>('.role-tab-btn');
    const workCards = document.querySelectorAll<HTMLElement>('.workshop-card');

    roleTabs.forEach(tab => {
      tab.onclick = () => {
        roleTabs.forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        const filter = tab.dataset.roleFilter || 'all';

        workCards.forEach(card => {
          if (filter === 'all') {
            card.style.display = 'block';
          } else {
            const cardRoles = card.dataset.role || '';
            card.style.display = cardRoles.includes(filter) ? 'block' : 'none';
          }
        });
      };
    });

    // 5. 表单提交处理与多通道闭环
    let currentIcsData = '';
    let currentSubId = '';

    const downloadIcsBtn = document.getElementById('home-btn-download-ics');
    const copyWechatBtn = document.getElementById('home-btn-copy-wechat');
    const modifyFormBtn = document.getElementById('home-btn-modify-form');

    if (downloadIcsBtn) {
      downloadIcsBtn.onclick = () => {
        if (!currentIcsData) return;
        const blob = new Blob([currentIcsData], { type: 'text/calendar;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `wotech-gathering-${currentSubId || 'invite'}.ics`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      };
    }

    if (copyWechatBtn) {
      copyWechatBtn.onclick = async () => {
        try {
          await navigator.clipboard.writeText('daiminay');
          const isEn = document.documentElement.getAttribute('data-lang') === 'en';
          const label = copyWechatBtn.querySelector('.copy-text');
          if (label) {
            const original = label.textContent;
            label.textContent = isEn ? '✓ Copied' : '✓ 已复制';
            setTimeout(() => {
              label.textContent = original;
            }, 2500);
          }
        } catch (e) {}
      };
    }

    if (modifyFormBtn && form) {
      modifyFormBtn.onclick = () => {
        if (feedback) feedback.style.display = 'none';
        form.querySelectorAll<HTMLElement>('.form-field, .submit-bar').forEach((el) => {
          el.style.display = '';
        });
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.style.display = '';
        }
      };
    }

    const formMountTime = Date.now();
    if (form && feedback) {
      form.onsubmit = async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const nameVal = String(formData.get('name') || '').trim();
        const craftVal = String(formData.get('craft') || '');
        const interestsVal = formData.getAll('interests').map(String);
        const ideaVal = String(formData.get('idea') || '');
        const contactVal = String(formData.get('contact') || '').trim();
        const hpVal = String(formData.get('_hp') || '');

        const payload = {
          name: nameVal,
          craft: craftVal,
          interests: interestsVal,
          idea: ideaVal,
          contact: contactVal,
          _hp: hpVal,
          _t: formMountTime,
          clientTimestamp: new Date().toISOString(),
        };

        // 备份到本地存储
        try {
          const existing = JSON.parse(localStorage.getItem('wotech_rsvp_backup') || '[]');
          existing.push(payload);
          localStorage.setItem('wotech_rsvp_backup', JSON.stringify(existing));
        } catch (err) {}

        let subId = `WT-${Date.now().toString(36).slice(-5).toUpperCase()}`;
        currentSubId = subId;
        const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contactVal);
        let emailSent = false;

        // 发送至 API
        try {
          if (submitBtn) submitBtn.setAttribute('disabled', 'true');
          const res = await fetch('/api/join', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            const resData = await res.json();
            if (resData.submissionId) subId = resData.submissionId;
            currentSubId = subId;
            if (resData.icsContent) currentIcsData = resData.icsContent;
            if (resData.emailSent !== undefined) emailSent = resData.emailSent;
          }
        } catch (err) {}

        // 本地保底生成 .ics (按意向独立生成真实活动项)
        if (!currentIcsData) {
          const dt = new Date().toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
          const wantsCoffee = interestsVal.includes('coffee') || interestsVal.length === 0;
          const wantsEnglish = interestsVal.includes('english') || interestsVal.length === 0;
          const events: string[] = [];

          if (wantsCoffee) {
            events.push([
              'BEGIN:VEVENT',
              `UID:wotech-coffee-${subId}@wotech.space`,
              `DTSTAMP:${dt}`,
              'DTSTART:20261108T063000Z', // 2026-11-08 (双周周日) 14:30 GMT+8
              'DTEND:20261108T080000Z',   // 2026-11-08 (双周周日) 16:00 GMT+8
              'SUMMARY:wo/men in tech · Coffee Chat（双周轻聚）',
              `DESCRIPTION:致 ${nameVal || '同行者'}：\\n这是为你预留的 Coffee Chat 交流席位。\\n回执编号: #${subId}\\n形式：杭州线下 + 线上接入\\n微信联络：daiminay`,
              'LOCATION:杭州线下 / 线上连线',
              'STATUS:CONFIRMED',
              'SEQUENCE:0',
              'BEGIN:VALARM',
              'TRIGGER:-PT30M',
              'ACTION:DISPLAY',
              'DESCRIPTION:wo/men in tech · Coffee Chat 提醒',
              'END:VALARM',
              'END:VEVENT',
            ].join('\r\n'));
          }

          if (wantsEnglish) {
            events.push([
              'BEGIN:VEVENT',
              `UID:wotech-showtell-${subId}@wotech.space`,
              `DTSTAMP:${dt}`,
              'DTSTART:20261111T120000Z', // 2026-11-11 (双周周三晚间) 20:00 GMT+8
              'DTEND:20261111T124500Z',   // 2026-11-11 (双周周三晚间) 20:45 GMT+8
              'SUMMARY:wo/men in tech · Show & Tell 英文技术与设计交流',
              `DESCRIPTION:致 ${nameVal || '同行者'}：\\n这是为你预留的 Show & Tell 交流席位。\\n回执编号: #${subId}\\n形式：40 min 英文界面细节与代码架构分享 + Q&A\\n微信联络：daiminay`,
              'LOCATION:线上视频室 (活动前发放连线)',
              'STATUS:CONFIRMED',
              'SEQUENCE:0',
              'BEGIN:VALARM',
              'TRIGGER:-PT30M',
              'ACTION:DISPLAY',
              'DESCRIPTION:wo/men in tech · Show & Tell 提醒',
              'END:VALARM',
              'END:VEVENT',
            ].join('\r\n'));
          }

          currentIcsData = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//wo/men in tech//Circle Gatherings//CN',
            'CALSCALE:GREGORIAN',
            'METHOD:REQUEST',
            ...events,
            'END:VCALENDAR',
          ].join('\r\n');
        }

        const isEn = document.documentElement.getAttribute('data-lang') === 'en';
        if (receiptDisplay) {
          receiptDisplay.textContent = isEn ? `Receipt ID: #${subId}` : `回执编号: #${subId}`;
        }

        // 更新状态说明
        const noteZh = document.getElementById('home-note-text');
        const noteEn = document.getElementById('home-note-text-en');
        if (isEmail) {
          if (noteZh) {
            noteZh.innerHTML = `已向你的邮箱 <code>${contactVal}</code> 发送确认信与 .ics 日历邀请（若未收到可检查垃圾箱）。`;
          }
          if (noteEn) {
            noteEn.innerHTML = `A confirmation letter & .ics invite have been dispatched to <code>${contactVal}</code>.`;
          }
        } else {
          if (noteZh) {
            noteZh.innerHTML = `意向已记录至社群档案。你可以直接下载下方日历邀请，或添加微信随时交流。`;
          }
          if (noteEn) {
            noteEn.innerHTML = `Your note is recorded. You may download the .ics invite below or connect via WeChat to explore more.`;
          }
        }

        // 隐藏输入表单项，展示回执
        form.querySelectorAll<HTMLElement>('.form-field, .submit-bar').forEach((el) => {
          el.style.display = 'none';
        });
        feedback.style.display = 'block';
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      };
    }
  }

  setupHomeInteractions();
  document.addEventListener('astro:page-load', setupHomeInteractions);
</script>

