    gap: var(--spacing-3);
    margin-bottom: var(--spacing-2);
  }

  /* 遵循黄金分割比例的数字编号：18px (24 / 1.618 ≈ 15~18px) */
  .section-serial {
    font-family: var(--font-family-heading);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 300;
    color: var(--color-gold-dust);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .section-main-title {
    font-family: var(--font-family-heading);
    font-size: 1.5rem;
    font-weight: var(--font-weight-normal);
    color: var(--color-text-heading);
    margin: 0;
    letter-spacing: 0.01em;
    line-height: 1.35;
  }

  .section-intro-text {
    font-family: var(--font-family-body);
    font-size: 13.5px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.7;
    letter-spacing: 0.01em;
  }

  /* ===== 极简展陈面板 ===== */
  .editorial-panels-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .editorial-panel {
    background: transparent;
    border: 1px solid transparent;
    border-bottom: 1px solid var(--color-border-divider);
    border-radius: var(--radius-xs);
    padding: var(--spacing-6) var(--spacing-5);
    position: relative;
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-panel:last-child {
    border-bottom-color: transparent;
  }

  .editorial-panel:hover {
    background: var(--color-surface-pure);
    border: 1px solid var(--color-border-subtle);
    box-shadow: 0 4px 16px -6px rgba(38, 34, 28, 0.03);
  }

  .panel-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-2);
  }

  .panel-name-group {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-3);
  }

  /* 黄金分割面板编号：13px (18 / 1.618 ≈ 11~13px) */
  .panel-index {
    font-family: var(--font-family-heading);
    font-size: 0.8125rem;
    font-style: italic;
    font-weight: 300;
    color: var(--color-gold-dust);
    opacity: 0.9;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .panel-title {
    font-family: var(--font-family-heading);
    font-size: 1.125rem;
    font-weight: var(--font-weight-normal);
    color: var(--color-text-heading);
    margin: 0;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }

  .panel-badge {
    font-family: var(--font-family-ui);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
  }

  .panel-badge.status-open {
    color: var(--color-brand-purple, #5e4c7a);
    font-weight: var(--font-weight-medium);
  }

  .panel-desc {
    font-family: var(--font-family-body);
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--color-text-secondary);
    margin: var(--spacing-2) 0 0;
    letter-spacing: 0.015em;
  }

  .editorial-panel.lang-en .panel-desc {
    line-height: 1.7;
    letter-spacing: -0.005em;
  }

  .panel-footer-meta {
    margin-top: var(--spacing-3);
    padding-top: var(--spacing-2);
    border-top: 1px solid var(--color-border-divider);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-family-ui);
    font-size: 11.5px;
    color: var(--color-text-tertiary);
  }

  /* ===== 精细化调整的手艺准则与共建机制底部栏 ===== */
  .section-bottom-action {
    margin-top: var(--spacing-8);
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-border-divider);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4);
  }

  .action-lead-note {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    font-family: var(--font-family-ui);
    font-size: 11.5px;
    color: var(--color-text-tertiary);
    letter-spacing: 0.04em;
  }

  .action-lead-note .gold-thread-dot {
    color: var(--color-gold-dust);
    font-size: 10px;
  }

  .circle-arrow-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    font-family: var(--font-family-ui);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-brand-purple, #5e4c7a);
    text-decoration: none !important;
    border-bottom: 1px solid var(--color-border-divider) !important;
    padding-bottom: 2px;
    font-weight: var(--font-weight-medium);
    transition: all var(--transition-fast);
  }

  .circle-arrow-link:hover {
    color: var(--color-text-heading);
    border-bottom-color: var(--color-gold-dust) !important;
  }

  .circle-arrow-link .link-arrow {
    transition: transform var(--transition-fast);
  }

  .circle-arrow-link:hover .link-arrow {
    transform: translateX(3px);
  }

  /* ===== 正在打磨的器物 (Works in Progress) ===== */
  .workshop-filter-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-6);
    flex-wrap: wrap;
  }

  .role-tab-btn {
    background: transparent;
    border: 1px solid var(--color-border-divider);
    border-radius: var(--radius-xs);
    padding: 4px 10px;
    font-family: var(--font-family-ui);
    font-size: 11px;
    color: var(--color-text-tertiary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .role-tab-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  .role-tab-btn.is-active {
    background: var(--color-surface-pure);
    border-color: var(--color-brand-purple, #5e4c7a);
    color: var(--color-brand-purple, #5e4c7a);
    font-weight: var(--font-weight-medium);
  }

  .workshop-cards-stack {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .workshop-card {
    background: var(--color-surface-pure);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    padding: var(--spacing-6);
    transition: all var(--transition-fast);
  }

  .workshop-card:hover {
    border-color: var(--color-border);
    box-shadow: 0 4px 16px -6px rgba(38, 34, 28, 0.04);
  }

  .card-header-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-3);
  }

  .card-tag-group {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-3);
  }

  .work-num {
    font-family: var(--font-family-heading);
    font-size: 0.8125rem;
    font-style: italic;
    font-weight: 300;
    color: var(--color-gold-dust);
  }

  .work-status-badge {
    font-family: var(--font-family-ui);
    font-size: 11px;
    color: var(--color-brand-purple, #5e4c7a);
    background: var(--color-surface-soft);
    padding: 2px 8px;
    border-radius: 2px;
  }

  .work-triad-pills {
    font-family: var(--font-family-mono);
    font-size: 10.5px;
    color: var(--color-text-tertiary);
    letter-spacing: 0.06em;
  }

  .work-title {
    font-family: var(--font-family-heading);
    font-size: 1.1875rem;
    font-weight: var(--font-weight-normal);
    color: var(--color-text-heading);
    margin: 0 0 var(--spacing-2);
  }

  .work-summary {
    font-family: var(--font-family-body);
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin: 0 0 var(--spacing-4);
  }

  .work-breakdown-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-3);
    padding: var(--spacing-3) 0;
    border-top: 1px solid var(--color-border-divider);
    border-bottom: 1px solid var(--color-border-divider);
    margin-bottom: var(--spacing-4);
  }

  .breakdown-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .breakdown-label {
    font-family: var(--font-family-ui);
    font-size: 10.5px;
    color: var(--color-text-tertiary);
    font-weight: var(--font-weight-medium);
  }

  .breakdown-text {
    font-family: var(--font-family-body);
    font-size: 12px;
    color: var(--color-text-primary);
  }

  .work-action-row {
    display: flex;
    justify-content: flex-end;
  }

  .btn-join-work {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-family-ui);
    font-size: 11.5px;
    font-weight: var(--font-weight-medium);
    color: var(--color-brand-purple, #5e4c7a);
    cursor: pointer;
    border-bottom: 1px solid var(--color-border-divider);
    transition: all var(--transition-fast);
  }

  .btn-join-work:hover {
    color: var(--color-text-heading);
    border-bottom-color: var(--color-gold-dust);
  }

  /* ===== 表单容器 ===== */
  .form-wrapper {
    background: var(--color-surface-pure);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    padding: var(--spacing-8);
    box-shadow: 0 2px 10px -4px rgba(38, 34, 28, 0.02);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-6);
  }

  .field-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-family-ui);
    font-size: 12.5px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    letter-spacing: 0.02em;
  }

  .field-hint {
    font-family: var(--font-family-ui);
    font-size: 11px;
    color: var(--color-text-tertiary);
    font-weight: var(--font-weight-normal);
  }

  .quiet-form input[type='text'],
  .quiet-form textarea {
    width: 100%;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border-divider);
    border-radius: var(--radius-xs);
    padding: var(--spacing-3) var(--spacing-4);
    font-family: var(--font-family-body);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-primary);
    transition: border-color var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast);
  }

  .quiet-form input[type='text']:focus,
  .quiet-form textarea:focus {
    outline: none;
    border-color: var(--color-brand-purple, #5e4c7a);
    background: var(--color-surface-pure);
    box-shadow: none;
  }

  .quiet-form input[type='text'].glow-spark {
    border-color: var(--color-gold-dust) !important;
    background: var(--color-surface-pure) !important;
    box-shadow: 0 0 0 2px rgba(216, 205, 176, 0.25) !important;
  }

  /* 前置细线选项列表 */
  .quiet-check-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .quiet-check-row {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-3);
    padding: var(--spacing-3) var(--spacing-4);
    border: 1px solid var(--color-border-divider);
    border-radius: var(--radius-xs);
    background: transparent;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .quiet-check-row:hover {
    border-color: var(--color-border);
    background: var(--color-surface-soft);
  }

  .quiet-check-row input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .check-indicator {
    width: 13px;
    height: 13px;
    margin-top: 3px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-surface-pure);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  .is-radio .check-indicator {
    border-radius: 50%;
  }

  .quiet-check-row input:checked ~ .check-indicator {
    border-color: var(--color-brand-purple, #5e4c7a);
    background: var(--color-brand-purple, #5e4c7a);
  }

  .is-radio input:checked ~ .check-indicator::after {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-surface-pure);
  }

  .quiet-check-row svg {
    width: 9px;
    height: 9px;
    stroke: var(--color-surface-pure);
    stroke-width: 1.8;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .quiet-check-row input:checked ~ .check-indicator svg {
    opacity: 1;
  }

  .check-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .check-title {
    font-family: var(--font-family-body);
    font-size: 13px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }

  .check-note {
    font-family: var(--font-family-ui);
    font-size: 11px;
    color: var(--color-text-tertiary);
  }

  /* 调整后的横向提交栏 (Submit Bar) */
  .submit-bar {
    margin-top: var(--spacing-8);
    padding-top: var(--spacing-5);
    border-top: 1px solid var(--color-border-divider);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }

  .submit-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-3);
    padding: var(--spacing-3) var(--spacing-6);
    background: var(--color-brand-purple, #5e4c7a);
    color: var(--color-surface-pure);
    border: none;
    border-radius: var(--radius-xs);
    font-family: var(--font-family-ui);
    font-size: 12px;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .submit-btn-primary:hover {
    background: var(--color-brand-purple-dark, #4d3d66);
  }

  .submit-btn-primary .btn-arrow {
    transition: transform var(--transition-fast);
  }

  .submit-btn-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  .privacy-assurance-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    font-family: var(--font-family-ui);
    font-size: 11px;
    color: var(--color-text-tertiary);
    letter-spacing: 0.02em;
  }

  .privacy-dot {
    color: var(--color-gold-dust);
    font-size: 9px;
  }

  .feedback-receipt-box {
    margin-top: 0;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
    animation: fadeInReceipt 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInReceipt {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .receipt-head {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-4);
    padding-bottom: var(--spacing-4);
    border-bottom: 1px solid var(--color-border-divider);
  }

  .receipt-icon {
    color: var(--color-gold-dust);
    font-size: 1.25rem;
  }

  .receipt-msg-title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: 1.0625rem;
    color: var(--color-text-heading);
  }

  .receipt-id-tag {
    margin: 2px 0 0;
    font-family: var(--font-family-mono);
    font-size: 11.5px;
    color: var(--color-gold-dust);
    letter-spacing: 0.05em;
  }

  .receipt-status-banner {
    margin: var(--spacing-4) 0 var(--spacing-6);
  }

  .receipt-note {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .receipt-note code {
    font-family: var(--font-family-mono);
    background: var(--color-surface-soft);
    padding: 2px 7px;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    font-size: 12px;
    color: var(--color-brand-purple, #5e4c7a);
    word-break: break-all;
    overflow-wrap: anywhere;
    max-width: 100%;
    display: inline;
  }

  .receipt-loop-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
    margin: var(--spacing-6) 0;
  }

  .loop-cell {
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    padding: var(--spacing-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color var(--transition-fast);
  }

  .loop-cell:hover {
    border-color: var(--color-gold-dust);
  }

  .loop-cell-info {
    margin-bottom: var(--spacing-4);
  }

  .loop-cell-tag {
    display: inline-block;
    font-family: var(--font-family-ui);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand-purple, #5e4c7a);
    margin-bottom: var(--spacing-2);
    font-weight: 500;
  }

  .loop-cell-desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 12px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .btn-download-ics {
    align-self: flex-start;
    background: transparent;
    border: 1px solid var(--color-gold-dust);
    color: var(--color-gold-dust);
    padding: 7px 14px;
    font-family: var(--font-family-ui);
    font-size: 11.5px;
    cursor: pointer;
    border-radius: var(--radius-xs);
    transition: all 0.2s ease;
  }

  .btn-download-ics:hover {
    background: var(--color-gold-dust);
    color: #fff;
  }

  .wechat-field-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--color-surface-pure);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    margin-top: auto;
    transition: border-color var(--transition-fast);
  }

  .wechat-field-card:hover {
    border-color: var(--color-gold-dust);
  }

  .wechat-text-col {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2);
  }

  .wechat-label-caption {
    font-family: var(--font-family-ui);
    font-size: 11px;
    color: var(--color-text-tertiary);
    letter-spacing: 0.04em;
  }

  .wechat-handle {
    font-family: var(--font-family-mono);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-text-heading);
    letter-spacing: 0.03em;
    background: none;
    border: none;
    padding: 0;
  }

  .btn-copy-hairline {
    background: transparent;
    border: 1px solid var(--color-border-divider);
    color: var(--color-text-secondary);
    font-family: var(--font-family-ui);
    font-size: 11px;
    padding: 3px 10px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-copy-hairline:hover {
    border-color: var(--color-gold-dust);
    color: var(--color-gold-dust);
    background: var(--color-surface-card);
  }

  .receipt-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-border-divider);
    font-size: 11.5px;
  }

  .receipt-remind {
    color: var(--color-text-tertiary);
    font-family: var(--font-family-body);
  }

  .btn-modify-form {
    background: none;
    border: none;
    color: var(--color-text-secondary);
    font-size: 11.5px;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0;
  }

  .btn-modify-form:hover {
    color: var(--color-text-heading);
  }

  /* ============================================================
     移动端极限响应式优化 (Mobile Perfection Breakpoints)
     严格限定在媒体查询内部，绝对不波及 Web 桌面端
     ============================================================ */
  @media (max-width: 860px) {
    .page-root {
      padding: var(--spacing-3) 0 var(--spacing-12);
    }

    .two-column-layout {
      grid-template-columns: 1fr;
      gap: var(--spacing-6);
    }

    .sidebar {
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--color-border-divider);
      padding-right: 0;
      padding-bottom: var(--spacing-6);
      margin-bottom: 0;
    }

    .brand-group {
      margin-bottom: var(--spacing-4);
    }

    .site-title {
      font-size: clamp(2rem, 8vw, 2.5rem);
      line-height: 1.1;
    }

    .site-sub {
      font-size: 11px;
      margin-top: 3px;
    }

    .site-zh {
      font-size: 12px;
      margin-top: 2px;
    }

    .manifesto {
      font-size: 14px;
      line-height: 1.75;
      margin-bottom: var(--spacing-4);
    }

    .sidebar-divider {
      margin: var(--spacing-4) 0;
    }

    .who-section {
      margin-top: var(--spacing-3);
      margin-bottom: 0;
    }

    .who-desc {
      font-size: 13px;
