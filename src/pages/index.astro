---
import Layout from '../layouts/Layout.astro';
import GeometricVisual from '../components/GeometricVisual.astro';
---

<Layout
  title='wo/men in tech · women in technical'
  description='面向技术与创造领域女性的慢节奏社群。在商业项目之外，做一些纯粹的事。'
  width='reading'
>
  <div class='page-root'>
    <div class='two-column-layout'>

      {/* ===== 左侧：品牌与宣言 ===== */}
      <aside class='sidebar' id='about'>

        <div class='brand-group'>
          <h1 class='site-title'>wo<span class='brand-slash'>/</span>men</h1>
          <p class='site-sub'>women in technical</p>
          <p class='site-zh'>"我们"</p>
        </div>

        <div class='manifesto'>
          <p>
            在每一个商业项目的空隙里，<br />
            总有一些东西是做给自己的。
          </p>
          <p>
            这里是那个地方。
          </p>
        </div>

        <div class='sidebar-divider'></div>

        <div class='who-section'>
          <span class='who-label'>面向</span>
          <p class='who-desc'>
            所有在技术与创造领域工作的女性——<br />
            产品、设计、工程、研究、写作……
          </p>
          <p class='who-note'>
            不需要特定头衔，<br />
            只是对作品本身有一点执念。
          </p>
        </div>

        <div class='sidebar-footer'>
          <GeometricVisual type='subtle' height='72px' />
        </div>
      </aside>

      {/* ===== 右侧：内容区 ===== */}
      <main class='content-main'>

        {/* 1. 我们做什么 */}
        <section class='content-block' id='events'>
          <span class='eyebrow'>WHAT WE DO</span>

          <div class='gathering-list'>

            <div class='gathering-item'>
              <div class='gathering-meta'>
                <span class='gathering-type'>Coffee Chat</span>
                <span class='gathering-freq'>线上 / 杭州 · 双周</span>
              </div>
              <p class='gathering-desc'>
                不是 networking。<br />
                两三个人，把手里的咖啡喝完，<br />
                谈谈最近在做的事——或者什么也不谈。
              </p>
            </div>

            <div class='gathering-item'>
              <div class='gathering-meta'>
                <span class='gathering-type'>English Chat</span>
                <span class='gathering-freq'>线上 · 不定期</span>
              </div>
              <p class='gathering-desc'>
                用英语聊产品、设计或技术，<br />
                一个不被评判的地方练习表达，<br />
                没有标准答案，只有真实的体悟。
              </p>
            </div>

            <div class='gathering-item'>
              <div class='gathering-meta'>
                <span class='gathering-type'>作品 · Lab</span>
                <span class='gathering-freq'>小组制 · 慢工出细活</span>
              </div>
              <p class='gathering-desc'>
                把那个一直在脑子里转的想法拿出来，<br />
                找到懂你的人一起慢慢打磨。<br />
                不赶 deadline，不做 MVP，只做值得的事。
              </p>
            </div>

          </div>
        </section>

        {/* 2. 近期安排 */}
        <section class='content-block' id='schedule'>
          <span class='eyebrow'>UPCOMING</span>

          <div class='schedule-list'>
            <div class='schedule-item'>
              <div class='schedule-left'>
                <span class='schedule-num'>01</span>
                <span class='schedule-tag'>Coffee Chat</span>
              </div>
              <div class='schedule-right'>
                <p class='schedule-title'>AI 时代，还剩下什么是属于自己的？</p>
                <p class='schedule-detail'>杭州线下 + 线上同步 · 时间待定</p>
              </div>
            </div>

            <div class='schedule-item'>
              <div class='schedule-left'>
                <span class='schedule-num'>02</span>
                <span class='schedule-tag'>English Chat</span>
              </div>
              <div class='schedule-right'>
                <p class='schedule-title'>Show & Tell — Walk me through something you made</p>
                <p class='schedule-detail'>线上 · 40 min · 每人 5 分钟展示即可</p>
              </div>
            </div>
          </div>
        </section>

        {/* 3. 加入 */}
        <section class='content-block' id='join'>
          <span class='eyebrow'>JOIN THE CIRCLE</span>

          <div class='join-intro'>
            <p>
              如果你有共鸣，欢迎留下联系方式。<br />
              我们会邀你参加下一次活动。
            </p>
          </div>

          <div class='form-wrapper'>
            <form id='join-form' class='quiet-form'>

              <div class='form-row'>
                <label for='name'>称呼</label>
                <input
                  type='text'
                  id='name'
                  name='name'
                  placeholder='Erin / Alex / 随便什么都行'
                  required
                  autocomplete='off'
                />
              </div>

              <div class='form-row'>
                <label>你大概在做什么</label>
                <div class='craft-pills' id='craft-pills'>
                  <button type='button' class='craft-pill' data-val='design'>设计 / 视觉</button>
                  <button type='button' class='craft-pill' data-val='product'>产品</button>
                  <button type='button' class='craft-pill' data-val='engineering'>工程 / 开发</button>
                  <button type='button' class='craft-pill' data-val='research'>研究 / 写作</button>
                  <button type='button' class='craft-pill' data-val='other'>其他创造性工作</button>
                </div>
                <input type='hidden' id='craft-value' name='craft' value='' />
              </div>

              <div class='form-row'>
                <label>感兴趣的活动</label>
                <div class='interest-pills'>
                  <label class='interest-pill'>
                    <input type='checkbox' name='interests' value='coffee' checked />
                    <span>Coffee Chat</span>
                  </label>
                  <label class='interest-pill'>
                    <input type='checkbox' name='interests' value='english' checked />
                    <span>English Chat</span>
                  </label>
                  <label class='interest-pill'>
                    <input type='checkbox' name='interests' value='lab' checked />
                    <span>作品 Lab</span>
                  </label>
                </div>
              </div>

              <div class='form-row'>
                <label for='idea'>正在琢磨的事（可选）</label>
                <textarea
                  id='idea'
                  name='idea'
                  rows='2'
                  placeholder='一个想法、一个困惑、或者只是想见见同类……'
                ></textarea>
              </div>

              <div class='form-row'>
                <label for='contact'>微信 / 邮箱</label>
                <input
                  type='text'
                  id='contact'
                  name='contact'
                  placeholder='仅用于活动邀请'
                  required
                  autocomplete='off'
                />
              </div>

              <button type='submit' class='submit-btn'>
                <span>留下联系方式</span>
                <span class='btn-arrow'>→</span>
              </button>

              <div id='form-feedback' style='display: none;'>
                <div class='feedback-card'>
                  <span class='feedback-mark'>✦</span>
                  <div>
                    <p class='feedback-title'>收到了。</p>
                    <p class='feedback-note'>我们会在下次活动前联系你。</p>
                  </div>
                </div>
              </div>

            </form>
          </div>
        </section>

      </main>
    </div>
  </div>
</Layout>

<script>
  // 作品方向胶囊（单选，可取消）
  const craftPills = document.querySelectorAll('.craft-pill');
  const craftInput = document.getElementById('craft-value') as HTMLInputElement | null;

  craftPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const isActive = pill.classList.contains('is-active');
      craftPills.forEach((p) => p.classList.remove('is-active'));
      if (!isActive) {
        pill.classList.add('is-active');
        if (craftInput) craftInput.value = pill.getAttribute('data-val') || '';
      } else {
        if (craftInput) craftInput.value = '';
      }
    });
  });

  // 表单提交
  const form = document.getElementById('join-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      feedback.style.display = 'block';
      const btn = form.querySelector('.submit-btn') as HTMLElement | null;
      if (btn) btn.style.display = 'none';
      feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
</script>

<style>
  /* ===== 页面容器 ===== */
  .page-root {
    padding: var(--spacing-10) 0 var(--spacing-24);
  }

  /* ===== 双栏布局 ===== */
  .two-column-layout {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: var(--spacing-16);
    align-items: start;
  }

  /* ===== 左侧栏 ===== */
  .sidebar {
    position: sticky;
    top: var(--spacing-8);
    padding-right: var(--spacing-8);
    border-right: var(--border-width-thin) solid var(--color-border-divider);
  }

  /* 品牌标识 */
  .brand-group {
    margin-bottom: var(--spacing-10);
  }

  .site-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-heading);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 var(--spacing-2);
    text-decoration: none !important;
    border-bottom: none !important;
  }

  .site-title .brand-slash {
    color: var(--color-gold-dust);
    opacity: 0.7;
    font-weight: 300;
  }

  .site-sub {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    color: var(--color-text-tertiary);
    text-transform: lowercase;
    margin: 0;
  }

  .site-zh {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    color: var(--color-primary-dark);
    letter-spacing: 0.06em;
    margin: 0;
    margin-top: 2px;
  }

  /* 宣言 */
  .manifesto {
    margin-bottom: var(--spacing-8);
  }

  .manifesto p {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.9;
    margin: 0 0 var(--spacing-4);
    font-weight: var(--font-weight-light);
    font-style: italic;
  }

  .manifesto p:last-child {
    margin: 0;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
  }

  /* 分隔线 */
  .sidebar-divider {
    width: 2rem;
    height: 1px;
    background: var(--color-gold-dust);
    opacity: 0.4;
    margin: var(--spacing-8) 0;
  }

  /* 面向谁 */
  .who-section {
    margin-bottom: var(--spacing-8);
  }

  .who-label {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--spacing-3);
  }

  .who-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin: 0 0 var(--spacing-3);
  }

  .who-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    line-height: 1.7;
    margin: 0;
    font-style: italic;
  }

  .sidebar-footer {
    margin-top: var(--spacing-12);
    opacity: 0.5;
  }

  /* ===== 右侧内容区 ===== */
  .content-main {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .content-block {
    position: relative;
  }

  /* 小标签 Eyebrow */
  .eyebrow {
    display: block;
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    color: var(--color-primary-dark);
    text-transform: uppercase;
    margin-bottom: var(--spacing-8);
    font-weight: var(--font-weight-medium);
  }

  /* ===== 1. 聚会活动列表 ===== */
  .gathering-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .gathering-item {
    padding: var(--spacing-7) 0;
    border-bottom: var(--border-width-thin) solid var(--color-border-divider);
  }

  .gathering-item:first-child {
    padding-top: 0;
  }

  .gathering-item:last-child {
    border-bottom: none;
  }

  .gathering-meta {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-4);
  }

  .gathering-type {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .gathering-freq {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    letter-spacing: 0.04em;
  }

  .gathering-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.85;
    margin: 0;
    max-width: 38em;
  }

  /* ===== 2. 近期安排 ===== */
  .schedule-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
  }

  .schedule-item {
    display: flex;
    gap: var(--spacing-6);
    align-items: flex-start;
    padding: var(--spacing-5) var(--spacing-5);
    background: var(--color-surface-pure);
    border: var(--border-width-thin) solid var(--color-border-subtle);
    border-radius: 6px;
  }

  .schedule-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 56px;
    gap: 4px;
    padding-top: 2px;
  }

  .schedule-num {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-light);
    color: var(--color-text-heading);
    line-height: 1;
  }

  .schedule-tag {
    font-size: 10px;
    font-family: var(--font-family-ui);
    color: var(--color-primary-dark);
    letter-spacing: 0.04em;
    text-align: center;
  }

  .schedule-right {
    flex-grow: 1;
  }

  .schedule-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-base);
    color: var(--color-text-heading);
    margin: 0 0 var(--spacing-2);
    font-weight: var(--font-weight-normal);
    letter-spacing: -0.01em;
  }

  .schedule-detail {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    margin: 0;
  }

  /* ===== 3. 加入表单 ===== */
  .join-intro {
    margin-bottom: var(--spacing-6);
  }

  .join-intro p {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.85;
    margin: 0;
  }

  .form-wrapper {
    background: var(--color-surface-pure);
    border: var(--border-width-thin) solid var(--color-border-subtle);
    border-radius: 6px;
    padding: var(--spacing-8);
  }

  .quiet-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-7);
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .form-row label {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-tertiary);
    letter-spacing: 0.04em;
  }

  /* 作品方向胶囊（单选） */
  .craft-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .craft-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.9rem;
    background: transparent;
    border: var(--border-width-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .craft-pill:hover {
    border-color: var(--color-primary-300);
    color: var(--color-text-primary);
  }

  .craft-pill.is-active {
    background: var(--color-primary-50);
    border-color: var(--color-primary);
    color: var(--color-text-heading);
    font-weight: var(--font-weight-medium);
  }

  /* 兴趣胶囊（多选） */
  .interest-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .interest-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.35rem 0.9rem;
    background: var(--color-surface-soft);
    border: var(--border-width-thin) solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .interest-pill input[type='checkbox'] {
    display: none;
  }

  .interest-pill:has(input:checked) {
    background: var(--color-primary-50);
    border-color: var(--color-primary);
    color: var(--color-text-heading);
  }

  /* 提交按钮 */
  .submit-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: 0.65rem var(--spacing-6);
    background: var(--color-text-heading);
    color: var(--color-bg-page);
    border: none;
    border-radius: 4px;
    font-family: var(--font-family-ui);
    font-size: var(--font-size-sm);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all var(--transition-fast);
    margin-top: var(--spacing-2);
  }

  .submit-btn:hover {
    background: var(--color-text-primary);
    transform: translateY(-1px);
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
  }

  .submit-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* 提交反馈 */
  .feedback-card {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-4);
    padding: var(--spacing-5);
    background: var(--color-primary-50);
    border: var(--border-width-thin) solid var(--color-primary-200);
    border-radius: 6px;
    margin-top: var(--spacing-4);
  }

  .feedback-mark {
    color: var(--color-primary-dark);
    font-size: var(--font-size-base);
    margin-top: 1px;
  }

  .feedback-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-base);
    color: var(--color-text-heading);
    margin: 0 0 var(--spacing-1);
    font-weight: var(--font-weight-normal);
  }

  .feedback-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ===== 响应式 ===== */
  @media (width <= 1024px) {
    .two-column-layout {
      grid-template-columns: 1fr;
      gap: var(--spacing-12);
    }

    .sidebar {
      position: static;
      border-right: none;
      border-bottom: var(--border-width-thin) solid var(--color-border-divider);
      padding-right: 0;
      padding-bottom: var(--spacing-10);
    }

    .site-title {
      font-size: var(--font-size-3xl);
    }
  }

  @media (width <= 640px) {
    .gathering-type {
      font-size: var(--font-size-lg);
    }

    .form-wrapper {
      padding: var(--spacing-5);
    }

    .schedule-item {
      flex-direction: column;
      gap: var(--spacing-3);
    }

    .schedule-left {
      flex-direction: row;
      align-items: center;
      gap: var(--spacing-2);
      min-width: auto;
    }
  }
</style>
