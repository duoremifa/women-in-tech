                <div class='receipt-footer-row'>
                  <span class='receipt-remind lang-zh'>添加微信时请备注回执编号，我们将邀你进入当期交流。</span>
                  <span class='receipt-remind lang-en'>Please include your receipt ID when connecting.</span>
                  <button type='button' class='btn-modify-form' id='home-btn-modify-form'>
                    <span class='lang-zh'>修改或重填 ↺</span>
                    <span class='lang-en'>Edit note ↺</span>
                  </button>
                </div>
              </div>

            </form>
          </div>
        </section>

      </main>
    </div>
