---
import Layout from '../layouts/Layout.astro';
import CalendarAdd from '../components/CalendarAdd.astro';
import { GATHERINGS, upcomingGatherings, pastGatherings, type Gathering } from '../data/gatherings';

const now = new Date();
const upcoming = upcomingGatherings(now);
const past = pastGatherings(now);

const statusMeta: Record<string, { zh: string; en: string; cls: string }> = {
  open: { zh: '还能报名', en: 'Open', cls: 'status-open' },
  forming: { zh: '小组筹备中', en: 'Cohort Forming', cls: 'status-forming' },
  full: { zh: '已满', en: 'Full', cls: 'status-full' },
  past: { zh: '已结束', en: 'Past', cls: 'status-past' },
};

const typeLabel: Record<string, string> = { coffee: 'Coffee Chat', english: 'English Chat', lab: 'Craft Lab' };

function fmtDate(iso: string, locale: string) {
  return new Date(iso).toLocaleDateString(locale, { month: 'long', day: 'numeric', weekday: 'short' });
}
function fmtTime(iso: string) {
  return new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Shanghai' });
}
---

<Layout
  title='近期安排 · Upcoming · wo/men in tech'
  description='Coffee Chat 与 Show & Tell 的真实排期。订阅日历源一次同步下期，或直接预订某一期。'
  width='reading'
>
  <div class='page-container'>
    <header class='page-header'>
      <span class='section-eyebrow'>UPCOMING GATHERINGS</span>
      <div lang='zh-CN' class='lang-zh'>
        <h1 class='page-title'>近期安排</h1>
        <p class='page-lead'>每一场 3–6 人 · 极小规模 · 真诚对话</p>
      </div>
      <div lang='en' class='lang-en'>
        <h1 class='page-title'>Upcoming Gatherings</h1>
        <p class='page-lead'>Every gathering is intentionally intimate—3 to 6 people, unhurried.</p>
      </div>
      <div class='gold-hairline'></div>
    </header>

    {/* ── 订阅卡（webcal + 邮件）── */}
    <section class='subscribe-card' aria-label='订阅排期'>
      <div class='subscribe-text'>
        <span class='sub-eyebrow'>SUBSCRIBE · 订阅</span>
        <div lang='zh-CN' class='lang-zh'>
          <h2>一次订阅，下期自动同步</h2>
          <p>在系统日历订阅日历源，新排期上线自动到，过期自动撤。零打扰。</p>
        </div>
        <div lang='en' class='lang-en'>
          <h2>Subscribe once, stay in sync</h2>
          <p>New slots arrive automatically in your system calendar; past ones fade out. Zero noise.</p>
        </div>
      </div>
      <div class='subscribe-actions'>
        <CalendarAdd />
        <form class='email-sub' id='upcoming-email-sub'>
          <input type='email' name='email' required autocomplete='email' placeholder='你的邮箱 / your email' aria-label='邮箱 / email' />
          <button type='submit' class='email-sub-btn'>
            <span lang='zh-CN' class='lang-zh'>提醒我</span>
            <span lang='en' class='lang-en'>Notify me</span>
          </button>
        </form>
        <p class='email-sub-msg' id='upcoming-email-msg' role='status' aria-live='polite'></p>
      </div>
    </section>

    {/* ── 排期列表 ── */}
    <div class='schedule-stack'>
      {upcoming.map((g: Gathering) => {
        const s = statusMeta[g.status];
        return (
          <article class='schedule-block'>
            <div class='schedule-indicator'>
              <span class='block-type'>{typeLabel[g.type]}</span>
              <span class='block-num'>{g.type === 'coffee' ? '01' : g.type === 'english' ? '02' : '03'}</span>
            </div>
            <div class='schedule-content'>
              <div class='block-status-line'>
                <span class={`status-pill ${s.cls}`}>
                  <span lang='zh-CN' class='lang-zh'>{s.zh}</span>
                  <span lang='en' class='lang-en'>{s.en}</span>
                </span>
                <span class='status-meta'>
                  {fmtDate(g.startIso, 'zh-CN')} {fmtTime(g.startIso)} GMT+8
                  {g.capacity ? ` · ${g.capacity} 人` : ''}
                </span>
              </div>

              <div lang='zh-CN' class='lang-zh'>
                <h2 class='block-title'>{g.titleZh}</h2>
                <p class='block-desc'>{g.descriptionZh}</p>
              </div>
              <div lang='en' class='lang-en'>
                <h2 class='block-title'>{g.titleEn}</h2>
                <p class='block-desc'>{g.descriptionEn}</p>
              </div>

              <div class='block-meta-grid'>
                <div class='meta-col'>
                  <span class='meta-label'>形式 / Format</span>
                  <span class='meta-val'>{g.location.type === 'VirtualLocation' ? '线上视频室' : '杭州线下 + 线上'}</span>
                </div>
                <div class='meta-col'>
                  <span class='meta-label'>时间 / Time</span>
                  <span class='meta-val'>{fmtDate(g.startIso, 'en-US')} {fmtTime(g.startIso)}–{fmtTime(g.endIso)} GMT+8</span>
                </div>
              </div>

              <div class='block-action'>
                {g.episodeSlug && (
                  <a class='btn-episode' href={`/podcast/${g.episodeSlug}/`}>
                    <span lang='zh-CN' class='lang-zh'>本期录制 ↗</span>
                    <span lang='en' class='lang-en'>Recorded ↗</span>
                  </a>
                )}
                {g.status === 'open' && (
                  <>
                    <a class='btn-ics' href={`/gatherings/${g.id}.ics`} download>
                      <span lang='zh-CN' class='lang-zh'>加这一期到日历</span>
                      <span lang='en' class='lang-en'>Add this slot</span>
                    </a>
                    <a class='btn-rsvp' href={`/join?slot=${g.id}`}>
                      <span lang='zh-CN' class='lang-zh'>我要参加 ⟶</span>
                      <span lang='en' class='lang-en'>I'll join ⟶</span>
                    </a>
                  </>
                )}
                {g.status === 'forming' && (
                  <a class='btn-rsvp' href={`/join?interest=portfolio_building&slot=${g.id}`}>
                    <span lang='zh-CN' class='lang-zh'>表达共建意向 ⟶</span>
                    <span lang='en' class='lang-en'>Express interest ⟶</span>
                  </a>
                )}
                {g.status === 'full' && (
                  <span class='full-note'>
                    <span lang='zh-CN' class='lang-zh'>本期已满，可订阅日历源等候下期</span>
                    <span lang='en' class='lang-en'>Full—subscribe the calendar feed for the next round</span>
                  </span>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {/* ── 回环区：已结束 + 回顾 ── */}
    {past.length > 0 && (
      <section class='past-section'>
        <span class='section-eyebrow'>PAST · 已结束 · 回环</span>
        <h2 lang='zh-CN' class='lang-zh past-title'>已结束的相聚，与回顾</h2>
        <h2 lang='en' class='lang-en past-title'>Past Gatherings & Recaps</h2>
        <div class='past-stack'>
          {past.map(g => (
            <article class='past-block'>
              <div class='past-meta'>
                <span class='past-type'>{typeLabel[g.type]}</span>
                <span class='past-date'>{fmtDate(g.startIso, 'zh-CN')}</span>
              </div>
              <h3 lang='zh-CN' class='lang-zh'>{g.titleZh}</h3>
              <h3 lang='en' class='lang-en'>{g.titleEn}</h3>
              {g.reviewSlug ? (
                <a class='review-link' href={`/reviews/${g.reviewSlug}`}>
                  <span lang='zh-CN' class='lang-zh'>回顾 ↗</span>
                  <span lang='en' class='lang-en'>Recap ↗</span>
                </a>
              ) : (
                <span class='review-pending'>
                  <span lang='zh-CN' class='lang-zh'>回顾整理中</span>
                  <span lang='en' class='lang-en'>Recap pending</span>
                </span>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    {/* ── FAQ ── */}
    <footer class='faq-section'>
      <div class='faq-card'>
        <h3 lang='zh-CN' class='lang-zh'>关于活动的二三事</h3>
        <h3 lang='en' class='lang-en'>Circle FAQ</h3>
        <div lang='zh-CN' class='faq-grid lang-zh'>
          <div class='faq-item'><h4>收费吗？</h4><p>纯公益，无任何费用。线下各自点单，线上完全免费。</p></div>
          <div class='faq-item'><h4>必须说很多话吗？</h4><p>完全不用。安静聆听同样受到欢迎。</p></div>
        </div>
        <div lang='en' class='faq-grid lang-en'>
          <div class='faq-item'><h4>Any fees?</h4><p>None. Cover your own drink offline; online is free.</p></div>
          <div class='faq-item'><h4>Must I talk?</h4><p>Never. Quiet listening is equally valued.</p></div>
        </div>
      </div>
    </footer>

    <section class='next-steps'>
      <div class='next-card'>
        <div lang='zh-CN' class='next-text lang-zh'>
          <h3>想直接加入？</h3>
          <p>留下你的声音，或先看看日常。</p>
        </div>
        <div lang='en' class='next-text lang-en'>
          <h3>Ready to join?</h3>
          <p>Leave a note, or see the everyday first.</p>
        </div>
        <div class='next-actions'>
          <a href='/events' class='btn-link-gold'>
            <span lang='zh-CN' class='lang-zh'>看看日常</span>
            <span lang='en' class='lang-en'>Everyday</span>
          </a>
          <a href='/join' class='btn-solid-dark'>
            <span lang='zh-CN' class='lang-zh'>我想参与</span>
            <span lang='en' class='lang-en'>I want in</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupEmailSub() {
    const form = document.getElementById('upcoming-email-sub') as HTMLFormElement | null;
    const msg = document.getElementById('upcoming-email-msg');
    if (!form || (form as any).__bound) return;
    (form as any).__bound = true;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.querySelector('input[type=email]') as HTMLInputElement).value.trim();
      if (!email) return;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      if (btn) btn.disabled = true;
      const isEn = document.documentElement.getAttribute('data-lang') === 'en';
      try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 12000);
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'upcoming', locale: isEn ? 'en' : 'zh' }),
          signal: ctrl.signal,
        });
        clearTimeout(timer);
        if (res.ok) {
          if (msg) msg.textContent = isEn ? '✓ Subscribed — low-frequency notices only.' : '✓ 已订阅，仅低频提醒。';
          (form.querySelector('input[type=email]') as HTMLInputElement).value = '';
        } else {
          if (msg) msg.textContent = isEn ? 'Subscription failed, please retry.' : '订阅失败，请重试。';
        }
      } catch (err) {
        if (msg) msg.textContent = isEn ? 'Network error — please retry later.' : '网络异常，请稍后重试。';
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
  setupEmailSub();
  document.addEventListener('astro:page-load', setupEmailSub);
</script>

<style>
  .page-container { padding: var(--spacing-6) 0 var(--spacing-20); }
  .page-header { margin-bottom: var(--spacing-10); }
  .section-eyebrow { font-family: var(--font-family-mono); font-size: var(--font-size-xs); letter-spacing: 0.12em; color: var(--color-gold-dust); display: block; margin-bottom: var(--spacing-2); }
  .page-title { font-family: var(--font-family-heading); font-size: var(--font-size-3xl); font-weight: var(--font-weight-light); color: var(--color-text-heading); letter-spacing: -0.02em; margin: 0 0 var(--spacing-3); }
  .page-lead { font-family: var(--font-family-body); font-size: var(--font-size-base); color: var(--color-text-secondary); line-height: 1.85; margin: 0; }
  .gold-hairline { width: var(--spacing-12); height: 1px; background: var(--color-gold-dust); opacity: 0.7; margin-top: var(--spacing-5); }

  /* 订阅卡 */
  .subscribe-card { background: var(--color-surface-pure); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); padding: var(--spacing-6) var(--spacing-6); display: flex; justify-content: space-between; align-items: center; gap: var(--spacing-5); margin-bottom: var(--spacing-12); }
  .sub-eyebrow { font-family: var(--font-family-mono); font-size: 11px; letter-spacing: 0.12em; color: var(--color-gold-dust); display: block; margin-bottom: var(--spacing-2); }
  .subscribe-text h2 { font-family: var(--font-family-heading); font-size: var(--font-size-lg); font-weight: var(--font-weight-normal); color: var(--color-text-heading); margin: 0 0 var(--spacing-1); }
  .subscribe-text p { font-family: var(--font-family-body); font-size: 13px; color: var(--color-text-secondary); line-height: 1.7; margin: 0; }
  .subscribe-actions { display: flex; flex-direction: column; gap: var(--spacing-2); align-items: flex-end; }
  .subscribe-btn { padding: var(--spacing-2) var(--spacing-4); border-radius: var(--radius-xs); font-family: var(--font-family-ui); font-size: 12px; text-decoration: none !important; letter-spacing: 0.04em; transition: background var(--transition-fast), border-color var(--transition-fast); white-space: nowrap; }
  .subscribe-btn.primary { background: var(--color-brand-purple); color: var(--color-surface-pure) !important; }
  .subscribe-btn.primary:hover { background: var(--color-brand-purple-dark); }
  .subscribe-btn.ghost { border: 1px solid var(--color-border); color: var(--color-text-primary) !important; }
  .subscribe-btn.ghost:hover { border-color: var(--color-gold-dust); color: var(--color-primary-dark) !important; }
  .subscribe-link { font-family: var(--font-family-ui); font-size: 11px; color: var(--color-text-tertiary); text-decoration: none !important; border-bottom: 1px solid var(--color-border-divider) !important; padding-bottom: 1px; }

  /* 邮件提醒迷你表单 */
  .email-sub { display: flex; gap: var(--spacing-2); align-items: stretch; }
  .email-sub input[type='email'] {
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border-divider);
    border-radius: var(--radius-xs);
    padding: 6px 10px;
    font-family: var(--font-family-body);
    font-size: 12px;
    color: var(--color-text-primary);
    min-width: 160px;
    box-sizing: border-box;
  }
  .email-sub input[type='email']:focus { outline: none; border-color: var(--color-brand-purple); }
  .email-sub-btn {
    padding: 6px 14px;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    border-radius: var(--radius-xs);
    font-family: var(--font-family-ui);
    font-size: 12px;
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .email-sub-btn:hover { border-color: var(--color-gold-dust); color: var(--color-primary-dark); }
  .email-sub-msg { font-family: var(--font-family-ui); font-size: 11px; color: var(--color-text-tertiary); margin-top: var(--spacing-1); min-height: 1em; }

  /* 排期块 */
  .schedule-stack { display: flex; flex-direction: column; gap: 0; }
  .schedule-block { display: grid; grid-template-columns: 90px 1fr; gap: var(--spacing-6); border-bottom: 1px solid var(--color-border-divider); padding: var(--spacing-8) var(--spacing-2); }
  .schedule-block:last-of-type { border-bottom: none; }
  .schedule-indicator { display: flex; flex-direction: column; gap: var(--spacing-1); border-right: 1px solid var(--color-border-divider); padding-right: var(--spacing-4); }
  .block-type { font-family: var(--font-family-ui); font-size: 11px; color: var(--color-text-tertiary); }
  .block-num { font-family: var(--font-family-heading); font-size: 0.8125rem; font-style: italic; font-weight: 300; color: var(--color-gold-dust); }
  .schedule-content { display: flex; flex-direction: column; }
  .block-status-line { display: flex; align-items: center; gap: var(--spacing-3); margin-bottom: var(--spacing-3); flex-wrap: wrap; }
  .status-pill { font-family: var(--font-family-ui); font-size: 11px; padding: 2px 8px; border-radius: 2px; letter-spacing: 0.04em; }
  .status-pill.status-open { background: var(--color-surface-soft); color: var(--color-primary-dark); font-weight: var(--font-weight-medium); }
  .status-pill.status-forming { background: var(--color-surface-soft); color: var(--color-text-tertiary); }
  .status-pill.status-full { background: var(--color-surface-soft); color: var(--color-text-tertiary); }
  .status-meta { font-family: var(--font-family-mono); font-size: 11px; color: var(--color-text-tertiary); }
  .block-title { font-family: var(--font-family-heading); font-size: var(--font-size-xl); font-weight: var(--font-weight-normal); color: var(--color-text-heading); margin: 0 0 var(--spacing-2); }
  .block-desc { font-family: var(--font-family-body); font-size: var(--font-size-sm); color: var(--color-text-secondary); line-height: 1.75; margin: 0 0 var(--spacing-4); }
  .block-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-4); padding: var(--spacing-3) 0; border-top: 1px solid var(--color-border-divider); border-bottom: 1px solid var(--color-border-divider); margin-bottom: var(--spacing-4); }
  .meta-col { display: flex; flex-direction: column; gap: 2px; }
  .meta-label { font-family: var(--font-family-ui); font-size: 10.5px; color: var(--color-text-tertiary); }
  .meta-val { font-family: var(--font-family-body); font-size: 12.5px; color: var(--color-text-primary); }
  .block-action { display: flex; justify-content: flex-end; gap: var(--spacing-3); align-items: center; flex-wrap: wrap; }
  .btn-episode { font-family: var(--font-family-ui); font-size: 11px; color: var(--color-text-tertiary); text-decoration: none !important; border-bottom: 1px solid var(--color-border-divider) !important; padding-bottom: 2px; font-style: italic; transition: color var(--transition-fast), border-color var(--transition-fast); }
  .btn-episode:hover { color: var(--color-primary-dark); border-bottom-color: var(--color-gold-dust) !important; }
  .btn-ics { font-family: var(--font-family-ui); font-size: 11.5px; color: var(--color-text-secondary); text-decoration: none !important; border: 1px solid var(--color-border-divider) !important; padding: 4px 10px; border-radius: var(--radius-xs); transition: border-color var(--transition-fast), color var(--transition-fast); }
  .btn-ics:hover { border-color: var(--color-gold-dust) !important; color: var(--color-primary-dark); }
  .btn-rsvp { font-family: var(--font-family-ui); font-size: 11.5px; color: var(--color-primary-dark); text-decoration: none !important; border-bottom: 1px solid var(--color-gold-dust) !important; padding-bottom: 2px; font-weight: var(--font-weight-medium); transition: color var(--transition-fast); }
  .btn-rsvp:hover { color: var(--color-text-heading); }
  .full-note { font-family: var(--font-family-ui); font-size: 11.5px; color: var(--color-text-tertiary); font-style: italic; }

  /* 回环区 */
  .past-section { margin-top: var(--spacing-16); padding-top: var(--spacing-10); border-top: 1px solid var(--color-border-divider); }
  .past-title { font-family: var(--font-family-heading); font-size: var(--font-size-xl); font-weight: var(--font-weight-normal); color: var(--color-text-heading); margin: var(--spacing-2) 0 var(--spacing-5); }
  .past-stack { display: flex; flex-direction: column; gap: var(--spacing-3); }
  .past-block { display: grid; grid-template-columns: 1fr auto; gap: var(--spacing-4); align-items: baseline; padding: var(--spacing-4) 0; border-bottom: 1px solid var(--color-border-divider); }
  .past-meta { display: flex; flex-direction: column; gap: 2px; }
  .past-type { font-family: var(--font-family-ui); font-size: 10.5px; color: var(--color-gold-dust); letter-spacing: 0.06em; }
  .past-date { font-family: var(--font-family-mono); font-size: 11px; color: var(--color-text-tertiary); }
  .past-block h3 { font-family: var(--font-family-heading); font-size: 1rem; font-weight: var(--font-weight-normal); color: var(--color-text-primary); margin: 0; }
  .review-link { font-family: var(--font-family-ui); font-size: 11.5px; color: var(--color-primary-dark); text-decoration: none !important; border-bottom: 1px solid var(--color-gold-dust) !important; padding-bottom: 2px; }
  .review-link:hover { color: var(--color-text-heading); }
  .review-pending { font-family: var(--font-family-ui); font-size: 11px; color: var(--color-text-tertiary); font-style: italic; }

  /* FAQ */
  .faq-section { margin-top: var(--spacing-16); }
  .faq-card { background: var(--color-surface-pure); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); padding: var(--spacing-8); }
  .faq-card h3 { margin: 0 0 var(--spacing-5); font-family: var(--font-family-heading); font-size: var(--font-size-lg); color: var(--color-text-heading); }
  .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-6); }
  .faq-item h4 { margin: 0 0 var(--spacing-2); font-family: var(--font-family-ui); font-size: var(--font-size-sm); color: var(--color-text-primary); }
  .faq-item p { margin: 0; font-family: var(--font-family-body); font-size: var(--font-size-xs); color: var(--color-text-secondary); line-height: 1.7; }

  /* CTA */
  .next-steps { margin-top: var(--spacing-16); }
  .next-card { background: var(--color-surface-pure); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); padding: var(--spacing-8); display: flex; justify-content: space-between; align-items: center; gap: var(--spacing-6); }
  .next-text h3 { margin: 0 0 var(--spacing-1); font-family: var(--font-family-heading); font-size: var(--font-size-lg); color: var(--color-text-heading); }
  .next-text p { margin: 0; font-family: var(--font-family-body); font-size: var(--font-size-xs); color: var(--color-text-secondary); }
