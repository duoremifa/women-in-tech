---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('writing', ({ data }) => !data.draft);
  return all.map(w => ({ params: { slug: w.id }, props: { w } }));
}

const { w } = Astro.props;
const { Content } = await w.render();
const dateStr = w.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title={`${w.data.title} · wo/men in tech`}
  description={w.data.excerpt || w.data.title}
  width='reading'
>
  {w.data.draft && <meta name='robots' content='noindex' />}
  <div class='page-container'>
    <a href='/writing' class='back-link'>
      <span lang='zh-CN'>← 返回田野手记</span>
      <span lang='en'>← Back to writing</span>
    </a>

    <header class='w-head'>
      {w.data.subject && <span class='w-subject'>{w.data.subject}</span>}
      <h1 class='w-title'>{w.data.title}</h1>
      <div class='w-meta'>
        <span>{dateStr}</span>
        <span>· by Dai Min</span>
      </div>
    </header>

    <article class='w-body'>
      <Content />
    </article>

    <footer class='w-sign'>
      <span class='sign-mark' aria-hidden='true'>✦</span>
      <span>by Dai Min</span>
      <a href='/writing' class='more-link'>更多手记 →</a>
    </footer>
  </div>
</Layout>

<style>
  .page-container { padding: var(--spacing-6) 0 var(--spacing-20); max-width: 42rem; margin: 0 auto; }
  .back-link { display: inline-block; font-family: var(--font-family-ui); font-size: var(--font-size-xs); color: var(--color-text-tertiary); text-decoration: none !important; margin-bottom: var(--spacing-6); }
  .back-link:hover { color: var(--color-primary-dark); }

  .w-head { margin-bottom: var(--spacing-10); padding-bottom: var(--spacing-6); border-bottom: 1px solid var(--color-border-divider); }
  .w-subject { display: block; font-family: var(--font-family-mono); font-size: 11px; color: var(--color-gold-dust); letter-spacing: 0.1em; margin-bottom: var(--spacing-2); }
  .w-title { font-family: var(--font-family-heading); font-size: var(--font-size-3xl); font-weight: var(--font-weight-light); color: var(--color-text-heading); letter-spacing: -0.02em; margin: 0 0 var(--spacing-3); line-height: 1.3; }
  .w-meta { font-family: var(--font-family-mono); font-size: 12px; color: var(--color-text-tertiary); }

  .w-body { font-family: var(--font-family-body); font-size: 16px; color: var(--color-text-primary); line-height: 1.85; letter-spacing: 0.005em; }
  .w-body :global(h2) { font-family: var(--font-family-heading); font-size: 1.3rem; font-weight: var(--font-weight-normal); color: var(--color-text-heading); margin: var(--spacing-8) 0 var(--spacing-3); }
  .w-body :global(h3) { font-family: var(--font-family-heading); font-size: 1.1rem; color: var(--color-text-heading); margin: var(--spacing-6) 0 var(--spacing-2); }
  .w-body :global(p) { margin: 0 0 var(--spacing-5); }
  .w-body :global(blockquote) { margin: var(--spacing-5) 0; padding-left: var(--spacing-4); border-left: 2px solid var(--color-gold-dust); color: var(--color-text-secondary); font-style: italic; }
  .w-body :global(ul), .w-body :global(ol) { padding-left: var(--spacing-6); margin: 0 0 var(--spacing-5); }
  .w-body :global(li) { margin: 0 0 var(--spacing-2); }
  .w-body :global(a) { color: var(--color-primary-dark); text-decoration: underline; text-underline-offset: 2px; }
  .w-body :global(code) { font-family: var(--font-family-mono); font-size: 0.9em; background: var(--color-surface-soft); padding: 1px 5px; border-radius: 2px; }

  .w-sign { margin-top: var(--spacing-12); padding-top: var(--spacing-5); border-top: 1px solid var(--color-border-divider); display: flex; align-items: center; gap: var(--spacing-3); }
  .sign-mark { color: var(--color-gold-dust); font-size: 11px; }
  .w-sign span { font-family: var(--font-family-mono); font-size: 12px; color: var(--color-text-tertiary); }
  .more-link { margin-left: auto; font-family: var(--font-family-ui); font-size: 12px; color: var(--color-primary-dark); text-decoration: none !important; border-bottom: 1px solid var(--color-border-divider) !important; padding-bottom: 2px; }

  @media (max-width: 680px) {
    .w-title { font-size: 1.6rem; }
    .w-body { font-size: 15px; }
  }
</style>
