---
import Layout from '../../layouts/Layout.astro';
import Stamp from '../../components/Stamp.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('writing', ({ data }) => !data.draft);
  return all.map(w => ({ params: { slug: w.id }, props: { w } }));
}

const { w } = Astro.props;
const { Content } = await w.render();
const dateStr = w.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title={`${w.data.title} · wo/men in tech`}
  description={w.data.excerpt || w.data.title}
  width='reading'
  type='article'
  ogImage={w.data.cover}
  publishedTime={w.data.pubDate.toISOString()}
>
  {(w.data.draft || w.data.comingSoon) && <meta name='robots' content='noindex' />}
  <div class='page-container'>
    <a href='/writing' class='btn btn--ghost'>
      <span lang='zh-CN'>← 返回田野手记</span>
      <span lang='en'>← Back to writing</span>
    </a>

    <header class='w-head'>
      {w.data.subject && <span class='w-subject'>{w.data.subject}</span>}
      <h1 class='w-title'>{w.data.title}</h1>
      <div class='w-meta'>
        <span>{dateStr}</span>
        <span>· by Dai Min</span>
      </div>
    </header>

    {/* 受访者信息 + 品牌链接（每人不同，无固定模板） */}
    {w.data.interviewee && (
      <aside class='interviewee'>
        {w.data.interviewee.cover && <img class='interviewee-cover' src={w.data.interviewee.cover} alt={w.data.interviewee.name} loading='lazy' />}
        <div class='interviewee-info'>
          <span class='interviewee-name'>{w.data.interviewee.name}</span>
          {w.data.interviewee.role && <span class='interviewee-role'>{w.data.interviewee.role}</span>}
          {w.data.interviewee.brand && <span class='interviewee-brand'>{w.data.interviewee.brand}</span>}
          {w.data.interviewee.location && <span class='interviewee-loc'>{w.data.interviewee.location}</span>}
          {w.data.interviewee.links && w.data.interviewee.links.length > 0 && (
            <div class='interviewee-links'>
              {w.data.interviewee.links.map(l => (
                <a class='interviewee-link' href={l.url} target='_blank' rel='noopener'>{l.label} ↗</a>
              ))}
            </div>
          )}
        </div>
      </aside>
    )}

    <article class='w-body'>
      <Content />
    </article>

    <footer class='w-sign'>
      <span class='sign-mark' aria-hidden='true'><Stamp /></span>
      <span>by Dai Min</span>
      <a href='/writing' class='more-link'>更多手记 →</a>
    </footer>
  </div>
</Layout>

<style>
  .page-container { padding: var(--spacing-6) 0 var(--spacing-20); max-width: 42rem; margin: 0 auto; }

  .w-head { margin-bottom: var(--spacing-10); padding-bottom: var(--spacing-6); border-bottom: 1px solid var(--color-border-divider); }
  .w-subject { display: block; font-family: var(--font-family-mono); font-size: 11px; color: var(--color-gold-dust); letter-spacing: 0.1em; margin-bottom: var(--spacing-2); }
  .w-title { font-family: var(--font-family-heading); font-size: var(--font-size-3xl); font-weight: var(--font-weight-light); color: var(--color-text-heading); letter-spacing: -0.02em; margin: 0 0 var(--spacing-3); line-height: 1.3; }
  .w-meta { font-family: var(--font-family-mono); font-size: 12px; color: var(--color-text-tertiary); }

  /* 受访者卡 */
  .interviewee { display: flex; gap: var(--spacing-4); padding: var(--spacing-4) var(--spacing-5); background: var(--color-surface-soft); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-xs); margin-bottom: var(--spacing-8); align-items: flex-start; }
  .interviewee-cover { width: 64px; height: 64px; object-fit: cover; border-radius: var(--radius-xs); flex-shrink: 0; }
  .interviewee-info { display: flex; flex-direction: column; gap: 2px; }
  .interviewee-name { font-family: var(--font-family-heading); font-size: 1rem; font-weight: var(--font-weight-medium); color: var(--color-text-heading); }
  .interviewee-role { font-family: var(--font-family-mono); font-size: 11px; color: var(--color-gold-dust); letter-spacing: 0.04em; }
  .interviewee-brand { font-family: var(--font-family-body); font-size: 12.5px; color: var(--color-text-primary); }
  .interviewee-loc { font-family: var(--font-family-mono); font-size: 11px; color: var(--color-text-tertiary); }
  .interviewee-links { display: flex; gap: var(--spacing-3); margin-top: var(--spacing-2); flex-wrap: wrap; }
  .interviewee-link { font-family: var(--font-family-ui); font-size: 11px; color: var(--color-text-primary); text-decoration: none !important; border-bottom: 1px solid var(--color-border-divider) !important; padding-bottom: 1px; transition: border-color var(--transition-fast); }
  .interviewee-link:hover { border-bottom-color: var(--color-gold-dust) !important; }

  .w-body { font-family: var(--font-family-body); font-size: 16px; color: var(--color-text-primary); line-height: 1.85; letter-spacing: 0.005em; }
  .w-body :global(h2) { font-family: var(--font-family-heading); font-size: 1.3rem; font-weight: var(--font-weight-normal); color: var(--color-text-heading); margin: var(--spacing-8) 0 var(--spacing-3); }
  .w-body :global(h3) { font-family: var(--font-family-heading); font-size: 1.1rem; color: var(--color-text-heading); margin: var(--spacing-6) 0 var(--spacing-2); }
  .w-body :global(p) { margin: 0 0 var(--spacing-5); }
  .w-body :global(blockquote) { margin: var(--spacing-5) 0; padding-left: var(--spacing-4); border-left: 1px solid var(--color-gold-dust); color: var(--color-text-secondary); font-style: italic; }
  .w-body :global(ul), .w-body :global(ol) { padding-left: var(--spacing-6); margin: 0 0 var(--spacing-5); }
  .w-body :global(li) { margin: 0 0 var(--spacing-2); }
  .w-body :global(a) { color: var(--color-text-primary); text-decoration: underline; text-underline-offset: 2px; }
  .w-body :global(code) { font-family: var(--font-family-mono); font-size: 0.9em; background: var(--color-surface-soft); padding: 1px 5px; border-radius: var(--radius-xs); }

  .w-sign { margin-top: var(--spacing-12); padding-top: var(--spacing-5); border-top: 1px solid var(--color-border-divider); display: flex; align-items: center; gap: var(--spacing-3); }
  .sign-mark { color: var(--color-gold-dust); font-size: 11px; }
  .w-sign span { font-family: var(--font-family-mono); font-size: 12px; color: var(--color-text-tertiary); }
  .more-link { margin-left: auto; font-family: var(--font-family-ui); font-size: 12px; color: var(--color-text-primary); text-decoration: none !important; border-bottom: 1px solid var(--color-border-divider) !important; padding-bottom: 2px; }

  @media (max-width: 680px) {
    .w-title { font-size: 1.6rem; }
    .w-body { font-size: 15px; }
  }
</style>
