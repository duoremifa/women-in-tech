---
import Layout from '../layouts/Layout.astro';
import CalendarAdd from '../components/CalendarAdd.astro';
import { getGatheringById, GATHERINGS } from '../data/gatherings';
---

<Layout
  title='我想参与 · Join · wo/men in tech'
  description='加入 wo/men in tech——以个体之名做事的女性。一次加入，长期订阅。'
  width='reading'
>
  <div class='page-container'>
    <header class='page-header'>
      <span class='section-eyebrow'>JOIN THE CIRCLE</span>
      <div lang='zh-CN' class='lang-zh'>
        <h1 class='page-title'>我想参与</h1>
        <p class='page-lead'>在快与喧嚣里，留一个安静的座位——<br />如果你在找这样的场域，欢迎留下声音。</p>
        <a href='/ethos' class='ctx-link'><span class='lang-zh'>先看看态度 →</span></a>
      </div>
      <div lang='en' class='lang-en'>
        <h1 class='page-title'>I want in</h1>
        <p class='page-lead'>A quiet seat amid speed and noise—<br />if this resonates, leave a note.</p>
        <a href='/ethos' class='ctx-link'><span class='lang-en'>Read our stance first →</span></a>
      </div>
      <div class='gold-hairline'></div>
    </header>

    {/* slot banner（从 /upcoming "我要这一期" 带来） */}
    <div id='slot-banner' class='slot-banner' hidden>
      <span class='slot-eyebrow'>已选这一期 · CHOSEN SLOT</span>
      <h2 id='slot-title' class='slot-title'></h2>
      <p id='slot-meta' class='slot-meta'></p>
      <a id='slot-ics' class='slot-ics-link' href='#' download>
        <span lang='zh-CN' class='lang-zh'>下载该期 .ics ↗</span>
        <span lang='en' class='lang-en'>Download slot .ics ↗</span>
      </a>
    </div>

    <div class='form-card-container'>
      <form id='circle-join-form' class='quiet-form'>
        <input type='text' name='_hp' value='' tabindex='-1' autocomplete='off' aria-label='请勿填写 / Leave this field empty' style='position:absolute;opacity:0;pointer-events:none;left:-9999px;width:1px;height:1px;' />

        {/* 字段 1: 称呼（始终需要） */}
        <div class='form-field'>
          <label class='field-label' for='join-name'>
            <span lang='zh-CN' class='lang-zh'>如何称呼你</span>
            <span lang='en' class='lang-en'>What should we call you</span>
            <span lang='zh-CN' class='field-hint lang-zh'>名字或习惯的称呼</span>
            <span lang='en' class='field-hint lang-en'>Name or preferred moniker</span>
          </label>
          <input type='text' id='join-name' name='name' placeholder='例如：Erin 或你习惯的称呼' data-placeholder-zh='例如：Erin 或你习惯的称呼' data-placeholder-en='e.g., Erin or your preferred moniker' required autocomplete='off' />
        </div>

        {/* 字段 2: 从事领域（slot 模式下隐藏） */}
        <div class='form-field craft-field'>
          <span class='field-label' id='join-craft-label'>
            <span lang='zh-CN' class='lang-zh'>你在从事的领域</span>
            <span lang='en' class='lang-en'>Your Primary Craft</span>
            <span lang='zh-CN' class='field-hint lang-zh'>单选 · 用于安排同频交流</span>
            <span lang='en' class='field-hint lang-en'>Single choice</span>
          </span>
          <div class='quiet-check-list' role='radiogroup' aria-labelledby='join-craft-label'>
            <label class='quiet-check-row is-radio'><input type='radio' name='craft' value='design' checked /><span class='check-indicator' aria-hidden='true'></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>设计 · 视觉传达 / 交互体验 (IxD)</span><span lang='en' class='check-title lang-en'>Design · Interaction & Visual Craft</span></div></label>
            <label class='quiet-check-row is-radio'><input type='radio' name='craft' value='product' /><span class='check-indicator' aria-hidden='true'></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>产品 · 商业逻辑 / 独立孵化 (PM)</span><span lang='en' class='check-title lang-en'>Product · Strategy & Independent Work</span></div></label>
            <label class='quiet-check-row is-radio'><input type='radio' name='craft' value='engineering' /><span class='check-indicator' aria-hidden='true'></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>工程 · 前端架构 / 独立全栈 (FE)</span><span lang='en' class='check-title lang-en'>Engineering · Frontend & Systems</span></div></label>
            <label class='quiet-check-row is-radio'><input type='radio' name='craft' value='research' /><span class='check-indicator' aria-hidden='true'></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>研究 · 用户洞察 / 写作</span><span lang='en' class='check-title lang-en'>Research · Inquiry & Writing</span></div></label>
            <label class='quiet-check-row is-radio'><input type='radio' name='craft' value='other' /><span class='check-indicator' aria-hidden='true'></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>其他创造性领域</span><span lang='en' class='check-title lang-en'>Other creative pursuits</span></div></label>
          </div>
        </div>

        {/* 字段 3: 感兴趣的活动（slot 模式下隐藏） */}
        <div class='form-field interests-field'>
          <span class='field-label' id='join-interests-label'>
            <span lang='zh-CN' class='lang-zh'>想参与的活动形式</span>
            <span lang='en' class='lang-en'>Gatherings of Interest</span>
            <span lang='zh-CN' class='field-hint lang-zh'>多选 · 可全选</span>
            <span lang='en' class='field-hint lang-en'>Multiple choice</span>
          </span>
          <div class='quiet-check-list' role='group' aria-labelledby='join-interests-label'>
            <label class='quiet-check-row'><input type='checkbox' name='interests' value='coffee_chat' checked /><span class='check-indicator' aria-hidden='true'><svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>Coffee Chat</span><span lang='en' class='check-title lang-en'>Coffee Chat</span><span lang='zh-CN' class='check-note lang-zh'>双周轻聚 · 低压真诚</span><span lang='en' class='check-note lang-en'>Biweekly · low pressure</span></div></label>
            <label class='quiet-check-row'><input type='checkbox' name='interests' value='english_chat' checked /><span class='check-indicator' aria-hidden='true'><svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>English Tech & Design Chat</span><span lang='en' class='check-title lang-en'>English Tech & Design Chat</span><span lang='zh-CN' class='check-note lang-zh'>双周线上 · Show & Tell</span><span lang='en' class='check-note lang-en'>Biweekly online · Show & Tell</span></div></label>
            <label class='quiet-check-row'><input type='checkbox' name='interests' value='portfolio_building' /><span class='check-indicator' aria-hidden='true'><svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>作品 Lab · 慢工出细活</span><span lang='en' class='check-title lang-en'>Craft Lab</span><span lang='zh-CN' class='check-note lang-zh'>经验互借 · 代表作打磨</span><span lang='en' class='check-note lang-en'>Patient iteration on signature work</span></div></label>
          </div>
        </div>

        {/* 字段 4: 正在琢磨的事（slot 模式下隐藏） */}
        <div class='form-field idea-field'>
          <label class='field-label' for='join-idea'>
            <span lang='zh-CN' class='lang-zh'>正在做的事，或想交流的话题</span>
            <span lang='en' class='lang-en'>Current projects or topics</span>
            <span lang='zh-CN' class='field-hint lang-zh'>可留空</span>
            <span lang='en' class='field-hint lang-en'>Optional</span>
          </label>
          <textarea id='join-idea' name='idea' rows='3' placeholder='例如：正在构思一个极简独立工具，想找设计师伙伴交流……' data-placeholder-zh='例如：正在构思一个极简独立工具，想找设计师伙伴交流……' data-placeholder-en='e.g., Working on a minimal side tool, looking for design feedback...'></textarea>
        </div>

        {/* 字段 5: 联系方式（始终需要） */}
        <div class='form-field'>
          <label class='field-label' for='join-contact'>
            <span lang='zh-CN' class='lang-zh'>联系方式</span>
            <span lang='en' class='lang-en'>Contact</span>
            <span lang='zh-CN' class='field-hint lang-zh'>微信或邮箱 · 仅用于活动邀请</span>
            <span lang='en' class='field-hint lang-en'>WeChat or Email · for invites only</span>
          </label>
          <input type='text' id='join-contact' name='contact' placeholder='微信号或 Email' data-placeholder-zh='微信号或 Email' data-placeholder-en='WeChat ID or Email' required autocomplete='off' />
        </div>

        {/* 订阅区（替代一次性 RSVP） */}
        <div class='form-field subscribe-field'>
          <span class='field-label'>
            <span lang='zh-CN' class='lang-zh'>订阅偏好</span>
            <span lang='en' class='lang-en'>Subscription</span>
            <span lang='zh-CN' class='field-hint lang-zh'>一次加入 = 长期订阅</span>
            <span lang='en' class='field-hint lang-en'>One join = lasting subscription</span>
          </span>
          <div class='cal-add-wrap'>
            <CalendarAdd />
          </div>
          <div class='quiet-check-list'>
            <label class='quiet-check-row'><input type='checkbox' name='subscribe_calendar' value='1' checked /><span class='check-indicator' aria-hidden='true'><svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>自动同步全部排期</span><span lang='en' class='check-title lang-en'>Auto-sync all slots</span><span lang='zh-CN' class='check-note lang-zh'>用上方按钮把日历源加到我的日历 App</span><span lang='en' class='check-note lang-en'>Use the button above to add the feed to your calendar</span></div></label>
            <label class='quiet-check-row'><input type='checkbox' name='subscribe_email' value='1' checked /><span class='check-indicator' aria-hidden='true'><svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>新排期上线时邮件提醒我</span><span lang='en' class='check-title lang-en'>Email me on new slots</span><span lang='zh-CN' class='check-note lang-zh'>低频，仅新排期上线时</span><span lang='en' class='check-note lang-en'>Low-frequency, only on new schedule</span></div></label>
            <label class='quiet-check-row'><input type='checkbox' name='one_time' value='1' /><span class='check-indicator' aria-hidden='true'><svg viewBox='0 0 12 12' fill='none'><path d='M2.5 6L5 8.5L9.5 3.5'/></svg></span><div class='check-content'><span lang='zh-CN' class='check-title lang-zh'>仅本次预约，不订阅</span><span lang='en' class='check-title lang-en'>One-time only, no subscription</span></div></label>
          </div>
        </div>

        <div class='submit-zone'>
          <button type='submit' class='submit-btn-primary' id='submit-trigger'>
            <span lang='zh-CN' class='lang-zh'>我想参与</span>
            <span lang='en' class='lang-en'>I want in</span>
            <span class='btn-arrow' aria-hidden='true'>⟶</span>
          </button>
          <div class='privacy-assurance-pill'>
            <span class='privacy-dot' aria-hidden='true'>✦</span>
            <span lang='zh-CN' class='privacy-text lang-zh'>随时可退订 · 零商业营销</span>
            <span lang='en' class='privacy-text lang-en'>Unsubscribe anytime · Zero marketing</span>
          </div>
        </div>

        {/* 回执 */}
        <div id='join-feedback' class='feedback-receipt' role='status' aria-live='polite' aria-atomic='true' style='display: none;'>
          <div class='receipt-card'>
            <div class='receipt-header'>
              <span class='receipt-mark' aria-hidden='true'>✦</span>
              <div>
                <h3 lang='zh-CN' class='receipt-title lang-zh'>已记录</h3>
                <h3 lang='en' class='receipt-title lang-en'>Received</h3>
                <span class='receipt-id' id='receipt-id-display'>回执编号: WT-PENDING</span>
              </div>
            </div>
            <div class='receipt-desc-box'>
              <p lang='zh-CN' class='receipt-desc lang-zh' id='join-note-text'>感谢你的加入。意向已收录入社群档案。</p>
              <p lang='en' class='receipt-desc lang-en' id='join-note-text-en'>Thank you for reaching out. Your note has been saved.</p>
            </div>
            <div class='receipt-loop'>
              <a id='receipt-ics' class='btn-download-ics' href='#' download hidden>
                <span lang='zh-CN' class='lang-zh'>下载 .ics ↗</span>
                <span lang='en' class='lang-en'>Download .ics ↗</span>
              </a>
              <div class='wechat-field-card'>
                <span class='wechat-label-caption' lang='zh-CN'>微信</span>
                <code class='wechat-handle'>daiminay</code>
                <button type='button' class='btn-copy-hairline' id='join-btn-copy-wechat' data-wechat='daiminay'>
                  <span lang='zh-CN' class='copy-text lang-zh'>复制</span>
                  <span lang='en' class='copy-text lang-en'>Copy</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>

    {/* FAQ（精简） */}
    <section class='join-faq-section'>
      <div class='faq-card'>
        <h3 lang='zh-CN' class='lang-zh'>几个常被问到</h3>
        <h3 lang='en' class='lang-en'>A few questions</h3>
        <div lang='zh-CN' class='faq-grid lang-zh'>
          <div class='faq-item'><h4>收费吗？</h4><p>纯公益，无任何费用。线下各自点单，线上完全免费。</p></div>
          <div class='faq-item'><h4>没成型代表作？</h4><p>完全可以。一个萌芽的念头、一段没想清楚的事，本身就值得被听见。</p></div>
        </div>
        <div lang='en' class='faq-grid lang-en'>
          <div class='faq-item'><h4>Fees?</h4><p>Zero. Offline: own drinks. Online: free.</p></div>
          <div class='faq-item'><h4>No finished work?</h4><p>Absolutely fine. A budding thought is enough.</p></div>
        </div>
      </div>
    </section>

    <section class='next-steps'>
      <div class='next-card'>
        <div lang='zh-CN' class='next-text lang-zh'><h3>再多看看</h3><p>看看日常，或回到首页。</p></div>
        <div lang='en' class='next-text lang-en'><h3>Explore more</h3><p>See the everyday, or head home.</p></div>
        <div class='next-actions'>
          <a href='/events' class='btn-link-gold'><span lang='zh-CN' class='lang-zh'>看看日常</span><span lang='en' class='lang-en'>Everyday</span></a>
          <a href='/' class='btn-solid-dark'><span lang='zh-CN' class='lang-zh'>返回首页</span><span lang='en' class='lang-en'>Home</span></a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { generateICS, WECHAT_HANDLE } from '../lib/join-shared';
  import { getGatheringById } from '../data/gatherings';

  // 注：getGatheringById 在客户端是 build 期数据，仅用于读 title/date 显示 banner。
  // 服务端校验仍以 functions/api/join.ts 为准。

  function setupJoinPageForm() {
    const form = document.getElementById('circle-join-form') as HTMLFormElement | null;
    const feedback = document.getElementById('join-feedback');
    const submitBtn = document.getElementById('submit-trigger');
    const receiptIdDisplay = document.getElementById('receipt-id-display');
    const receiptIcs = document.getElementById('receipt-ics') as HTMLAnchorElement | null;
    const copyWechatBtn = document.getElementById('join-btn-copy-wechat');

    let currentIcsData = '';
    let currentSubId = '';
    let activeSlotId = '';

    function syncPlaceholders() {
      const isEn = document.documentElement.getAttribute('data-lang') === 'en';
      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-placeholder-zh]').forEach(el => {
        el.placeholder = isEn ? (el.dataset.placeholderEn || '') : (el.dataset.placeholderZh || '');
      });
    }
    syncPlaceholders();
    if (!(window as any).__wotech_join_lang_bound) {
      (window as any).__wotech_join_lang_bound = true;
      window.addEventListener('site-language-change', syncPlaceholders);
    }

    // ── slot banner：从 /upcoming "我要这一期" 带 ?slot=<id> ──
    try {
      const params = new URLSearchParams(window.location.search);
      const slotId = params.get('slot');
      const workSlug = params.get('work');
      const source = params.get('source');
      const interestParam = params.get('interest');

      if (slotId) {
        const g = getGatheringById(slotId);
        if (g) {
          activeSlotId = slotId;
          const banner = document.getElementById('slot-banner');
          const titleEl = document.getElementById('slot-title');
          const metaEl = document.getElementById('slot-meta');
          const icsLink = document.getElementById('slot-ics') as HTMLAnchorElement | null;
          if (banner && titleEl && metaEl && icsLink) {
            const isEn = document.documentElement.getAttribute('data-lang') === 'en';
            titleEl.textContent = isEn ? g.titleEn : g.titleZh;
            const date = new Date(g.startIso).toLocaleString(isEn ? 'en-US' : 'zh-CN', { month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
            metaEl.textContent = `${date} GMT+8 · ${g.location.type === 'VirtualLocation' ? (isEn ? 'Online' : '线上') : (isEn ? 'Hangzhou + Online' : '杭州 + 线上')}`;
            icsLink.href = `/gatherings/${g.id}.ics`;
            banner.hidden = false;
            // slot 模式：隐藏 craft/interests/idea（slot 已隐含兴趣）
            document.querySelector('.craft-field')?.setAttribute('hidden', '');
            document.querySelector('.interests-field')?.setAttribute('hidden', '');
            document.querySelector('.idea-field')?.setAttribute('hidden', '');
          }
        }
      } else if (interestParam) {
        // ?interest=portfolio_building 等仍走原逻辑（预勾选）
        const cb = Array.from(form?.querySelectorAll<HTMLInputElement>("input[name='interests']") || [])
          .find(el => el.value === interestParam || (interestParam === 'portfolio_building' && el.value === 'portfolio_building'));
        if (cb) {
          (form?.querySelectorAll<HTMLInputElement>("input[name='interests']") || []).forEach(el => { el.checked = false; });
          cb.checked = true;
        }
      }

      if (workSlug) {
        const idea = document.getElementById('join-idea') as HTMLTextAreaElement | null;
        const isEn = document.documentElement.getAttribute('data-lang') === 'en';
        if (idea) idea.value = isEn ? `I am interested in co-building: ${workSlug}` : `想参与《${workSlug}》的共建打磨，我的专长可以贡献在……`;
      }
      if (source) { /* 记录来源，submit 时带上 */ }
    } catch (e) {}

    // ── copy wechat ──
    if (copyWechatBtn) {
      copyWechatBtn.onclick = async () => {
        try {
          await navigator.clipboard.writeText(WECHAT_HANDLE);
          const spans = copyWechatBtn.querySelectorAll<HTMLElement>('.copy-text');
          const originals: string[] = [];
          spans.forEach((s, i) => { originals[i] = s.textContent || ''; s.textContent = i === 0 ? '✓ 已复制' : '✓ Copied'; });
          setTimeout(() => { spans.forEach((s, i) => { s.textContent = originals[i]; }); }, 2500);
        } catch (e) {}
      };
    }

    const formMountTime = Date.now();
    if (form && feedback) {
      form.onsubmit = async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const name = String(formData.get('name') || '');
        const craft = String(formData.get('craft') || '');
        const interests = formData.getAll('interests').map(String);
        const idea = String(formData.get('idea') || '');
        const contact = String(formData.get('contact') || '').trim();
        const hpVal = String(formData.get('_hp') || '');
        const subscribeCalendar = formData.get('subscribe_calendar') === '1';
        const subscribeEmail = formData.get('subscribe_email') === '1';
        const oneTime = formData.get('one_time') === '1';

        const payload = {
          name, craft, interests, idea, contact,
          _hp: hpVal, _t: formMountTime,
          slot_id: activeSlotId || undefined,
          subscribe_calendar: subscribeCalendar,
          subscribe_email: subscribeEmail,
          one_time: oneTime,
          source: new URLSearchParams(window.location.search).get('source') || undefined,
          clientTimestamp: new Date().toISOString(),
        };

        try { sessionStorage.setItem('wotech_rsvp_sent', '1'); } catch (err) {}

        let subId = `WT-${Date.now().toString(36).slice(-5).toUpperCase()}`;
        currentSubId = subId;
        const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contact);
        let emailSent = false;
        let apiFailed = false;

        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.setAttribute('aria-busy', 'true');
          submitBtn.classList.add('is-loading');
          // 标签换"送出中/Sending…"（btn-arrow 由 CSS 隐藏）
          const zhSpan = submitBtn.querySelector('.lang-zh');
          const enSpan = submitBtn.querySelector('.lang-en');
          if (zhSpan) { (submitBtn as any)._origZh = zhSpan.textContent; zhSpan.textContent = '送出中'; }
          if (enSpan) { (submitBtn as any)._origEn = enSpan.textContent; enSpan.textContent = 'Sending…'; }
        }
        try {
          const ctrl = new AbortController();
          const timer = setTimeout(() => ctrl.abort(), 15000);
          const res = await fetch('/api/join', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal: ctrl.signal,
          });
          clearTimeout(timer);
          if (res.ok) {
            const resData = await res.json();
            if (resData.submissionId) { subId = resData.submissionId; currentSubId = subId; }
            if (resData.emailSent !== undefined) emailSent = resData.emailSent;
          }
        } catch (err) { apiFailed = true; }
        finally {
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.removeAttribute('aria-busy');
            submitBtn.classList.remove('is-loading');
            const zhSpan = submitBtn.querySelector('.lang-zh');
            const enSpan = submitBtn.querySelector('.lang-en');
            if (zhSpan && (submitBtn as any)._origZh != null) zhSpan.textContent = (submitBtn as any)._origZh;
            if (enSpan && (submitBtn as any)._origEn != null) enSpan.textContent = (submitBtn as any)._origEn;
          }
        }

        if (apiFailed) {
          const isEn = document.documentElement.getAttribute('data-lang') === 'en';
          const noteZh = document.getElementById('join-note-text');
          const noteEn = document.getElementById('join-note-text-en');
          if (noteZh) noteZh.textContent = '网络异常，意向暂未送达。请稍后重试，或直接加微信 ' + WECHAT_HANDLE + ' 联系。';
          if (noteEn) noteEn.textContent = 'Network error—please retry shortly, or connect via WeChat at ' + WECHAT_HANDLE + '.';
          if (receiptIdDisplay) receiptIdDisplay.textContent = isEn ? 'Receipt pending (offline)' : '回执待补（离线）';
          currentIcsData = activeSlotId ? '' : generateICS(subId, name, interests);
          if (feedback) { feedback.style.display = 'block'; requestAnimationFrame(() => feedback.classList.add('is-revealed')); feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
          return;
        }

        // .ics：slot 模式直链静态文件；否则本地兜底生成
        if (activeSlotId && receiptIcs) {
          receiptIcs.href = `/gatherings/${activeSlotId}.ics`;
          receiptIcs.hidden = false;
        } else if (!activeSlotId && receiptIcs) {
          currentIcsData = generateICS(subId, name, interests);
          receiptIcs.href = '#';
          receiptIcs.hidden = false;
          receiptIcs.onclick = (ev) => {
            ev.preventDefault();
            if (!currentIcsData) return;
            const blob = new Blob([currentIcsData], { type: 'text/calendar;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `wotech-gathering-${currentSubId || 'invite'}.ics`;
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            URL.revokeObjectURL(url);
          };
        }

        const isEn = document.documentElement.getAttribute('data-lang') === 'en';
        if (receiptIdDisplay) receiptIdDisplay.textContent = isEn ? `Receipt ID: #${subId}` : `回执编号: #${subId}`;

        const noteZh = document.getElementById('join-note-text');
        const noteEn = document.getElementById('join-note-text-en');
        const subscribed = subscribeCalendar || subscribeEmail;
        if (subscribed) {
          if (noteZh) noteZh.textContent = subscribeCalendar ? '已为你打开日历订阅，点上方"添加到我的日历"把日历源加到你的日历 App。' : '已记录邮件订阅，新排期上线时会低频提醒。';
          if (noteEn) noteEn.textContent = subscribeCalendar ? 'Calendar subscription enabled—tap "Add to my calendar" above to add it to your calendar app.' : 'Email subscription recorded; low-frequency notices on new slots.';
        } else if (isEmail && emailSent) {
          if (noteZh) noteZh.textContent = '已向你的邮箱 ' + contact + ' 发送确认信与 .ics 日历邀请。';
          if (noteEn) noteEn.textContent = 'A confirmation & .ics invite dispatched to ' + contact + '.';
        } else if (isEmail && !emailSent) {
          if (noteZh) noteZh.textContent = '邮箱已记录，确认信暂未发出。可下载 .ics 或加微信 ' + WECHAT_HANDLE + '。';
          if (noteEn) noteEn.textContent = 'Email recorded; confirmation pending. Download .ics or connect via WeChat ' + WECHAT_HANDLE + '.';
        } else {
          if (noteZh) noteZh.textContent = '意向已记录。可下载 .ics 或加微信 ' + WECHAT_HANDLE + ' 随时交流。';
          if (noteEn) noteEn.textContent = 'Recorded. Download .ics or connect via WeChat ' + WECHAT_HANDLE + '.';
        }

        // 表单字段 fade out（240ms），不再 display:none 硬切
        const fadeEls = form.querySelectorAll<HTMLElement>('.form-field, .submit-zone');
        fadeEls.forEach(el => {
          el.style.transition = 'opacity 240ms cubic-bezier(0.22, 1, 0.36, 1)';
          el.style.opacity = '0';
        });
        window.setTimeout(() => { fadeEls.forEach(el => { el.style.display = 'none'; }); }, 260);

        feedback.style.display = 'block';
        requestAnimationFrame(() => feedback.classList.add('is-revealed'));
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      };
    }
  }

  document.addEventListener('astro:page-load', setupJoinPageForm);
</script>

