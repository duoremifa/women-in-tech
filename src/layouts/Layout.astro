---
// src/layouts/Layout.astro - 全局布局框架
// 职责：页面骨架、导航、主题、SEO、PWA、系统初始化、字体预加载
// 已完成分步优化：ReadingProgress、Favicon、系统初始化、PWA注册、FontPreload
// ============================================

// ============================================
// 导入依赖
// ============================================
import { ViewTransitions } from 'astro:transitions';

// 全局样式
import '../styles/main.css';
import '../styles/markdown.css';

// 组件
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

import PageHeader from '../components/PageHeader.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import FontPreload from '../components/FontPreload.astro';

// 注意：utils（monitoring/geometricSystem/fontManager）与 scripts（init/pwa/theme）
// 必须在客户端 <script> 内 import 才会真正执行——frontmatter 的 import 仅构建期运行，
// 不产生客户端 JS。见 <body> 底部统一初始化脚本。

// ============================================
// Props 接口
// ============================================
export interface Props {
  title?: string;
  description?: string;
  width?: 'narrow' | 'reading' | 'standard' | 'wide' | 'full' | 'prose';
  header?: any; // 使用any类型避免ComponentProps错误
  ogImage?: string; // 新增：支持页面特定的OG图
}

const {
  title = 'wo/men in tech · women in technical · "我们"',
  description = '既是女性，亦是“我们”的技术与创造联合体。面向产品经理 (PM)、交互设计师 (IxD) 与前端工程师 (FE) 的互助、交流与作品共建空间。相互成就。',
  width = 'full',
  header,
  ogImage,
} = Astro.props;

// ============================================
// 布局配置
// ============================================
const isProse = width === 'prose';
const layoutMode = isProse ? 'reading' : width;
const containerClass = layoutMode !== 'full' ? `layout-${layoutMode}` : '';
---

<!doctype html>
<html lang='zh-CN'>
  <head>
    <script is:inline>
      (function() {
        try {
          const storedLang = localStorage.getItem('site_lang') || 'zh';
          document.documentElement.setAttribute('data-lang', storedLang);
          document.documentElement.lang = storedLang === 'en' ? 'en' : 'zh-CN';
        } catch (e) {}
      })();
    </script>
    <!-- 提前应用主题，消除深色模式 FOUC（首屏前同步执行） -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'dark' && t !== 'light') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          var isDark = t === 'dark';
          var r = document.documentElement;
          r.classList.toggle('dark', isDark);
          r.classList.toggle('light', !isDark);
          r.style.backgroundImage = isDark
            ? 'var(--texture-paper-dark)'
            : 'var(--texture-paper-light)';
        } catch (e) {}
      })();
    </script>
    <!-- ===== SEO & 基础元数据 ===== -->
    <SEO title={title} description={description} ogImage={ogImage} />
    <ViewTransitions />
    <meta name='theme-color' content='#f7f5f0' media='(prefers-color-scheme: light)' />
    <meta name='theme-color' content='#151413' media='(prefers-color-scheme: dark)' />

    <!-- ===== 宁静品牌图标 ===== -->
    <!-- 标准 favicon -->
    <link rel='icon' type='image/x-icon' href='/favicon.ico?v=20260214' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg?v=20260214' />

    <!-- 苹果设备图标 -->
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />

    <!-- PWA 图标 -->
    <link rel='icon' type='image/png' sizes='32x32' href='/icons/icon-32.png' />
    <link rel='icon' type='image/png' sizes='16x16' href='/icons/icon-16.png' />
    <link rel='icon' type='image/png' sizes='192x192' href='/icons/icon-192.png' />
    <link rel='icon' type='image/png' sizes='512x512' href='/icons/icon-512.png' />

    <!-- ===== 字体预加载 ===== -->
    <FontPreload />
  </head>
  <body>
    <!-- ===== 键盘 / 屏幕阅读器跳转链接（首个可聚焦元素） ===== -->
    <a href='#main-content' class='skip-link sr-only'>
      <span lang='zh-CN' class='lang-zh'>跳到主要内容</span>
      <span lang='en' class='lang-en'>Skip to content</span>
    </a>

    <!-- ===== 导航区（持久化）===== -->
    <div transition:persist>
      <Navbar />
    </div>

    <!-- ===== 主要内容区 ===== -->
    <main
      id='main-content'
      tabindex='-1'
      class:list={[containerClass, { 'markdown-content': isProse }]}
      transition:animate='slide'
      transition:name='page'
    >
      {header && <PageHeader {...header} />}
      <slot />
    </main>

    <!-- ===== 页脚区 ===== -->
    <Footer />

    <!-- ===== 功能组件 ===== -->
    <ReadingProgress />

    <!-- ===== 统一客户端初始化（事件委托 + 集中管理）===== -->
    <script>
      // 主题、系统初始化、PWA 注册统一在此 import（客户端真正执行）
      import { applyStoredTheme, toggleTheme, applySystemTheme } from '../scripts/theme';
      import { initializeApp } from '../scripts/init';
      import { registerPWA } from '../scripts/pwa';

      // 跨页持久的全局监听只注册一次，杜绝 view-transition 切换后累积
      if (!(window as any).__wotech_bootstrap) {
        (window as any).__wotech_bootstrap = true;

        // 事件委托：主题切换按钮（全局，含 transition:persist 的 Navbar）
        document.addEventListener('click', e => {
          if (!e.target) return;
          const target = e.target as HTMLElement;
          const toggleBtn = target.closest('[data-theme-toggle]') as HTMLElement;
          if (!toggleBtn) return;
          try {
            toggleTheme();
            updateThemeIcon();
          } catch (error) {
            if (import.meta.env.DEV) console.error('Theme toggle error:', error);
          }
        });

        // 系统主题变化（仅当用户未显式选择时跟随）
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        mq.addEventListener('change', (e: MediaQueryListEvent) => {
          try {
            if (!localStorage.getItem('theme')) applySystemTheme(e.matches ? 'dark' : 'light');
          } catch (err) {
            if (import.meta.env.DEV) console.error('System theme apply error:', err);
          }
        });
      }

      // 更新主题图标显示
      function updateThemeIcon() {
        const isDark = document.documentElement.classList.contains('dark');
        document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach(btn => {
          const sunIcon = btn.querySelector('.sun-icon') as HTMLElement | null;
          const moonIcon = btn.querySelector('.moon-icon') as HTMLElement | null;
          if (sunIcon && moonIcon) {
            sunIcon.style.display = isDark ? 'none' : 'block';
            moonIcon.style.display = isDark ? 'block' : 'none';
          }
        });
      }

      // 统一初始化：主题 + 系统初始化 + PWA
      function initApp() {
        if (import.meta.env.DEV) console.log('🚀 initApp() called');
        try {
          applyStoredTheme();
          updateThemeIcon();
          initializeApp();
          registerPWA();
          if (import.meta.env.DEV) console.log('✅ initApp() completed successfully');
        } catch (error) {
          if (import.meta.env.DEV) console.error('❌ initApp() error:', error);
        }
      }

      // 首次加载
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }

      // Astro 视图切换后：重跑初始化 + 焦点落到新页 main（无障碍）
      document.addEventListener('astro:after-swap', () => {
        if (import.meta.env.DEV) console.log('🔄 astro:after-swap fired, reinitializing...');
        initApp();
        const main = document.getElementById('main-content');
        if (main) {
          main.setAttribute('tabindex', '-1');
          main.focus({ preventScroll: true });
        }
      });
    </script>
  </body>
</html>

<style>
  /* ===== 跳到主要内容（键盘 / 屏幕阅读器） ===== */
  .skip-link {
    position: fixed;
    top: var(--spacing-2);
    left: var(--spacing-2);
    z-index: 1000;
    transform: translateY(-150%);
    transition: transform var(--transition-fast);
    padding: var(--spacing-2) var(--spacing-4);
    background: var(--color-surface-pure);
    border: 1px solid var(--color-brand-purple, #5e4c7a);
    border-radius: var(--radius-xs);
    color: var(--color-brand-purple, #5e4c7a);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    text-decoration: none !important;
    box-shadow: 0 2px 8px -2px rgba(38, 34, 28, 0.12);
  }
  .skip-link:focus,
  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--color-brand-purple, #5e4c7a);
    outline-offset: 2px;
  }

  /* ===== 全局骨架样式 ===== */
  main {
    min-height: 60vh;
    background-color: var(--color-bg-page);
    padding-top: var(--spacing-8); /* 顶部留白（与导航间距） */
    padding-bottom: var(--spacing-20); /* 底部留白（与页脚间距） */
  }

  /* 深色模式适配（由变量自动处理，无需额外代码） */
</style>
