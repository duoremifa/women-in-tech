---
// src/layouts/Layout.astro - 全局布局框架
// 职责：页面骨架、导航、主题、SEO、PWA、系统初始化、字体预加载
// 已完成分步优化：ReadingProgress、Favicon、系统初始化、PWA注册、FontPreload
// ============================================

// ============================================
// 导入依赖
// ============================================
import { ViewTransitions } from 'astro:transitions';

// 全局样式
import '../styles/main.css';

// 组件
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

import ReadingProgress from '../components/ReadingProgress.astro';
import FontPreload from '../components/FontPreload.astro';

// 注意：utils（monitoring/geometricSystem）与 scripts（init/pwa/theme）
// 必须在客户端 <script> 内 import 才会真正执行——frontmatter 的 import 仅构建期运行，
// 不产生客户端 JS。见 <body> 底部统一初始化脚本。

// ============================================
// Props 接口
// ============================================
export interface Props {
  title?: string;
  description?: string;
  width?: 'reading' | 'full';
  ogImage?: string; // 页面特定的 OG 图
  type?: 'website' | 'article';
  publishedTime?: string; // ISO，type='article' 时发 article:published_time
  noindex?: boolean; // 透传 SEO，在 <head> 内输出 robots meta（页面 slot 里写无效）
}

const {
  title = 'wo/men in tech · women in technical',
  description = 'women in tech · 在杭州的巷子与山径之间，做经得起时间的事。',
  width = 'full',
  ogImage,
  type,
  publishedTime,
  noindex = false,
} = Astro.props;

// ============================================
// 布局配置
// ============================================
const containerClass = width !== 'full' ? `layout-${width}` : '';
---

<!doctype html>
<html lang='zh-CN'>
  <head>
    <script is:inline>
      (function() {
        try {
          const storedLang = localStorage.getItem('site_lang') || 'zh';
          document.documentElement.setAttribute('data-lang', storedLang);
          document.documentElement.lang = storedLang === 'en' ? 'en' : 'zh-CN';
        } catch (e) {}
      })();
    </script>
    <!-- 提前应用主题，消除深色模式 FOUC（首屏前同步执行）。
         html 与 body 用同一个 texture token + 同一个 bg-color，避免首屏白闪 + html 那层被 body 盖掉。 -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'dark' && t !== 'light') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          var isDark = t === 'dark';
          var r = document.documentElement;
          r.classList.toggle('dark', isDark);
          r.classList.toggle('light', !isDark);
          r.style.backgroundColor = isDark ? '#151413' : '#f7f5f0';
          r.style.backgroundImage = isDark
            ? 'var(--texture-paper-dark)'
            : 'var(--texture-paper)';
        } catch (e) {}
      })();
    </script>
    <!-- ===== SEO & 基础元数据 ===== -->
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      publishedTime={publishedTime}
      noindex={noindex}
    />
    <ViewTransitions />
    <!-- theme-color 跟随站点主题（class 轨），而非 OS prefers-color-scheme——
         用户手动切深色时地址栏/系统栏同步转暗；实际值由 theme.ts 按主题写回 -->
    <meta name='theme-color' id='theme-color-meta' content='#f7f5f0' />

    <!-- ===== 宁静品牌图标 ===== -->
    <!-- 标准 favicon -->
    <link rel='icon' type='image/x-icon' href='/favicon.ico?v=20260214' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg?v=20260214' />

    <!-- 苹果设备图标 -->
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />

    <!-- PWA 图标 -->
    <link rel='icon' type='image/png' sizes='32x32' href='/icons/icon-32.png' />
    <link rel='icon' type='image/png' sizes='16x16' href='/icons/icon-16.png' />
    <link rel='icon' type='image/png' sizes='192x192' href='/icons/icon-192.png' />
    <link rel='icon' type='image/png' sizes='512x512' href='/icons/icon-512.png' />

    <!-- ===== 字体预加载 ===== -->
    <FontPreload />
  </head>
  <body>
    <!-- ===== 键盘 / 屏幕阅读器跳转链接（首个可聚焦元素） ===== -->
    <a href='#main-content' class='skip-link sr-only'>
      <span lang='zh-CN' class='lang-zh'>跳到主要内容</span>
      <span lang='en' class='lang-en'>Skip to content</span>
    </a>

    <!-- ===== 导航区（首页隐藏，靠左侧侧栏定向；子页保留）===== -->
    {Astro.url.pathname !== '/' && (
      <div transition:persist>
        <Navbar />
      </div>
    )}

    <!-- ===== 主要内容区 ===== -->
    <main
      id='main-content'
      tabindex='-1'
      class:list={[containerClass]}
      transition:animate='slide'
      transition:name='page'
    >
      <slot />
    </main>

    <!-- ===== 页脚区 + 阅读进度（transition:persist，导航不再每次重挂）===== -->
    <div transition:persist>
      <Footer />
    </div>

    <!-- ===== 功能组件 ===== -->
    <div transition:persist>
      <ReadingProgress />
    </div>

    <!-- ===== 统一客户端初始化（事件委托 + 集中管理）===== -->
    <script>
      // 主题、系统初始化、PWA 注册统一在此 import（客户端真正执行）
      import { applyStoredTheme, toggleTheme, applySystemTheme } from '../scripts/theme';
      import { initializeApp } from '../scripts/init';
      import { registerPWA } from '../scripts/pwa';

      // 跨页持久的全局监听只注册一次，杜绝 view-transition 切换后累积
      if (!(window as any).__wotech_bootstrap) {
        (window as any).__wotech_bootstrap = true;

        // 事件委托：主题切换按钮（全局，含 transition:persist 的 Navbar）
        document.addEventListener('click', e => {
          if (!e.target) return;
          const target = e.target as HTMLElement;
          const toggleBtn = target.closest('[data-theme-toggle]') as HTMLElement;
          if (!toggleBtn) return;
          try {
            toggleTheme();
            updateThemeIcon();
          } catch (error) {
            if (import.meta.env.DEV) console.error('Theme toggle error:', error);
          }
        });

        // 事件委托：语言切换按钮（#quick-lang-btn）——cross-fade 320ms（不再硬切）
        // main 先淡出 140ms（opacity→0），swap data-lang，再淡入 180ms。
        document.addEventListener('click', e => {
          if (!e.target) return;
          const target = e.target as HTMLElement;
          const langBtn = target.closest('#quick-lang-btn') as HTMLElement | null;
          if (!langBtn) return;
          const current = document.documentElement.getAttribute('data-lang') || 'zh';
          const next = current === 'en' ? 'zh' : 'en';
          const main = document.getElementById('main-content');
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const applyLang = () => {
            document.documentElement.setAttribute('data-lang', next);
            document.documentElement.lang = next === 'en' ? 'en' : 'zh-CN';
            try { localStorage.setItem('site_lang', next); } catch (err) {}
            langBtn.setAttribute('aria-label', next === 'en' ? '切换到中文 / Switch to Chinese' : '切换到英文 / Switch to English');
            window.dispatchEvent(new CustomEvent('site-language-change', { detail: { lang: next } }));
          };
          if (reduce || !main) { applyLang(); return; }
          main.style.opacity = '0';
          window.setTimeout(() => {
            applyLang();
            main.style.opacity = '1';
          }, 200);
        });

        // view-transition 与 smooth-scroll 打架：swap 期间临时关 smooth
        document.addEventListener('astro:before-swap', () => {
          document.documentElement.classList.add('is-swapping');
        });

        // 系统主题变化（仅当用户未显式选择时跟随）
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        mq.addEventListener('change', (e: MediaQueryListEvent) => {
          try {
            if (!localStorage.getItem('theme')) applySystemTheme(e.matches ? 'dark' : 'light');
          } catch (err) {
            if (import.meta.env.DEV) console.error('System theme apply error:', err);
          }
        });
      }

      // 更新主题图标：toggle is-dark class，CSS 处理 sun/moon 交叉淡化 + rotate（不再 display 硬切）
      function updateThemeIcon() {
        const isDark = document.documentElement.classList.contains('dark');
        document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach(btn => {
          btn.classList.toggle('is-dark', isDark);
          btn.setAttribute('aria-label', isDark ? '切换浅色模式 / Switch to light' : '切换深色模式 / Switch to dark');
        });
      }

      // 统一初始化：主题 + 系统初始化 + PWA
      function initApp() {
        if (import.meta.env.DEV) console.log('🚀 initApp() called');
        try {
          // 主题必须立即应用，消除 FOUC
          applyStoredTheme();
          updateThemeIcon();
          // 监控/几何系统/PWA 注册延后到 idle，不抢首屏 INP/TBT
          const idle: (cb: () => void) => void =
            (window as any).requestIdleCallback
              ? (window as any).requestIdleCallback.bind(window)
              : (cb: () => void) => window.setTimeout(cb, 1500);
          idle(() => {
            initializeApp();
            registerPWA();
          });
          if (import.meta.env.DEV) console.log('✅ initApp() completed successfully');
        } catch (error) {
          if (import.meta.env.DEV) console.error('❌ initApp() error:', error);
        }
      }

      // 首次加载
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }

      // Astro 视图切换后：重跑初始化 + 焦点落到新页 main（无障碍）+ 移除 swap 期间的 is-swapping
      document.addEventListener('astro:after-swap', () => {
        if (import.meta.env.DEV) console.log('🔄 astro:after-swap fired, reinitializing...');
        initApp();
        const main = document.getElementById('main-content');
        if (main) {
          main.setAttribute('tabindex', '-1');
          main.focus({ preventScroll: true });
        }
        // 下一帧再恢复 smooth-scroll，确保 swap 期间的滚动已完成
        requestAnimationFrame(() => document.documentElement.classList.remove('is-swapping'));
      });
    </script>
  </body>
</html>

<style>
  /* ===== 跳到主要内容（键盘 / 屏幕阅读器） ===== */
  .skip-link {
    position: fixed;
    top: var(--spacing-2);
    left: var(--spacing-2);
    z-index: 1000;
    transform: translateY(-150%);
    transition: transform var(--transition-fast);
    padding: var(--spacing-2) var(--spacing-4);
    background: var(--color-surface-pure);
    border: 1px solid var(--color-gold-dust);
    border-radius: var(--radius-xs);
    color: var(--color-text-heading);
    font-family: var(--font-family-sans);
    font-size: var(--font-size-xs);
    text-decoration: none !important;
    box-shadow: 0 2px 8px -2px rgb(var(--color-gold-dust-rgb) / 14%);
  }
  .skip-link:focus,
  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--color-gold-dust);
    outline-offset: 2px;
  }

  /* ===== 全局骨架样式 ===== */
  main {
    min-height: 60vh;
    background-color: var(--color-bg-page);
    padding-top: var(--spacing-8); /* 顶部留白（与导航间距） */
    padding-bottom: var(--spacing-20); /* 底部留白（与页脚间距） */
    /* main 只过渡 opacity（语言切换 cross-fade 用）。bg/color 不过渡——
       之前加的 420ms 让 main 在主题切换时淡，而内层内容瞬切，造成"色块加载"。 */
    transition: opacity 180ms cubic-bezier(0.42, 0, 0.58, 1);
  }

  /* 深色模式适配（由变量自动处理，无需额外代码） */
</style>
