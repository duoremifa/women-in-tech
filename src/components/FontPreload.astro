---
// 宁静报价单字体预加载
// 仅加载实际使用的字体：Inter, Poppins, Lora, Noto Serif SC
// 字重范围：300–700（匹配设计系统的 --font-weight-*）
---

<!-- DNS 预连接 -->
<link rel='preconnect' href='https://fonts.googleapis.com' />
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />

<!-- 关键字体预加载 - Lora（主要衬线字体） -->
<link
  rel='preload'
  href='https://fonts.gstatic.com/s/lora/v35/0QIvMX1DJOuMw7Djt9w.woff2'
  as='font'
  type='font/woff2'
  crossorigin
/>

<!-- 关键字体预加载 - Inter（主要无衬线字体） -->
<link
  rel='preload'
  href='https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iWTe9S4UFDaM5Y.woff2'
  as='font'
  type='font/woff2'
  crossorigin
/>

<!-- 字体样式表加载 -->
<link
  href='https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&family=Lora:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@300;400;500;700&display=swap'
  rel='stylesheet'
/>

<!-- 等宽字体不预加载（按需加载），如需 JetBrains Mono 可取消注释下一行 -->
<!-- <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet"> -->
