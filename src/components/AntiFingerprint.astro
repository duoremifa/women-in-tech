---
// 高级反指纹保护组件
// 在浏览器空闲时执行，不影响页面加载性能
---

<script define:vars={{}}>
  // 🛡️ Canvas指纹防护
  const protectCanvasFingerprint = () => {
    try {
      const originalGetContext = HTMLCanvasElement.prototype.getContext;

      HTMLCanvasElement.prototype.getContext = function (contextType, ...args) {
        const context = originalGetContext.call(this, contextType, ...args);

        // 只保护2D上下文
        if (contextType === '2d' && context) {
          const originalGetImageData = context.getImageData;

          context.getImageData = function (...args) {
            const imageData = originalGetImageData.apply(this, args);

            // 添加轻微噪声，破坏指纹一致性
            const data = imageData.data;
            for (let i = 0; i < data.length; i += 4) {
              // 对RGB通道添加微小随机噪声
              data[i] = data[i] ^ (Math.random() > 0.5 ? 1 : 0); // Red
              data[i + 1] = data[i + 1] ^ (Math.random() > 0.5 ? 1 : 0); // Green
              data[i + 2] = data[i + 2] ^ (Math.random() > 0.5 ? 1 : 0); // Blue
              // Alpha通道保持不变
            }

            return imageData;
          };
        }

        return context;
      };
    } catch (error) {
      console.warn('Canvas fingerprint protection failed:', error);
    }
  };

  // 🛡️ WebGL指纹防护
  const protectWebGLFingerprint = () => {
    try {
      const originalGetParameter = WebGLRenderingContext.prototype.getParameter;

      WebGLRenderingContext.prototype.getParameter = function (pname) {
        const result = originalGetParameter.call(this, pname);

        // 对关键渲染信息添加噪声
        if (
          pname === this.VENDOR ||
          pname === this.RENDERER ||
          pname === this.VERSION ||
          pname === this.SHADING_LANGUAGE_VERSION
        ) {
          if (typeof result === 'string') {
            // 轻微修改字符串信息
            return result.replace(/\d+\.\d+/, match => {
              const num = parseFloat(match);
              return (num + (Math.random() - 0.5) * 0.01).toFixed(3);
            });
          }
        }

        return result;
      };
    } catch (error) {
      console.warn('WebGL fingerprint protection failed:', error);
    }
  };

  // 🛡️ 字体指纹防护
  const protectFontFingerprint = () => {
    try {
      const originalMeasureText = CanvasRenderingContext2D.prototype.measureText;

      CanvasRenderingContext2D.prototype.measureText = function (text) {
        const metrics = originalMeasureText.call(this, text);

        // 添加微小随机偏移
        if (metrics.width) {
          Object.defineProperty(metrics, 'width', {
            value: metrics.width + (Math.random() - 0.5) * 0.01,
            writable: false,
          });
        }

        return metrics;
      };
    } catch (error) {
      console.warn('Font fingerprint protection failed:', error);
    }
  };

  // 🛡️ 时区指纹防护
  const protectTimezoneFingerprint = () => {
    try {
      const originalGetTimezoneOffset = Date.prototype.getTimezoneOffset;

      Date.prototype.getTimezoneOffset = function () {
        const offset = originalGetTimezoneOffset.call(this);
        // 添加微小随机偏移（±1分钟）
        return offset + (Math.random() > 0.5 ? 1 : -1);
      };
    } catch (error) {
      console.warn('Timezone fingerprint protection failed:', error);
    }
  };

  // 🛡️ 音频指纹防护
  const protectAudioFingerprint = () => {
    try {
      if (window.AudioContext || window.webkitAudioContext) {
        const AudioContextProto = (window.AudioContext || window.webkitAudioContext).prototype;
        const originalCreateOscillator = AudioContextProto.createOscillator;

        AudioContextProto.createOscillator = function () {
          const oscillator = originalCreateOscillator.call(this);
          const originalStart = oscillator.start;

          oscillator.start = function (...args) {
            // 添加微小时间偏移
            if (args[0] !== undefined) {
              args[0] += (Math.random() - 0.5) * 0.001;
            }
            return originalStart.apply(this, args);
          };

          return oscillator;
        };
      }
    } catch (error) {
      console.warn('Audio fingerprint protection failed:', error);
    }
  };

  // 🛡️ 屏幕指纹防护
  const protectScreenFingerprint = () => {
    try {
      const originalGetBoundingClientRect = Element.prototype.getBoundingClientRect;

      Element.prototype.getBoundingClientRect = function () {
        const rect = originalGetBoundingClientRect.call(this);

        // 对非关键元素添加微小随机偏移
        if (!this.matches('html, body, main')) {
          Object.defineProperty(rect, 'width', {
            value: Math.max(1, rect.width + (Math.random() - 0.5) * 0.1),
            writable: false,
          });
          Object.defineProperty(rect, 'height', {
            value: Math.max(1, rect.height + (Math.random() - 0.5) * 0.1),
            writable: false,
          });
        }

        return rect;
      };
    } catch (error) {
      console.warn('Screen fingerprint protection failed:', error);
    }
  };

  // 🚀 执行安全防护（专注保护媒体与硬件渲染指纹，不干扰原生布局与时间计算）
  const initAntiFingerprint = () => {
    const shouldEnableProtection = localStorage.getItem('anti-fingerprint') !== 'disabled';

    if (shouldEnableProtection) {
      protectCanvasFingerprint();
      protectWebGLFingerprint();
      protectFontFingerprint();
      protectAudioFingerprint();
    }
  };

  // 延迟执行，避免影响页面性能
  setTimeout(initAntiFingerprint, 1000);
</script>

<!-- 这个组件没有UI，只提供隐私保护功能 -->
