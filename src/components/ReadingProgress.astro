---
// ReadingProgress.astro - 阅读进度条组件
// 提供页面滚动进度指示功能，增强微交互效果
---

<!-- 阅读进度条（纯装饰，对辅助技术隐藏）——1px gradient bar，无涟漪（涟漪每帧闪烁，与顶奢克制冲突） -->
<div class='reading-progress' id='reading-progress' aria-hidden='true'></div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: var(--border-width-normal);
    background: linear-gradient(
      to right,
      var(--progress-start-color) 0%,
      var(--progress-end-color) 100%
    );
    z-index: 1000;
    transition: width var(--transition-fast);
  }
</style>

<script>
  function initReadingProgress(): (() => void) | undefined {
    const progressBar = document.getElementById('reading-progress');
    if (!progressBar) return undefined;

    const bar = progressBar;
    function updateProgress() {
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;

      bar.style.width = scrolled + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    return () => window.removeEventListener('scroll', updateProgress);
  }

  let cleanup: (() => void) | undefined = undefined;

  // astro:page-load 在首屏与每次视图切换后均触发；after-swap 会与之重复，故只保留 page-load
  document.addEventListener('astro:page-load', () => {
    if (cleanup) cleanup();
    cleanup = initReadingProgress();
  });
</script>
