---
// src/components/SEO.astro - 商业级 SEO 与社交卡片 (Twitter, Weibo, Facebook, Instagram, LinkedIn, WeChat)
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  keywords?: string;
}

const {
  title = 'wo/men in tech · women in technical',
  description = 'women in tech · 在杭州的巷子与山径之间，做经得起时间的事。',
  image = '/og-image.png',
  canonicalURL = Astro.url.href.split('?')[0].replace(/\/$/, '') || 'https://wotech.space',
  type = 'website',
  ogImage,
  publishedTime,
  keywords = 'wo/men in tech, women in technical, 杭州, 手艺人, 设计师, 工程师, 写作者, 田野手记, 播客, Coffee Chat, Show and Tell',
} = Astro.props;

// 确保主标题带有品牌后缀
const siteName = 'wo/men in tech';
const fullTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;

// 确保社交卡片图片是绝对路径并且是真实 PNG (Twitter/Facebook/微博/微信 不支持 svg 作为卡片图)
const rawImage = ogImage || image || '/og-image.png';
const absoluteImageUrl = rawImage.startsWith('http')
  ? rawImage
  : new URL(rawImage, 'https://wotech.space').href;

// 活动结构化数据从单一数据源 gatherings 取；过期活动标 EventCompleted
import { GATHERINGS, isGatheringPast } from '../data/gatherings';
const now = new Date();
const eventNodes = GATHERINGS.map(g => ({
  '@type': 'Event',
  '@id': `https://wotech.space/#${g.id}`,
  'name': g.titleEn,
  'description': g.descriptionEn,
  'eventAttendanceMode':
    g.location.type === 'VirtualLocation'
      ? 'https://schema.org/OnlineEventAttendanceMode'
      : 'https://schema.org/MixedEventAttendanceMode',
  'eventStatus': isGatheringPast(g, now)
    ? 'https://schema.org/EventCompleted'
    : 'https://schema.org/EventScheduled',
  'startDate': g.startIso,
  'endDate': g.endIso,
  'location':
    g.location.type === 'VirtualLocation'
      ? { '@type': 'VirtualLocation', url: g.location.url }
      : [
          {
            '@type': 'Place',
            'name': g.location.name,
            'address': {
              '@type': 'PostalAddress',
              'addressLocality': g.location.addressLocality,
              'addressCountry': g.location.addressCountry,
            },
          },
          { '@type': 'VirtualLocation', url: 'https://wotech.space/#schedule' },
        ],
  'organizer': { '@id': 'https://wotech.space/#organization' },
}));

// 结构化数据 Schema.org
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://wotech.space/#website',
      'url': 'https://wotech.space/',
      'name': 'wo/men in tech',
      'alternateName': ['women in technical', 'wotech'],
      'description': description,
      'inLanguage': ['zh-CN', 'en'],
      'publisher': {
        '@id': 'https://wotech.space/#organization',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://wotech.space/#organization',
      'name': 'wo/men in tech',
      'alternateName': 'women in technical',
      'url': 'https://wotech.space/',
      'logo': {
        '@type': 'ImageObject',
        'url': 'https://wotech.space/og-image.png',
        'width': 1200,
        'height': 630,
      },
      'slogan': '做经得起时间的事 · 杭州',
      'description': 'women in tech · 手艺人、设计师、工程师、艺术工作者、工作室主、写作者——以作品署名，不在机构里。',
      'sameAs': [
        'https://github.com/duoremifa/women-in-tech',
      ],
    },
    ...eventNodes,
  ],
};
---

<!-- 基础元数据 -->
<meta charset='UTF-8' />
<meta name='viewport' content='width=device-width, initial-scale=1.0, viewport-fit=cover' />
<meta name='generator' content={Astro.generator} />

<!-- 核心 SEO 标签 -->
<title>{fullTitle}</title>
<meta name='description' content={description} />
<meta name='keywords' content={keywords} />
<meta name='author' content='wo/men in tech' />
<link rel='canonical' href={canonicalURL} />

<!-- 搜索引擎爬虫指令 (极致开放抓取、开启大图与丰富摘要) -->
<meta name='robots' content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' />
<meta name='googlebot' content='index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1' />
<meta name='bingbot' content='index, follow, max-snippet:-1, max-image-preview:large' />
<meta name='baiduspider' content='index, follow' />

<!-- 多语言 / 国际化 hreflang：站点语言由 JS+localStorage 切换，无独立 en URL，
     故仅声明 zh-CN 与 x-default，避免向搜索引擎发送错误的 hreflang 信号 -->
<link rel='alternate' hreflang='zh-CN' href='https://wotech.space/' />
<link rel='alternate' hreflang='x-default' href='https://wotech.space/' />

<!-- Open Graph / Facebook / Instagram / 微信 / 微博 / LinkedIn -->
<meta property='og:site_name' content={siteName} />
<meta property='og:type' content={type} />
<meta property='og:url' content={canonicalURL} />
<meta property='og:title' content={fullTitle} />
<meta property='og:description' content={description} />
{type === 'article' && publishedTime && (
  <meta property='article:published_time' content={publishedTime} />
)}
<meta property='og:image' content={absoluteImageUrl} />
<meta property='og:image:secure_url' content={absoluteImageUrl} />
<meta property='og:image:type' content='image/png' />
<meta property='og:image:width' content='1200' />
<meta property='og:image:height' content='630' />
<meta property='og:image:alt' content='wo/men in tech · 在杭州的巷子与山径之间，做经得起时间的事' />
<meta property='og:locale' content='zh_CN' />
<meta property='og:locale:alternate' content='en_US' />

<!-- Twitter / X 大图卡片（Twitter Cards 规范用 name 属性，property 变体非标准且冗余，已移除） -->
<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:site' content='@wotech_space' />
<meta name='twitter:creator' content='@wotech_space' />
<meta name='twitter:url' content={canonicalURL} />
<meta name='twitter:title' content={fullTitle} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={absoluteImageUrl} />
<meta name='twitter:image:alt' content='wo/men in tech · 做，经得起时间' />

<!-- 移动与品牌色彩 -->
<meta name='format-detection' content='telephone=no, address=no, email=no' />
<meta name='application-name' content={siteName} />
<meta name='apple-mobile-web-app-title' content={siteName} />
<meta name='apple-mobile-web-app-capable' content='yes' />
<meta name='apple-mobile-web-app-status-bar-style' content='default' />

<!-- 结构化数据 Schema.org (JSON-LD) -->
<script type='application/ld+json' set:html={JSON.stringify(jsonLd)} />
