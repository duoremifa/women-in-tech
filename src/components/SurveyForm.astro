---
/**
 * SurveyForm.astro
 * A beautiful, "quiet" survey form designed for cognitive friction research.
 * Uses the design system tokens for a premium, low-pressure experience.
 */
---

<div class='survey-container' id='survey-form-root'>
  <!-- Sticky Progress Navigator -->
  <div class='sticky-progress' id='sticky-progress'>
    <div class='progress-track'>
      <div class='progress-bar' id='main-progress-bar'></div>
    </div>
    <div class='progress-steps'>
      <span class='step-node' data-step='1'>1</span>
      <span class='step-node' data-step='2'>2</span>
      <span class='step-node' data-step='3'>3</span>
      <span class='step-node' data-step='4'>4</span>
      <span class='step-node' data-step='5'>5</span>
    </div>
  </div>

  <!-- Section 1: Basic Background -->
  <section class='survey-section' data-section='1'>
    <h2 class='section-title'>
      <span class='step-badge'>Step 1 / 5</span>
      <span class='title-zh'>区块 1：基本背景</span>
      <span class='title-en'>Part 1: Basic Background</span>
    </h2>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'>1. 你的年龄段是？</span>
        <span class='label-en'>1. What is your age group?</span>
      </label>

      <div class='options-grid'>
        {
          [
            { val: '18_24', text: '18–24' },
            { val: '25_34', text: '25–34' },
            { val: '35_44', text: '35–44' },
            { val: '45_plus', text: '45 or above / 45 岁及以上' },
            { val: 'prefer_not_say', text: 'Prefer not to say / 不愿回答' },
          ].map(opt => (
            <label class='radio-label'>
              <input type='radio' name='age_group' value={opt.val} required />
              <span class='radio-text'>{opt.text}</span>
            </label>
          ))
        }
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'>2. 哪一项最接近你目前的状态？</span>
        <span class='label-en'>2. What best describes your current status?</span>
      </label>

      <div class='options-grid'>
        {
          [
            { val: 'full_time', en: 'Full-time employed', zh: '全职工作' },
            { val: 'part_time', en: 'Part-time employed', zh: '兼职工作' },
            { val: 'self_employed', en: 'Self-employed or freelance', zh: '自雇或自由职业' },
            { val: 'student', en: 'Student', zh: '学生' },
            { val: 'not_working', en: 'Not currently working', zh: '暂时没有工作' },
            { val: 'other', en: 'Other', zh: '其他' },
          ].map(opt => (
            <label class='radio-label'>
              <input type='radio' name='work_status' value={opt.val} required />
              <span class='radio-text'>
                {opt.zh} / {opt.en}
              </span>
            </label>
          ))
        }
      </div>
      <div class='other-input-container' data-target='work_status'>
        <input
          type='text'
          name='work_status_other'
          class='text-input'
          placeholder='请说明 / Please specify'
        />
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'>3. 你目前主要居住在哪个国家或地区？（可填写城市）</span>
        <span class='label-en'>3. Which country or region are you mainly living in now?</span>
      </label>

      <input
        type='text'
        name='country_region'
        class='text-input'
        placeholder='请在此填写... / Type here...'
        required
      />
    </div>
  </section>

  <!-- Section 2: Cognitive and Time Ecology -->
  <section class='survey-section' data-section='2'>
    <h2 class='section-title'>
      <span class='step-badge'>Step 2 / 5</span>
      <span class='title-zh'>区块 2：认知与时间生态</span>
      <span class='title-en'>Part 2: Cognitive and Time Ecology</span>
    </h2>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'
          >4. 你是否认为自己属于“神经多样性”（例如 ADHD、注意力困难、自闭谱系等）？</span
        >
        <span class='label-en'
          >4. Do you see yourself as neurodivergent (e.g., ADHD, autism, learning differences)?</span
        >
      </label>

      <div class='options-row'>
        {
          [
            { val: 'yes', text_zh: '是', text_en: 'Yes' },
            { val: 'no', text_zh: '否', text_en: 'No' },
            { val: 'not_sure', text_zh: '不确定或不熟悉', text_en: 'Not sure / Not familiar' },
          ].map(opt => (
            <label class='radio-label'>
              <input type='radio' name='nd_self_id' value={opt.val} required />
              <span class='radio-text'>
                {opt.text_zh} / {opt.text_en}
              </span>
            </label>
          ))
        }
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'>5. 你是否有与神经多样性相关的正式诊断？</span>
        <span class='label-en'>5. Do you have any formal diagnosis related to neurodivergence?</span
        >
      </label>

      <div class='options-row'>
        {
          [
            { val: 'yes', text_zh: '有', text_en: 'Yes' },
            { val: 'no', text_zh: '没有', text_en: 'No' },
            { val: 'prefer_not_say', text_zh: '不愿回答', text_en: 'Prefer not to say' },
          ].map(opt => (
            <label class='radio-label'>
              <input type='radio' name='nd_diagnosis' value={opt.val} required />
              <span class='radio-text'>
                {opt.text_zh} / {opt.text_en}
              </span>
            </label>
          ))
        }
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'>6. 就日常时间安排而言，你的典型一天更接近下面哪种情况？</span>
        <span class='label-en'
          >6. How would you describe your typical day in terms of time blocks?</span
        >
      </label>

      <div class='options-stack'>
        {
          [
            {
              val: 'blocks_large',
              en: 'Mostly large, uninterrupted blocks of time',
              zh: '以大块、不被打断的时间为主',
            },
            {
              val: 'blocks_mixed_major_large',
              en: 'More large than small blocks',
              zh: '大块时间略多于碎片时间',
            },
            { val: 'half_half', en: 'Half-half', zh: '大块和碎片时间差不多各一半' },
            {
              val: 'blocks_mixed_major_fragmented',
              en: 'More fragmented than large blocks',
              zh: '碎片时间略多于大块时间',
            },
            {
              val: 'fragments_only',
              en: 'Very fragmented, constant interruptions',
              zh: '非常碎片化，经常被打断',
            },
          ].map(opt => (
            <label class='radio-label'>
              <input type='radio' name='time_fragmentation' value={opt.val} required />
              <span class='radio-text'>
                {opt.zh} / {opt.en}
              </span>
            </label>
          ))
        }
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'>7. 在不同任务或情境之间切换，对你来说有多费力？</span>
        <span class='label-en'
          >7. How effortful is it for you to switch between tasks or contexts?</span
        >
      </label>

      <div class='options-grid scale-row'>
        {
          [
            { val: 'very_easy', en: 'Very easy', zh: '非常轻松' },
            { val: 'rather_easy', en: 'Rather easy', zh: '比较轻松' },
            { val: 'moderate', en: 'Moderate', zh: '一般' },
            { val: 'rather_effortful', en: 'Rather effortful', zh: '比较费力' },
            { val: 'very_effortful', en: 'Very effortful', zh: '非常费力' },
          ].map(opt => (
            <label class='radio-label vertical'>
              <input type='radio' name='task_switch_effort' value={opt.val} required />
              <span class='radio-text'>{opt.zh}</span>
              <span class='radio-text-en'>{opt.en}</span>
            </label>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 3: Current Productivity or Task System -->
  <section class='survey-section' data-section='3'>
    <h2 class='section-title'>
      <span class='step-badge'>Step 3 / 5</span>
      <span class='title-zh'>区块 3：当前效率/任务系统</span>
      <span class='title-en'>Part 3: Current Productivity or Task System</span>
    </h2>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'>8. 在记录任务和安排计划时，你主要依靠哪些方式？（可多选）</span>
        <span class='label-en'
          >8. What do you mainly rely on to keep track of your tasks? (Check all that apply)</span
        >
      </label>

      <div class='options-grid'>
        {
          [
            {
              key: 'main_tools_todo_apps',
              en: 'To-do apps (e.g., Todoist, Microsoft To Do)',
              zh: '待办类应用',
            },
            {
              key: 'main_tools_note_tools',
              en: 'Note-taking tools (e.g., Notion, Evernote, 飞书文档)',
              zh: '笔记类工具',
            },
            {
              key: 'main_tools_digital_calendar',
              en: 'Digital calendar (e.g., Google Calendar)',
              zh: '电子日历',
            },
            {
              key: 'main_tools_paper_planner',
              en: 'Paper notebook or planner',
              zh: '纸质本子或手帐',
            },
            {
              key: 'main_tools_chat_apps',
              en: 'Chat apps (e.g., WeChat, WhatsApp)',
              zh: '聊天工具',
            },
            {
              key: 'main_tools_physical_reminders',
              en: 'Sticky notes or physical reminders',
              zh: '便利贴或实体提醒',
            },
            {
              key: 'main_tools_in_my_head',
              en: 'I mostly keep things in my head',
              zh: '主要靠记在脑子里',
            },
            { key: 'main_tools_other', en: 'Other', zh: '其他' },
          ].map(opt => (
            <label class='checkbox-label'>
              <input type='checkbox' name={opt.key} />
              <span class='checkbox-text'>
                {opt.zh} / {opt.en}
              </span>
            </label>
          ))
        }
      </div>
      <div class='other-input-container' data-target='main_tools_other'>
        <input
          type='text'
          name='main_tools_other_text'
          class='text-input'
          placeholder='请说明 / Please specify'
        />
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'
          >9. 过去 12 个月里，你大概有多少次“彻底重启或更换”自己的任务管理系统？</span
        >
        <span class='label-en'
          >9. In the past 12 months, how many times did you completely restart or switch your main
          system?</span
        >
      </label>

      <div class='options-row'>
        {
          [
            { val: 'zero', text: '0 times / 0 次' },
            { val: 'one_two', text: '1–2 times / 1–2 次' },
            { val: 'three_five', text: '3–5 times / 3–5 次' },
            { val: 'five_plus', text: 'More than 5 times / 超过 5 次' },
          ].map(opt => (
            <label class='radio-label'>
              <input type='radio' name='system_resets_12m' value={opt.val} required />
              <span class='radio-text'>{opt.text}</span>
            </label>
          ))
        }
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'>10. 总体来说，你对自己目前的任务/计划管理方式有多满意？（0-10）</span
        >
        <span class='label-en'
          >10. Overall, how satisfied are you with your current way of managing tasks? (0-10)</span
        >
      </label>

      <div class='slider-container'>
        <input
          type='range'
          name='satisfaction_0_10'
          min='0'
          max='10'
          step='1'
          value='5'
          class='range-input'
        />
        <div class='slider-labels'>
          <span>Extremely Dissatisfied <br /> 极度不满意</span>
          <span class='current-value'>5</span>
          <span>Extremely Satisfied <br /> 极度满意</span>
        </div>
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'
          >11.
          如果要向一个“和你非常相似的人”推荐任务管理方式，你有多大可能会推荐你现在的系统？（0-10）</span
        >
        <span class='label-en'
          >11. How likely are you to recommend your current system to someone similar to you? (0-10)</span
        >
      </label>

      <div class='slider-container'>
        <input
          type='range'
          name='nps_recommend_0_10'
          min='0'
          max='10'
          step='1'
          value='5'
          class='range-input'
        />
        <div class='slider-labels'>
          <span>Not at all likely <br /> 完全不可能</span>
          <span class='current-value'>5</span>
          <span>Extremely likely <br /> 极有可能</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: System–Life Alignment scale (SLA) -->
  <section class='survey-section' data-section='4'>
    <h2 class='section-title'>
      <span class='step-badge'>Step 4 / 5</span>
      <span class='title-zh'>区块 4：SLA 量表（系统–生活对齐度）</span>
      <span class='title-en'>Part 4: System–Life Alignment Scale (SLA)</span>
    </h2>
    <p class='section-intro'>
      <span class='intro-zh'>对于下面的陈述，请根据你的实际情况，选择你同意的程度。</span>
      <span class='intro-en'>Please rate how much you agree with the following statements.</span>
    </p>

    {
      [
        {
          key: 'sla1_crumble_weeks',
          en: 'Productivity systems I try usually crumble after a few weeks, even when I start with good intentions.',
          zh: '我尝试的效率系统通常过几周就会“崩掉”，即使一开始我很有决心坚持。',
        },
        {
          key: 'sla2_energy_on_system',
          en: 'I often spend more energy setting up, fixing, and rescuing systems than actually doing my work.',
          zh: '我常常花更多精力在“搭建、修补和抢救”系统本身，而不是在做真正的工作。',
        },
        {
          key: 'sla3_wrong_brain_assumption',
          en: 'Most tools assume a level of focus or consistency that just does not match how my brain works.',
          zh: '大多数工具都默认我有某种“专注和稳定性”，但这根本不像我的大脑运作方式。',
        },
        {
          key: 'sla4_self_blame',
          en: 'When a system stops working for me, I tend to blame myself rather than its design.',
          zh: '当一个系统对我开始“无效”时，我更倾向于责怪自己，而不是质疑系统的设计。',
        },
        {
          key: 'sla5_shadow_systems',
          en: 'To make tools usable, I often need to create extra “shadow systems” (screenshots, sticky notes, etc.).',
          zh: '为了让工具真正可用，我经常需要额外搭一套“影子系统”（截图、聊天记录、便利贴等）。',
        },
        {
          key: 'sla6_life_interruptions_vs_tools',
          en: 'My real-life responsibilities and interruptions constantly collide with how tools expect me to plan.',
          zh: '我现实生活中的责任和各种打断，经常与工具“期待我如何计划和执行任务”的方式相冲突。',
        },
        {
          key: 'sla7_rules_lead_to_collapse',
          en: 'The more rules and structures a system requires, the more likely it is to fall apart in my daily life.',
          zh: '一个系统要求我遵守的规则和结构越多，它就越容易在我的日常生活中“崩盘”。',
        },
      ].map((item, index) => (
        <div class='likert-group' data-key={item.key}>
          <p class='likert-statement'>
            <span class='sla-tag'>SLA-{index + 1}</span>
            <span class='statement-zh'>{item.zh}</span>
            <span class='statement-en'>{item.en}</span>
          </p>

          <div class='likert-options'>
            {[
              { val: 1, zh: '非常不同意', en: 'Strongly Disagree' },
              { val: 2, zh: '不同意', en: 'Disagree' },
              { val: 3, zh: '说不清', en: 'Not sure' },
              { val: 4, zh: '同意', en: 'Agree' },
              { val: 5, zh: '非常同意', en: 'Strongly Agree' },
            ].map(opt => (
              <label class='likert-label'>
                <input type='radio' name={item.key} value={opt.val} required />
                <span class='likert-dot' />
                <span class='likert-text-zh'>{opt.zh}</span>
                <span class='likert-text-en'>{opt.en}</span>
              </label>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <!-- Section 5: Consequences and Experience -->
  <section class='survey-section' data-section='5'>
    <h2 class='section-title'>
      <span class='step-badge'>Step 5 / 5</span>
      <span class='title-zh'>区块 5：后果与体验</span>
      <span class='title-en'>Part 5: Consequences and Experience</span>
    </h2>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-en'
          >19. In the past month, how often did you feel that you were “chasing the system” instead
          of the system supporting you?</span
        >
        <span class='label-zh'
          >19. 在过去一个月里，你有多常觉得自己是在“追着系统跑”，而不是系统在支持你？</span
        >
      </label>
      <div class='options-stack'>
        {
          [
            { val: 'never', zh: '从来没有', en: 'Never' },
            { val: 'rarely', zh: '偶尔', en: 'Rarely' },
            { val: 'sometimes', zh: '有时', en: 'Sometimes' },
            { val: 'often', zh: '经常', en: 'Often' },
            { val: 'almost_daily', zh: '几乎每天', en: 'Almost every day' },
          ].map(opt => (
            <label class='radio-label'>
              <input type='radio' name='chasing_system_freq' value={opt.val} required />
              <span class='radio-text'>
                {opt.zh} / {opt.en}
              </span>
            </label>
          ))
        }
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'
          >20. 在过去一个月里，你有多常因为系统“崩掉”或没有提醒到位，而错过重要事情？</span
        >
        <span class='label-en'
          >20. How often did you miss important things because your system broke down or you stopped
          using it?</span
        >
      </label>
      <div class='options-stack'>
        {
          [
            { val: 'never', zh: '从来没有', en: 'Never' },
            { val: 'rarely', zh: '偶尔', en: 'Rarely' },
            { val: 'sometimes', zh: '有时', en: 'Sometimes' },
            { val: 'often', zh: '经常', en: 'Often' },
            { val: 'very_often', en: 'Very often', zh: '非常频繁' },
          ].map(opt => (
            <label class='radio-label'>
              <input type='radio' name='missed_due_system_freq' value={opt.val} required />
              <span class='radio-text'>
                {opt.zh} / {opt.en}
              </span>
            </label>
          ))
        }
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-zh'
          >21. 总体来说，你现在的工具和系统更像是在“减轻你的负担”，还是“增加你的负担”？</span
        >
        <span class='label-en'
          >21. Do your current tools feel more like reducing your burden or adding to it?</span
        >
      </label>
      <div class='options-stack'>
        {
          [
            { val: 'strictly_reduce', zh: '明显减轻负担', en: 'Strongly reduce burden' },
            { val: 'somewhat_reduce', zh: '有些减轻负担', en: 'Somewhat reduce burden' },
            { val: 'neutral', zh: '差不多打平', en: 'Neither' },
            { val: 'somewhat_add', zh: '有些增加负担', en: 'Somewhat add burden' },
            { val: 'strictly_add', zh: '明显增加负担', en: 'Strongly add burden' },
          ].map(opt => (
            <label class='radio-label'>
              <input type='radio' name='burden_vs_relief' value={opt.val} required />
              <span class='radio-text'>
                {opt.zh} / {opt.en}
              </span>
            </label>
          ))
        }
      </div>
    </div>

    <div class='field-group'>
      <label class='field-label'>
        <span class='label-en'
          >22. In your own words, why do you think tools do or do not work for you?</span
        >
        <span class='label-zh'
          >22. 用你自己的话说说：你觉得为什么大多数效率工具或系统对你（不）起作用？</span
        >
      </label>
      <textarea
        name='tools_work_why'
        class='textarea-input'
        placeholder='可选：分享你的想法... / Optional: Share your experience'></textarea>
    </div>
  </section>

  <div class='survey-actions' id='survey-actions'>
    <p id='form-error' class='error-msg hidden'></p>
    <button type='button' id='submit-survey' class='btn btn-primary btn-large submit-btn'>
      <span class='btn-text'>提交 / Submit</span>
      <div class='loading-spinner hidden'></div>
    </button>
  </div>

  <div id='success-message' class='success-overlay hidden'>
    <div class='success-card'>
      <div class='success-icon'>✓</div>
      <h3 class='success-title-zh'>提交成功！</h3>
      <p class='success-text-zh'>非常感谢你花时间、也愿意诚实地分享自己的经验。</p>
      <h3 class='success-title-en'>Submitted Successfully!</h3>
      <p class='success-text-en'>Thank you very much for your time and honesty.</p>
      <button
        type='button'
        class='btn btn-primary'
        style='margin-top: 2rem;'
        onclick='window.location.reload()'>返回首页 / Restart</button
      >
    </div>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase';
  import type { SurveyResponse } from '../lib/supabase';

  const formRoot = document.getElementById('survey-form-root');
  const submitBtn = document.getElementById('submit-survey');
  const errorMsg = document.getElementById('form-error');
  const successOverlay = document.getElementById('success-message');

  // Tracking start time
  const startTime = Date.now();

  // Progress Tracking with Intersection Observer
  const sections = document.querySelectorAll('.survey-section');
  const stepNodes = document.querySelectorAll('.step-node');
  const mainProgressBar = document.getElementById('main-progress-bar');
  const stickyProgress = document.getElementById('sticky-progress');

  const observerOptions = {
    root: null,
    threshold: 0.25,
  };

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const step = (entry.target as HTMLElement).dataset.section;
        if (step) {
          updateProgress(parseInt(step));
        }
      }
    });
  }, observerOptions);

  sections.forEach(section => observer.observe(section));

  function updateProgress(step: number) {
    stepNodes.forEach((node, idx) => {
      if (idx + 1 <= step) node.classList.add('active');
      else node.classList.remove('active');
    });
    if (mainProgressBar) {
      mainProgressBar.style.width = `${((step - 1) / 4) * 100}%`;
    }
  }

  // Show/Hide sticky progress based on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 200) {
      stickyProgress?.classList.add('visible');
    } else {
      stickyProgress?.classList.remove('visible');
    }
  });

  // Handle "Other" inputs via event delegation on form root
  formRoot?.addEventListener('change', (e: any) => {
    const target = e.target as HTMLInputElement;

    // Q2 Work Status Other
    if (target.name === 'work_status') {
      const container = formRoot.querySelector<HTMLElement>(
        '.other-input-container[data-target="work_status"]'
      );
      if (container) {
        container.classList.toggle('visible', target.value === 'other');
      }
    }

    // Q8 Main Tools Other
    if (target.name === 'main_tools_other') {
      const container = formRoot.querySelector<HTMLElement>(
        '.other-input-container[data-target="main_tools_other"]'
      );
      if (container) {
        container.classList.toggle('visible', target.checked);
      }
    }
  });

  // ── Draft Caching (localStorage) ─────────────────────────────────────────
  const DRAFT_KEY = 'fl_survey_draft';

  function saveDraft() {
    if (!formRoot) return;
    const draft: Record<string, any> = {};
    // Text inputs & textarea
    formRoot
      .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[type="text"], textarea')
      .forEach(el => {
        draft[el.name] = el.value;
      });
    // Radio
    formRoot.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked').forEach(el => {
      draft[el.name] = el.value;
    });
    // Checkbox
    formRoot.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(el => {
      draft[el.name] = el.checked;
    });
    // Range sliders
    formRoot.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(el => {
      draft[el.name] = el.value;
    });
    localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
  }

  function restoreDraft() {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (!raw || !formRoot) return;
    let draft: Record<string, any>;
    try {
      draft = JSON.parse(raw);
    } catch {
      return;
    }

    // Text inputs & textarea
    formRoot
      .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[type="text"], textarea')
      .forEach(el => {
        if (draft[el.name] !== undefined) el.value = draft[el.name];
      });
    // Radio
    formRoot.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(el => {
      if (draft[el.name] === el.value) el.checked = true;
    });
    // Checkbox
    formRoot.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(el => {
      if (draft[el.name] !== undefined) el.checked = draft[el.name];
    });
    // Range sliders (update both value and displayed number)
    formRoot.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(el => {
      if (draft[el.name] !== undefined) {
        el.value = draft[el.name];
        const display = el.parentElement?.querySelector('.current-value');
        if (display) display.textContent = draft[el.name];
      }
    });
    // Restore "Other" container visibility
    const workStatusVal = draft['work_status'];
    if (workStatusVal === 'other') {
      formRoot
        .querySelector<HTMLElement>('.other-input-container[data-target="work_status"]')
        ?.classList.add('visible');
    }
    if (draft['main_tools_other'] === true) {
      formRoot
        .querySelector<HTMLElement>('.other-input-container[data-target="main_tools_other"]')
        ?.classList.add('visible');
    }

    // Show a subtle toast
    showToast('草稿已恢复 / Draft restored');
  }

  function clearDraft() {
    localStorage.removeItem(DRAFT_KEY);
  }

  // Auto-save on any form change
  formRoot?.addEventListener('change', () => saveDraft());
  formRoot?.addEventListener('input', () => saveDraft());

  // ── Already-submitted guard ─────────────────────────────────────────────
  const SUBMITTED_KEY = 'fl_survey_submitted';

  function markSubmitted(responseId: string) {
    localStorage.setItem(
      SUBMITTED_KEY,
      JSON.stringify({
        responseId,
        submittedAt: new Date().toISOString(),
      })
    );
  }

  function hasAlreadySubmitted(): boolean {
    return !!localStorage.getItem(SUBMITTED_KEY);
  }

  // On load: if already submitted, show a gentle notice instead of the form
  if (hasAlreadySubmitted()) {
    const formSections = document.querySelectorAll('.survey-section');
    const surveyActions = document.getElementById('survey-actions');
    const stickyProgressEl = document.getElementById('sticky-progress');
    formSections.forEach(s => ((s as HTMLElement).style.display = 'none'));
    if (surveyActions) surveyActions.style.display = 'none';
    if (stickyProgressEl) stickyProgressEl.style.display = 'none';

    const alreadyDone = document.createElement('div');
    alreadyDone.className = 'already-submitted-notice';
    alreadyDone.innerHTML = `
      <div class="already-icon">✓</div>
      <h3 class="already-title-zh">你已完成本次问卷</h3>
      <p class="already-text-zh">感谢你的参与，本次问卷每个设备只能提交一次。</p>
      <h3 class="already-title-en">Survey Already Submitted</h3>
      <p class="already-text-en">Thank you! This survey can only be submitted once per device.</p>
    `;
    formRoot?.appendChild(alreadyDone);
  }

  // Restore draft on load (only if not already submitted)
  if (!hasAlreadySubmitted()) {
    restoreDraft();
  }

  // ── Toast Notification ────────────────────────────────────────────────────
  function showToast(msg: string) {
    const toast = document.createElement('div');
    toast.className = 'draft-toast';
    toast.textContent = msg;
    document.body.appendChild(toast);
    requestAnimationFrame(() => toast.classList.add('visible'));
    setTimeout(() => {
      toast.classList.remove('visible');
      setTimeout(() => toast.remove(), 400);
    }, 2500);
  }

  // Handle slider display
  const ranges = document.querySelectorAll('.range-input');
  ranges.forEach(range => {
    range.addEventListener('input', (e: any) => {
      const valDisplay = e.target.parentElement.querySelector('.current-value');
      if (valDisplay) valDisplay.textContent = e.target.value;
    });
  });

  // Form Submission
  submitBtn?.addEventListener('click', async () => {
    if (!supabase) {
      alert('Database not configured. / 数据库未配置。');
      return;
    }

    // Basic validation
    const radioGroups = [
      'age_group',
      'work_status',
      'nd_self_id',
      'nd_diagnosis',
      'time_fragmentation',
      'task_switch_effort',
      'system_resets_12m',
      'chasing_system_freq',
      'missed_due_system_freq',
      'burden_vs_relief',
      'sla1_crumble_weeks',
      'sla2_energy_on_system',
      'sla3_wrong_brain_assumption',
      'sla4_self_blame',
      'sla5_shadow_systems',
      'sla6_life_interruptions_vs_tools',
      'sla7_rules_lead_to_collapse',
    ];

    let isValid = true;
    const missingFields: string[] = [];

    radioGroups.forEach(group => {
      const checked = formRoot?.querySelector(`input[name="${group}"]:checked`);
      if (!checked) {
        isValid = false;
        missingFields.push(group);
      }
    });

    const regionInput = formRoot?.querySelector('input[name="country_region"]') as HTMLInputElement;
    if (!regionInput?.value) {
      isValid = false;
      missingFields.push('country_region');
    }

    if (!isValid) {
      if (errorMsg) {
        errorMsg.textContent = 'Please complete all required fields. / 请填写所有必填项。';
        errorMsg.classList.remove('hidden');
      }
      console.log('Missing fields:', missingFields);
      // Optional: scroll to first missing
      const firstMissing = formRoot?.querySelector(`input[name="${missingFields[0]}"]`);
      firstMissing?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    // Collect data
    const getRadio = (name: string) =>
      (formRoot?.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement)?.value;
    const getRange = (name: string) =>
      parseInt((formRoot?.querySelector(`input[name="${name}"]`) as HTMLInputElement).value);
    const getCheck = (name: string) =>
      (formRoot?.querySelector(`input[name="${name}"]`) as HTMLInputElement).checked;
    const getText = (name: string) =>
      (formRoot?.querySelector(`input[name="${name}"]`) as HTMLInputElement | HTMLTextAreaElement)
        ?.value;

    const duration_seconds = Math.floor((Date.now() - startTime) / 1000);
    const locale = document.documentElement.lang || 'zh-CN';

    const submissionData: SurveyResponse = {
      response_id: crypto.randomUUID(),
      created_at: new Date().toISOString(),
      locale,
      duration_seconds,
      user_agent: navigator.userAgent,
      age_group: getRadio('age_group'),
      work_status: getRadio('work_status'),
      work_status_other: getText('work_status_other'),
      country_region: getText('country_region'),
      nd_self_id: getRadio('nd_self_id'),
      nd_diagnosis: getRadio('nd_diagnosis'),
      time_fragmentation: getRadio('time_fragmentation'),
      task_switch_effort: getRadio('task_switch_effort'),
      main_tools_todo_apps: getCheck('main_tools_todo_apps'),
      main_tools_note_tools: getCheck('main_tools_note_tools'),
      main_tools_digital_calendar: getCheck('main_tools_digital_calendar'),
      main_tools_paper_planner: getCheck('main_tools_paper_planner'),
      main_tools_chat_apps: getCheck('main_tools_chat_apps'),
      main_tools_physical_reminders: getCheck('main_tools_physical_reminders'),
      main_tools_in_my_head: getCheck('main_tools_in_my_head'),
      main_tools_other: getCheck('main_tools_other'),
      main_tools_other_text: getText('main_tools_other_text'),
      system_resets_12m: getRadio('system_resets_12m'),
      satisfaction_0_10: getRange('satisfaction_0_10'),
      nps_recommend_0_10: getRange('nps_recommend_0_10'),
      sla1_crumble_weeks: parseInt(getRadio('sla1_crumble_weeks')),
      sla2_energy_on_system: parseInt(getRadio('sla2_energy_on_system')),
      sla3_wrong_brain_assumption: parseInt(getRadio('sla3_wrong_brain_assumption')),
      sla4_self_blame: parseInt(getRadio('sla4_self_blame')),
      sla5_shadow_systems: parseInt(getRadio('sla5_shadow_systems')),
      sla6_life_interruptions_vs_tools: parseInt(getRadio('sla6_life_interruptions_vs_tools')),
      sla7_rules_lead_to_collapse: parseInt(getRadio('sla7_rules_lead_to_collapse')),
      chasing_system_freq: getRadio('chasing_system_freq'),
      missed_due_system_freq: getRadio('missed_due_system_freq'),
      burden_vs_relief: getRadio('burden_vs_relief'),
      tools_work_why: getText('tools_work_why'),
    };

    // Loading state
    submitBtn.setAttribute('disabled', 'true');
    const btnText = submitBtn.querySelector('.btn-text');
    const spinner = submitBtn.querySelector('.loading-spinner');
    btnText?.classList.add('hidden');
    spinner?.classList.remove('hidden');

    try {
      const { error } = await supabase.from('survey_responses').insert([submissionData]);

      if (error) throw error;

      // Mark as submitted in localStorage (prevents re-submission on this device)
      markSubmitted(submissionData.response_id!);
      clearDraft();
      successOverlay?.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch {
      if (errorMsg) {
        errorMsg.textContent = '提交失败，请稍后重试。/ Submission failed, please try again later.';
        errorMsg.classList.remove('hidden');
      }
      submitBtn.removeAttribute('disabled');
      btnText?.classList.remove('hidden');
      spinner?.classList.add('hidden');
    }
  });
</script>

