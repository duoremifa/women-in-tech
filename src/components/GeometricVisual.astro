---
// GeometricVisual.astro
// 完全变量化，适配双主题
interface Props {
  type?: 'subtle' | 'minimal' | 'accent';
  height?: string;
  opacity?: number;
  isBackground?: boolean;
  elementsCount?: number;
  class?: string;
  style?: string;
}

const {
  type = 'subtle',
  height = '120px',
  opacity = 0.1,
  isBackground = false,
  elementsCount = 4,
  class: className = '',
  style = '',
} = Astro.props;

const getElements = (type: string, count: number) => {
  const elements = [];
  for (let i = 0; i < count; i++) {
    elements.push({
      id: i,
      position: {
        x: Math.floor(Math.random() * 80) + 10,
        y: Math.floor(Math.random() * 80) + 10,
      },
      size: type === 'accent' ? 'medium' : 'small',
      shape: ['circle', 'line', 'grid', 'intersect'][i % 4],
    });
  }
  return elements;
};

const visualElements = getElements(type, elementsCount);
---

<div
  class={`geometric-visual visual-${type} ${isBackground ? 'is-background' : ''} ${className}`}
  style={`
    --visual-height: ${height};
    --visual-opacity: ${opacity};
    ${style}
  `}
  aria-hidden='true'
>
  <div class='geometric-elements'>
    {
      visualElements.map(element => (
        <div
          class={`geom-element geom-${element.shape}`}
          style={`
          --element-x: ${element.position.x}%;
          --element-y: ${element.position.y}%;
          --element-index: ${element.id};
        `}
        />
      ))
    }
  </div>
</div>

<style>
  /* ===== 几何容器 ===== */
  .geometric-visual {
    position: relative;
    width: 100%;
    height: var(--visual-height);
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .geometric-visual.is-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .geometric-elements {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* ===== 通用几何元素样式 ===== */
  .geom-element {
    position: absolute;
    left: var(--element-x);
    top: var(--element-y);
    transform: translate(-50%, -50%);
    pointer-events: none;
    animation: breathe-subtle 10s infinite ease-in-out;
  }

  /* 呼吸动画 - 极其微弱的上下浮动 */
  @keyframes breathe-subtle {
    0%,
    100% {
      transform: translate(-50%, -50%) translateY(0);
    }

    50% {
      transform: translate(-50%, -50%) translateY(var(--border-width-normal));
    }
  }

  /* ----- 圆形 ----- */
  .geom-circle {
    width: var(--spacing-2);
    height: var(--spacing-2);
    border-radius: var(--radius-full);
    background-color: rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.8));
  }

  .visual-accent .geom-circle {
    width: var(--spacing-3);
    height: var(--spacing-3);
    background-color: rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 1.2));
  }

  /* ----- 线条（水平）----- */
  .geom-line {
    width: var(--spacing-10);
    height: var(--border-width-thin);
    background: linear-gradient(
      90deg,
      rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.5)) 0%,
      rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.2)) 100%
    );
  }

  .visual-accent .geom-line {
    width: var(--spacing-15);
    background: linear-gradient(
      90deg,
      rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.8)) 0%,
      rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.3)) 100%
    );
  }

  /* ----- 网格点阵 ----- */
  .geom-grid {
    width: var(--spacing-4);
    height: var(--spacing-4);
    background-image:
      radial-gradient(
        circle at 2px 2px,
        rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.6)) 1px,
        transparent 1px
      ),
      radial-gradient(
        circle at 8px 8px,
        rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.6)) 1px,
        transparent 1px
      );
    background-size: 6px 6px;
  }

  .visual-accent .geom-grid {
    width: var(--spacing-6);
    height: var(--spacing-6);
    background-image:
      radial-gradient(
        circle at 3px 3px,
        rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.8)) 1.5px,
        transparent 1.5px
      ),
      radial-gradient(
        circle at 12px 12px,
        rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.8)) 1.5px,
        transparent 1.5px
      );
    background-size: 8px 8px;
  }

  /* ----- 交叉十字 ----- */
  .geom-intersect {
    width: var(--spacing-4);
    height: var(--spacing-4);
    position: relative;
  }

  .geom-intersect::before,
  .geom-intersect::after {
    content: '';
    position: absolute;
    background: rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.5));
  }

  .geom-intersect::before {
    width: 12px;
    height: 1.5px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .geom-intersect::after {
    width: 1.5px;
    height: 12px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .visual-accent .geom-intersect::before,
  .visual-accent .geom-intersect::after {
    background: rgb(var(--color-primary-rgb) / calc(var(--visual-opacity) * 0.8));
  }

  .visual-accent .geom-intersect::before {
    width: 18px;
  }

  .visual-accent .geom-intersect::after {
    height: 18px;
  }

  /* 深色模式微调 - 几何元素更柔和 */
  :global(.dark) .geom-element {
    mix-blend-mode: screen;
    opacity: 0.7;
  }
</style>
