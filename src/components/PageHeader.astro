---
/**
 * PageHeader 组件 - 统一的页面头部
 *
 * @component
 * @description 为所有页面提供一致的标题 + 副标题结构
 *
 * @param {string} title - 页面标题 (必需)
 * @param {string} subtitle - 页面副标题 (可选)
 * @param {boolean} centered - 是否居中对齐 (默认: true)
 * @param {string} class - 额外的 CSS 类名 (可选)
 * @param {string} style - 内联样式 (可选)
 *
 * @example
 * <PageHeader
 *   title="关于支持这个项目"
 *   subtitle="你好。"
 *   style="position: relative;"
 * />
 */

interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  class?: string;
  style?: string;
}

const { title, subtitle, centered = true, class: className, style } = Astro.props;
---

<div class={`page-header ${centered ? 'centered' : ''} ${className || ''}`} {style}>
  <h1 class='page-title'>{title}</h1>
  {subtitle && <p class='page-subtitle'>{subtitle}</p>}
</div>

<style>
  .page-header {
    padding-top: var(--spacing-8);
    padding-bottom: var(--spacing-8);
    margin-bottom: var(--spacing-12);
  }

  .page-header.centered {
    text-align: center;
  }

  .page-header.centered .page-title,
  .page-header.centered .page-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  /* 响应式调整 */
  @media (width <= 768px) {
    .page-header {
      padding-top: var(--spacing-6);
      padding-bottom: var(--spacing-6);
      margin-bottom: var(--spacing-8);
    }
  }
</style>
