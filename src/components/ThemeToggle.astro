---
// ThemeToggle.astro - 宁静主题切换按钮
---

<button id='theme-toggle' class='theme-toggle' data-theme-toggle aria-label='切换深色/浅色模式'>
  <!-- 太阳icon（浅色模式） -->
  <svg
    class='sun-icon'
    width='var(--spacing-5)'
    height='var(--spacing-5)'
    viewBox='0 0 24 24'
    fill='none'
  >
    <circle cx='12' cy='12' r='4.5' stroke='currentColor' stroke-width='1.2' fill='none'></circle>
    <path
      d='M12 4V2M12 22V20M20 12H22M2 12H4M18.36 5.64L19.78 4.22M4.22 19.78L5.64 18.36M5.64 5.64L4.22 4.22M19.78 19.78L18.36 18.36'
      stroke='currentColor'
      stroke-width='1.2'
      stroke-linecap='round'></path>
  </svg>
  <!-- 月亮icon（深色模式） -->
  <svg
    class='moon-icon'
    width='var(--spacing-5)'
    height='var(--spacing-5)'
    viewBox='0 0 24 24'
    fill='none'
    style='display: none;'
  >
    <path
      d='M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z'
      stroke='currentColor'
      stroke-width='1.2'
      fill='none'></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: fixed;
    top: var(--spacing-6);
    right: var(--spacing-6);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing-6);
    height: var(--spacing-6);
    border-radius: var(--radius-md);
    background: var(--color-surface-card);
    border: var(--border-width-thin) solid var(--color-border-subtle);
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .theme-toggle:hover {
    background: var(--color-surface-soft);
    border-color: var(--color-border);
  }

  .theme-toggle svg {
    width: var(--spacing-5);
    height: var(--spacing-5);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dark .theme-toggle {
    color: var(--color-gold-dust);
    background: var(--color-surface-soft);
    border-color: var(--color-border-subtle);
    box-shadow: 0 var(--spacing-1) var(--spacing-3) rgb(0 0 0 / 20%);
  }

  .dark .theme-toggle:hover {
    background: var(--color-surface-card);
    border-color: var(--color-gold-dust);
  }
</style>
