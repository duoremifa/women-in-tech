---
// src/components/Navbar.astro - 宁静低奢顶部导航
// 最右侧极简双控：语言切换与深色模式切换

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { text: '理念', en: 'About', href: '/#about', id: 'about' },
  { text: '日常', en: 'What We Do', href: '/#events', id: 'events' },
  { text: '安排', en: 'Upcoming', href: '/#schedule', id: 'schedule' },
  { text: '加入', en: 'Join', href: '/#join', id: 'join' },
];
---

<header class='nav-header'>
  <nav class='quiet-nav layout-reading' aria-label='Main Navigation'>
    <!-- 左侧品牌：持久保留 wo/men in tech，经典品牌紫 -->
    <div class='nav-left'>
      <a href='/' class:list={['brand', { active: currentPath === '/' }]}>
        <span class='brand-main'>wo<span class='brand-slash'>/</span>men</span>
        <span class='brand-sub'>in tech</span>
      </a>
    </div>

    <!-- 中部导航链接：对齐主页四大核心篇章 -->
    <div class='nav-center'>
      <div class='nav-links'>
        {
          navItems.map((item, index) => {
            const isActive = index === 0;
            return (
              <a
                href={item.href}
                class:list={['nav-link', { 'is-active': isActive }]}
                data-nav-id={item.id}
              >
                <span class='nav-link-text lang-zh'>{item.text}</span>
                <span class='nav-link-text lang-en'>{item.en}</span>
                <span class='nav-active-dot' />
              </a>
            );
          })
        }
      </div>
    </div>

    <!-- 最右侧：极简双控胶囊 (语言切换 + 深色切换) -->
    <div class='nav-end'>
      <div class='minimal-ctrl-group' role='group' aria-label='Preferences'>
        <!-- 极简单键语言切换：当前中文显示 EN，点击切换为英文；反之亦然 -->
        <button
          type='button'
          class='minimal-btn lang-btn'
          id='quick-lang-btn'
          aria-label='Toggle Language'
          title='切换中英文 / Switch Language'
        >
          <span class='lang-opt lang-zh'>EN</span>
          <span class='lang-opt lang-en'>中</span>
        </button>

        <span class='ctrl-divider' aria-hidden='true'></span>

        <!-- 极简深色模式切换 -->
        <button
          type='button'
          class='minimal-btn theme-btn'
          id='quick-theme-btn'
          data-theme-toggle
          aria-label='切换深色/浅色模式'
          title='切换深色/浅色模式'
        >
          <svg
            class='sun-icon'
            width='13'
            height='13'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
          >
            <circle cx='12' cy='12' r='4.5'></circle>
            <path d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'></path>
          </svg>
          <svg
            class='moon-icon'
            width='13'
            height='13'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            style='display: none;'
          >
            <path d='M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z'></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  function setupNavControls() {
    // 1. 极简语言切换
    const langBtn = document.getElementById('quick-lang-btn');
    if (langBtn) {
      langBtn.onclick = () => {
        const current = document.documentElement.getAttribute('data-lang') || 'zh';
        const next = current === 'en' ? 'zh' : 'en';
        document.documentElement.setAttribute('data-lang', next);
        document.documentElement.lang = next === 'en' ? 'en' : 'zh-CN';
        try {
          localStorage.setItem('site_lang', next);
        } catch (e) {}
        window.dispatchEvent(new CustomEvent('site-language-change', { detail: { lang: next } }));
      };
    }

    // 2. 首页锚点平滑滚动与联动
    const isHomePage = window.location.pathname === '/' || window.location.pathname === '';
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link[data-nav-id]');

    function setActiveNav(id: string) {
      navLinks.forEach((link) => {
        if (link.dataset.navId === id) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });
    }

    navLinks.forEach((link) => {
      link.onclick = (e) => {
        const navId = link.dataset.navId;
        if (!navId) return;

        if (isHomePage) {
          e.preventDefault();
          if (navId === 'about') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            history.pushState(null, '', '/');
            setActiveNav('about');
          } else {
            const targetEl = document.getElementById(navId);
            if (targetEl) {
              targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
              history.pushState(null, '', `/#${navId}`);
              setActiveNav(navId);
            }
          }
        }
      };
    });

    // 3. 首页滚动智能监听 (Scroll Spy)
    if (isHomePage) {
      const sections = ['about', 'events', 'schedule', 'join'];
      const sectionElements = sections.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];

      if ('IntersectionObserver' in window && sectionElements.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                setActiveNav(entry.target.id);
              }
            });
          },
          {
            rootMargin: '-15% 0px -60% 0px',
            threshold: 0,
          }
        );

        sectionElements.forEach((el) => observer.observe(el));
      }
    }
  }

  setupNavControls();
  document.addEventListener('astro:page-load', setupNavControls);
  document.addEventListener('DOMContentLoaded', setupNavControls);
</script>

<style>
  .nav-header {
    width: 100%;
    position: relative;
    z-index: 50;
  }

  /* ===== 导航容器 ===== */
  .quiet-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-8);
    padding-bottom: var(--spacing-5);
    border-bottom: 1px solid var(--color-border-divider);
    position: relative;
    gap: var(--spacing-4);
  }

  /* ===== 左侧品牌 ===== */
  .nav-left {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-2);
    text-decoration: none !important;
    border-bottom: none !important;
    color: var(--color-text-primary);
    position: relative;
    user-select: none;
  }

  .brand:hover {
    text-decoration: none !important;
    border-bottom: none !important;
  }

  .brand-main {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-brand-purple, #5e4c7a);
    line-height: 1;
  }

  .brand-slash {
    display: inline-block;
    margin: 0 0.05em;
    font-weight: 300;
    color: var(--color-gold-dust);
    opacity: 0.85;
    font-style: normal;
  }

  .brand-sub {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-light);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-purple-soft, #7d689b);
  }

  /* ===== 中部导航链接 (绝对居中保证视觉平衡) ===== */
  .nav-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-secondary);
    text-decoration: none !important;
    border-bottom: none !important;
    font-size: 13px;
    letter-spacing: 0.04em;
    padding: var(--spacing-1) 0;
    position: relative;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-text-heading);
  }

  .nav-link.is-active {
    color: var(--color-text-heading);
    font-weight: var(--font-weight-medium);
  }

  .nav-active-dot {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-gold-dust);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .nav-link.is-active .nav-active-dot {
    opacity: 1;
  }

  /* ===== 最右侧：极简控制区 ===== */
  .nav-end {
    display: flex;
    align-items: center;
    margin-left: auto;
    flex-shrink: 0;
  }

  .minimal-ctrl-group {
    display: inline-flex;
    align-items: center;
    height: 26px;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    padding: 1px 3px;
    box-sizing: border-box;
    user-select: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .minimal-ctrl-group:hover {
    border-color: var(--color-gold-dust);
  }

  .minimal-btn {
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
    height: 22px;
    padding: 0 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-family: var(--font-family-ui);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .minimal-btn:hover {
    color: var(--color-text-heading);
    background: var(--color-surface-pure);
  }

  .ctrl-divider {
    width: 1px;
    height: 10px;
    background: var(--color-border-divider);
    margin: 0 1px;
    opacity: 0.8;
  }

  .theme-btn {
    padding: 0 5px;
    width: 22px;
  }

  :root.dark .minimal-ctrl-group {
    border-color: rgba(216, 205, 176, 0.2);
    background: var(--color-surface-soft);
  }

  :root.dark .minimal-ctrl-group:hover {
    border-color: var(--color-gold-dust);
  }

  :root.dark .minimal-btn:hover {
    background: var(--color-surface-card);
    color: var(--color-gold-dust);
  }

  /* ===== 移动端极限优化 ===== */
  @media (max-width: 768px) {
    .quiet-nav {
      padding-top: var(--spacing-4);
      padding-bottom: var(--spacing-3);
      gap: var(--spacing-2);
    }

    .brand-main {
      font-size: 1.125rem;
    }

    .brand-sub {
      display: none; /* 移动端收敛副标题，视觉呼吸更充裕 */
    }

    .nav-center {
      position: static;
      transform: none;
      margin: 0 auto;
    }

    .nav-links {
      gap: var(--spacing-3);
    }

    .nav-link {
      font-size: 12.5px;
      padding: 4px 2px;
    }

    .nav-active-dot {
      bottom: -4px;
    }
  }

  @media (max-width: 420px) {
    .nav-links {
      gap: 10px;
    }

    .nav-link {
      font-size: 12px;
    }

    .minimal-btn.lang-btn {
      padding: 0 5px;
      font-size: 10px;
    }
  }
</style>
