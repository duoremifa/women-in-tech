---
// src/components/Navbar.astro - 宁静低奢顶部导航
// 4 页纯文字 nav（理念/机制/排期/加入），去胶囊；语言/主题为右侧极小平铺元素。

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { text: '播客', en: 'Podcast', href: '/podcast', pagePath: '/podcast' },
  { text: '手记', en: 'Writing', href: '/writing', pagePath: '/writing' },
  { text: '排期', en: 'Schedule', href: '/upcoming', pagePath: '/upcoming' },
  { text: '加入', en: 'Join', href: '/join', pagePath: '/join' },
];
---

<header class='nav-header'>
  <nav class='quiet-nav layout-reading' aria-label='Main Navigation'>
    <!-- 左侧品牌 -->
    <div class='nav-left'>
      <a href='/' class:list={['brand', { active: currentPath === '/' }]}>
        <span class='brand-main'>wo<span class='brand-slash'>/</span>men</span>
        <span class='brand-sub'>in tech</span>
      </a>
    </div>

    <!-- 右侧：nav 链接 + 平铺语言/主题（无胶囊） -->
    <div class='nav-right-group'>
      <div class='nav-links'>
        {
          navItems.map((item) => {
            const isActive = currentPath === item.pagePath;
            return (
              <a
                href={item.href}
                class:list={['nav-link', { 'is-active': isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span lang='zh-CN' class='nav-link-text lang-zh'>{item.text}</span>
                <span lang='en' class='nav-link-text lang-en'>{item.en}</span>
              </a>
            );
          })
        }
      </div>

      {/* 语言切换：单文字微钮，无边框 */}
      <button
        type='button'
        class='lang-toggle'
        id='quick-lang-btn'
        aria-label='切换到英文 / Switch to English'
        title='切换中英文 / Switch Language'
      >
        <span lang='zh-CN' class='lang-opt lang-zh'>EN</span>
        <span lang='en' class='lang-opt lang-en'>中</span>
      </button>

      {/* 主题切换：纯图标微钮，无边框 */}
      <button
        type='button'
        class='theme-toggle'
        id='quick-theme-btn'
        data-theme-toggle
        aria-label='切换深色/浅色模式'
        title='切换深色/浅色模式'
      >
        <svg class='sun-icon' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'>
          <circle cx='12' cy='12' r='4.5'></circle>
          <path d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'></path>
        </svg>
        <svg class='moon-icon' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' style='display: none;'>
          <path d='M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z'></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  function setupNavControls() {
    // 语言按钮：仅同步 aria-label（点击逻辑由 Layout 的 document 事件委托统一处理，
    // 跨 view-transition 持久可靠，不依赖被 persist 元素的 onclick）
    const langBtn = document.getElementById('quick-lang-btn');
    if (langBtn) {
      const current = document.documentElement.getAttribute('data-lang') || 'zh';
      langBtn.setAttribute('aria-label', current === 'en' ? '切换到中文 / Switch to Chinese' : '切换到英文 / Switch to English');
    }
  }
  document.addEventListener('astro:page-load', setupNavControls);
</script>

<style>
  .nav-header {
    width: 100%;
    position: relative;
    z-index: 50;
  }

  /* ===== 导航容器 ===== */
  .quiet-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-8);
    padding-bottom: var(--spacing-5);
    border-bottom: 1px solid var(--color-border-divider);
    position: relative;
    gap: var(--spacing-4);
  }

  /* ===== 左侧品牌 ===== */
  .nav-left {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-2);
    text-decoration: none !important;
    border-bottom: none !important;
    color: var(--color-text-primary);
    position: relative;
    user-select: none;
  }

  .brand:hover {
    text-decoration: none !important;
    border-bottom: none !important;
  }

  .brand-main {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-brand-purple);
    line-height: 1;
  }

  .brand-slash {
    display: inline-block;
    margin: 0 0.05em;
    font-weight: 300;
    color: var(--color-gold-dust);
    opacity: 0.85;
    font-style: normal;
  }

  .brand-sub {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-light);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-purple-soft);
  }

  /* ===== 右侧联动群组：自然对齐右侧核心展陈区 ===== */
  .nav-right-group {
    display: flex;
    align-items: center;
    gap: var(--spacing-5);
    margin-left: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }

  /* nav 链接：纯文字 + 底部金线 active（去胶囊） */
  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    text-decoration: none !important;
    border-bottom: 2px solid transparent !important;
    font-family: var(--font-family-ui);
    font-size: 13.5px;
    font-weight: 400;
    letter-spacing: 0.06em;
    padding: 4px 2px;
    position: relative;
    transition: color var(--transition-fast), border-color var(--transition-fast);
    white-space: nowrap;
    user-select: none;
  }

  .nav-link:hover {
    color: var(--color-text-heading);
  }

  .nav-link.is-active {
    color: var(--color-text-heading);
    font-weight: 500;
    border-bottom-color: var(--color-gold-dust) !important;
  }

  /* 语言/主题：平铺微钮，无边框底。焦点交由全局 :focus-visible gold hairline（不再 outline:none） */
  .lang-toggle,
  .theme-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    font-family: var(--font-family-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    border-radius: 0;
    transition: color var(--transition-fast);
  }

  .lang-toggle:hover,
  .theme-toggle:hover {
    color: var(--color-gold-dust);
  }

  :root.dark .lang-toggle:hover,
  :root.dark .theme-toggle:hover {
    color: var(--color-gold-dust);
  }

  /* ===== 移动端极限优化 ===== */
  @media (max-width: 768px) {
    .quiet-nav {
      padding-top: var(--spacing-4);
      padding-bottom: var(--spacing-3);
      gap: var(--spacing-2);
    }

    .brand-main {
      font-size: 1.125rem;
    }

    .brand-sub {
      display: none;
    }

    .nav-right-group {
      gap: var(--spacing-3);
      min-width: 0;
    }

    .nav-links {
      gap: var(--spacing-2);
    }

    .nav-link {
      font-size: 12px;
      letter-spacing: 0.04em;
      padding: 4px 2px;
      white-space: nowrap;
    }
  }

  @media (max-width: 480px) {
    .quiet-nav {
      gap: 4px;
      padding-left: var(--spacing-3);
      padding-right: var(--spacing-3);
    }

    .nav-right-group {
      gap: 5px;
    }

    .nav-links {
      gap: 3px;
    }

    .nav-link {
      font-size: 12px;
      letter-spacing: 0.03em;
      padding: 4px 2px;
    }

    .lang-toggle,
    .theme-toggle {
      padding: 4px 4px;
      font-size: 11px;
    }
  }

  @media (max-width: 360px) {
    .brand-main {
      font-size: 1rem;
    }

    .nav-links {
      gap: 2px;
    }

    .nav-link {
      font-size: 11px;
      padding: 3px 2px;
      letter-spacing: 0.02em;
    }

    .nav-right-group {
      gap: 3px;
    }
  }
</style>
