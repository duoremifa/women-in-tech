---
// src/components/Footer.astro
---

<footer class='footer'>
  <div class='footer-sub'>
    <span lang='zh-CN' class='footer-privacy lang-zh'>
      © 2026 wo/men in tech
    </span>
    <span lang='en' class='footer-privacy lang-en'>
      © 2026 wo/men in tech
    </span>
    <span class='footer-colophon'>by Dai Min</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-footer, var(--color-surface-primary));
    padding: var(--spacing-16) var(--spacing-6) var(--spacing-12);
    padding-bottom: calc(var(--spacing-12) + env(safe-area-inset-bottom));
    text-align: center;
    position: relative;
    margin-top: var(--spacing-20);
    border-top: var(--border-width-thin) solid var(--color-border-divider);
  }

  .footer-sub {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
  }

  .footer-privacy {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
    font-style: normal;
    margin-top: var(--spacing-4);
    letter-spacing: 0.02em;
  }

  .footer-colophon {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--color-text-tertiary);
    letter-spacing: 0.08em;
    margin-top: var(--spacing-2);
    opacity: 0.7;
  }

  @media (width <= 768px) {
    .footer {
      margin-top: var(--spacing-12);
      padding: var(--spacing-10) var(--spacing-4) var(--spacing-8);
    }
  }
</style>
