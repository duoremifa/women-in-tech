---
// src/components/Footer.astro
import Stamp from './Stamp.astro';
---

<footer class='footer'>
  <div class='footer-sub'>
    <div class='footer-signature'>
      <span class='gold-thread-dot' aria-hidden='true'><Stamp /></span>
      <span>wo<span class='brand-slash'>/</span>men in tech</span>
    </div>
    <span lang='zh-CN' class='footer-description lang-zh'>
      women in technical · 既是女性，亦是“我们”的技术与创造联合体
    </span>
    <span lang='en' class='footer-description lang-en'>
      women in technical · Both women and "us": a collective of craft and technology
    </span>
    <span class='footer-roles'>
      Product Managers × Interaction Designers × Frontend Engineers
    </span>
    <span lang='zh-CN' class='footer-privacy lang-zh'>
      © 2026 wo/men in tech
    </span>
    <span lang='en' class='footer-privacy lang-en'>
      © 2026 wo/men in tech
    </span>
    <span class='footer-colophon'>by Dai Min</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-footer, var(--color-surface-primary));
    padding: var(--spacing-16) var(--spacing-6) var(--spacing-12);
    text-align: center;
    position: relative;
    margin-top: var(--spacing-20);
    border-top: var(--border-width-thin) solid var(--color-border-divider);
  }

  .footer-sub {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
    opacity: 0.9;
  }

  .footer-signature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    font-family: var(--font-family-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-2);
  }

  .brand-slash {
    display: inline-block;
    margin: 0 0.04em;
    font-weight: 300;
    color: var(--color-gold-dust);
    opacity: 0.75;
    font-style: normal;
  }

  .gold-thread-dot {
    color: var(--color-gold-dust);
    font-size: var(--font-size-xs);
  }

  .footer-description {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-wide);
    font-family: var(--font-family-ui);
  }

  .footer-roles {
    color: var(--color-text-primary);
    font-size: var(--font-size-xs);
    letter-spacing: 0.12em;
    font-family: var(--font-family-ui);
    text-transform: uppercase;
    margin-top: var(--spacing-1);
    font-weight: var(--font-weight-light);
  }

  .footer-privacy {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
    font-style: normal;
    margin-top: var(--spacing-4);
    letter-spacing: 0.02em;
  }

  .footer-colophon {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--color-text-tertiary);
    letter-spacing: 0.08em;
    margin-top: var(--spacing-2);
    opacity: 0.7;
  }

  @media (width <= 768px) {
    .footer {
      margin-top: var(--spacing-12);
      padding: var(--spacing-10) var(--spacing-4) var(--spacing-8);
    }

    .footer-description {
      font-size: 12px;
      line-height: 1.6;
      max-width: 320px;
    }

    .footer-roles {
      font-size: 10px;
      letter-spacing: 0.08em;
      line-height: 1.5;
      text-align: center;
    }
  }
</style>
