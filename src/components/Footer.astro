---
// src/components/Footer.astro
---

<footer class='footer'>
  <div class='footer-sub'>
    {/* 签名手势：一短金线，从中心画出（reduced-motion 关） */}
    <span class='footer-hairline' aria-hidden='true'></span>
    <span class='footer-privacy'>© 2026 wo/men in tech</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-footer, var(--color-surface-primary));
    padding: var(--spacing-16) var(--spacing-6) var(--spacing-12);
    padding-bottom: calc(var(--spacing-12) + env(safe-area-inset-bottom));
    text-align: center;
    position: relative;
    margin-top: var(--spacing-20);
    border-top: var(--border-width-thin) solid var(--color-border-divider);
  }

  /* 内容束：严格居中，行距走 8px 节奏 */
  .footer-sub {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-3);
  }

  /* 短金线：顶奢的安静手势——不是动画，是「线落下」。与页头 gold-hairline 同家族，
     区别在于从中心向两侧生长，而非从左起笔 */
  .footer-hairline {
    width: var(--spacing-10);
    height: var(--border-width-thin);
    background: var(--color-gold-dust);
    transform-origin: center;
    animation: footer-hairline-draw 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes footer-hairline-draw {
    from {
      transform: scaleX(0);
      opacity: 0.4;
    }

    to {
      transform: scaleX(1);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-hairline {
      animation: none;
    }
  }

  /* 版权行：mono 元数据语言，与全站 section-eyebrow 同家族 */
  .footer-privacy {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-2xs);
    color: var(--color-text-tertiary);
    letter-spacing: 0.08em;
    line-height: 1;
  }

  @media (width <= 768px) {
    .footer {
      margin-top: var(--spacing-12);
      padding: var(--spacing-10) var(--spacing-4) var(--spacing-8);
    }
  }
</style>
