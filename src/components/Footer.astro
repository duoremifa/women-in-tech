---
// src/components/Footer.astro
import Stamp from './Stamp.astro';
---

<footer class='footer'>
  <div class='footer-sub'>
    {/* 品牌印章：四角十字星，标志性紫——印章落款，页脚是品牌时刻 */}
    <span class='footer-mark' aria-hidden='true'><Stamp /></span>
    <span class='footer-privacy'>© 2026 wo/men in tech</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-footer, var(--color-surface-primary));
    padding: var(--spacing-16) var(--spacing-6) var(--spacing-12);
    padding-bottom: calc(var(--spacing-12) + env(safe-area-inset-bottom));
    text-align: center;
    position: relative;
    margin-top: var(--spacing-20);
    border-top: var(--border-width-thin) solid var(--color-border-divider);
  }

  /* 内容束：严格居中，行距走 8px 节奏 */
  .footer-sub {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-3);
  }

  /* 印章落款：Stamp 尺寸随 1em，标志性紫在纸色上对比度 ~7:1——
     此前的哑光金 hairline 在纸底上仅 ~1.4:1，1px 线在多数屏上不可见 */
  .footer-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand);
    font-size: var(--font-size-sm);
    line-height: 1;
    opacity: 0.85;
  }

  /* 版权行：mono 元数据语言，与全站 section-eyebrow 同家族 */
  .footer-privacy {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-2xs);
    color: var(--color-text-tertiary);
    letter-spacing: 0.08em;
    line-height: 1;
  }

  @media (width <= 768px) {
    .footer {
      margin-top: var(--spacing-12);
      padding: var(--spacing-10) var(--spacing-4) var(--spacing-8);
    }
  }
</style>
