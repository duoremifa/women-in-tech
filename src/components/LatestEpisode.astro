---
import { getCollection } from 'astro:content';

const latest = (await getCollection('podcast', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---

{latest && (
  <section class='latest-ep'>
    <a class='latest-ep-card' href={`/podcast/${latest.id}/`}>
      <div class='le-info'>
        <span class='le-eyebrow'>
          {latest.data.comingSoon
            ? '播客即将上线 · PODCAST COMING'
            : '最新一期 · LATEST EPISODE'}
        </span>
        <h3 class='le-title'>{latest.data.title}</h3>
        {latest.data.excerpt && <p class='le-excerpt'>{latest.data.excerpt}</p>}
        <div class='le-meta'>
          {latest.data.duration && <span>{latest.data.duration}</span>}
          <span>· 主播 {latest.data.hosts.join('、')}</span>
          <span class='le-arrow' aria-hidden='true'>⟶</span>
        </div>
      </div>
    </a>
  </section>
)}

<style>
  .latest-ep { margin-bottom: var(--spacing-12); }
  .latest-ep-card {
    display: block;
    padding: var(--spacing-6);
    background: var(--color-surface-pure);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    text-decoration: none !important;
    transition: border-color var(--transition-fast);
  }
  .latest-ep-card:hover {
    border-color: var(--color-gold-dust);
  }
  .le-eyebrow {
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--color-gold-dust);
    display: block;
    margin-bottom: var(--spacing-2);
  }
  .le-title {
    font-family: var(--font-family-heading);
    font-size: 1.1rem;
    font-weight: var(--font-weight-normal);
    color: var(--color-text-heading);
    margin: 0 0 var(--spacing-2);
    line-height: 1.35;
  }
  .le-excerpt {
    font-family: var(--font-family-body);
    font-size: 12.5px;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0 0 var(--spacing-3);
  }
  .le-meta {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--color-text-tertiary);
    display: flex;
    gap: var(--spacing-2);
    align-items: center;
  }
  .le-arrow {
    margin-left: auto;
    color: var(--color-text-primary);
    font-size: 13px;
    transition: transform var(--transition-fast);
  }
  .latest-ep-card:hover .le-arrow {
    transform: translateX(3px);
  }
</style>
