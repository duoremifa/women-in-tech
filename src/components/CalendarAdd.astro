---
// src/components/CalendarAdd.astro
// 平台感知的"添加到日历"组件：webcal 订阅源（全部排期自动同步）。
// - iOS / macOS Safari → webcal://（Apple Calendar 原生订阅）
// - Android → Google Calendar add-by-URL（系统不认 webcal，需走 Google）
// - 其他/桌面 → webcal（Outlook/Thunderbird）+ .ics 下载兜底
// 用 <details> 原生下拉，免 JS 框架；is:inline 脚本按 UA 设 href + 提示文案。
---

<details class='cal-add'>
  <summary class='cal-trigger' aria-label='添加到我的日历'>
    <span lang='zh-CN' class='lang-zh'>添加到我的日历</span>
    <span lang='en' class='lang-en'>Add to my calendar</span>
  </summary>
  <div class='cal-menu'>
    <a class='cal-opt primary' id='cal-sync' href='#'>
      <span class='cal-opt-title'>
        <span lang='zh-CN' class='lang-zh'>自动同步全部排期</span>
        <span lang='en' class='lang-en'>Subscribe all (auto-sync)</span>
      </span>
      <span class='cal-opt-hint' id='cal-sync-hint'>
        <span lang='zh-CN' class='lang-zh'>新排期自动到，过期自动撤</span>
        <span lang='en' class='lang-en'>New slots auto-arrive; past ones fade</span>
      </span>
    </a>
    <a class='cal-opt' href='/gatherings.ics' download>
      <span class='cal-opt-title'>
        <span lang='zh-CN' class='lang-zh'>下载 .ics 文件</span>
        <span lang='en' class='lang-en'>Download .ics file</span>
      </span>
      <span class='cal-opt-hint'>
        <span lang='zh-CN' class='lang-zh'>手动导入任意日历 App</span>
        <span lang='en' class='lang-en'>Import manually into any calendar</span>
      </span>
    </a>
    <p class='cal-foot' id='cal-foot'></p>
  </div>
</details>

<style>
  .cal-add {
    position: relative;
    display: inline-block;
  }
  .cal-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-4);
    background: var(--color-text-heading);
    color: var(--color-surface-pure) !important;
    border: none;
    border-radius: var(--radius-xs);
    font-family: var(--font-family-sans);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .cal-trigger::-webkit-details-marker { display: none; }
  .cal-add[open] > .cal-trigger { background: var(--color-gold-dust); color: var(--color-text-heading) !important; }
  /* 实心钮的蜡封 hover 手势——与 .btn--solid 同家族 */
  .cal-trigger:hover { background: var(--color-gold-dust); color: var(--color-text-heading) !important; }
  .cal-trigger-icon { font-size: 13px; }

  .cal-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    left: auto;
    min-width: 280px;
    background: var(--color-surface-pure);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    box-shadow: 0 8px 24px -8px rgb(var(--color-gold-dust-rgb) / 14%);
    padding: var(--spacing-2);
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transform-origin: top right;
  }
  /* 下拉入场：220ms 缓动，不再硬弹出 */
  @keyframes cal-open {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .cal-add[open] .cal-menu {
    animation: cal-open 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cal-opt {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-xs);
    text-decoration: none !important;
    transition: background var(--transition-fast);
  }
  .cal-opt:hover {
    background: var(--color-surface-soft);
  }
  /* 焦点环只给 :focus-visible——hover 长焦点环会稀释焦点指示器的语义 */
  .cal-opt:focus-visible {
    background: var(--color-surface-soft);
    box-shadow: var(--focus-ring);
    outline: none;
  }
  .cal-opt.primary .cal-opt-title { color: var(--color-text-primary); }
  .cal-opt-title {
    font-family: var(--font-family-sans);
    font-size: 12.5px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }
  .cal-opt-hint {
    font-family: var(--font-family-sans);
    font-size: var(--font-size-2xs);
    color: var(--color-text-tertiary);
    line-height: 1.4;
  }
  .cal-foot {
    margin: var(--spacing-1) var(--spacing-3) 0;
    padding-top: var(--spacing-2);
    border-top: 1px solid var(--color-border-divider);
    font-family: var(--font-family-sans);
    font-size: 10.5px;
    color: var(--color-text-tertiary);
    line-height: 1.5;
  }
  .cal-foot:empty { display: none; }

  @media (max-width: 680px) {
    /* 移动端右锚定（与桌面一致），不再 left:0/right:0 通栏脱离按钮 */
    .cal-menu {
      right: 0;
      left: auto;
      min-width: min(280px, calc(100vw - 32px));
    }
  }
</style>

<script is:inline>
  (function () {
    function setupCalAdd() {
      var ua = navigator.userAgent || '';
      var platform = navigator.platform || '';
      var maxTouch = navigator.maxTouchPoints || 0;
      // iOS / iPadOS：UA 含 iPhone|iPad|iPod，或（MacIntel 平台 + 触屏）覆盖 iPadOS 13+ 的 UA 伪装。
      // 用 maxTouch > 0（非 > 1），iPad 某些版本只报 1。
      var isIOS = /iPhone|iPad|iPod/.test(ua) || (/MacIntel/.test(platform) && maxTouch > 0);
      var isAndroid = /Android/i.test(ua) && !isIOS;
      var isMac = /Macintosh/.test(ua) && !isIOS;
      var link = document.getElementById('cal-sync');
      var foot = document.getElementById('cal-foot');
      if (!link) return;
      var isEn = document.documentElement.getAttribute('data-lang') === 'en';
      var feedHttps = 'https://wotech.space/gatherings.ics';
      var webcal = 'webcal://wotech.space/gatherings.ics';
      // 安全默认 = webcal（iOS/macOS/桌面 Outlook/Thunderbird 原生支持）。
      // 仅在确信是 Android 时走 Google Calendar（安卓不识别 webcal）。
      if (isAndroid) {
        link.setAttribute('href', 'https://calendar.google.com/calendar/r?cid=' + encodeURIComponent(feedHttps));
        if (foot) {
          foot.lang = isEn ? 'en' : 'zh-CN';
          foot.textContent = isEn ? 'Subscribes via Google Calendar (Android ignores webcal).' : '将用 Google 日历订阅（安卓不识别 webcal）。';
        }
      } else {
        link.setAttribute('href', webcal);
        if (foot) {
          foot.lang = isEn ? 'en' : 'zh-CN';
          if (isIOS) {
            foot.textContent = isEn ? 'Subscribes via Apple Calendar.' : '将用系统日历（Apple Calendar）订阅。';
          } else if (isMac) {
            foot.textContent = isEn ? 'Subscribes via Apple Calendar.' : '将用系统日历订阅。';
          } else {
            foot.textContent = isEn ? 'Subscribes via desktop calendar (Outlook / Thunderbird).' : '桌面日历（Outlook / Thunderbird）可订阅。';
          }
        }
      }
    }
    setupCalAdd();
    document.addEventListener('astro:page-load', setupCalAdd);
    document.addEventListener('site-language-change', setupCalAdd);
  })();
</script>
